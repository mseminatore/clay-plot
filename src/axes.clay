// PlotAxes -- one plot area: its artists, scales, ticks, labels and legend
//
// Made by a figure (fig subplots, fig addSubplot, Plot gca); every drawing
// method returns the artist it added, a Dict you can change before saving
// (line set("color", "red")).

PlotAxes = Object clone {
    figure = nil
    artists = nil
    cell = nil              // [rows, cols, row, col, rowSpan, colSpan] in the figure's grid
    titleText = nil
    titleOpts = nil
    xlabelText = nil
    ylabelText = nil
    xlimits = nil           // [lo, hi]; nil at either end means automatic
    ylimits = nil
    xtickSpec = nil         // #{values:, labels:, rotation:}
    ytickSpec = nil
    gridOn = false
    gridOpts = nil
    legendOpts = nil        // nil: no legend
    nextColor = 0
    aspect = nil            // nil or "equal"
    yInverted = false
    axisVisible = true
    integerX = false
    integerY = false
    colorbarArtist = nil
    colorbarLabel = nil
    xLog = false            // xscale("log")
    yLog = false
    host = nil              // twinx / twiny: the axes this one shares a box with
    twinKind = nil          // "x": shares host's x axis (own y on the right); "y": shares y
    twins = nil             // the twins made from this axes
    xGroup = nil            // sharex / sharey: the axes sharing this one's x (or y),
    yGroup = nil            // itself included; nil when not shared
    hideXTicks = false      // shared axes: inner tick labels left out
    hideYTicks = false
    xDates = false          // x holds dates: days since the day xOrigin
    xOrigin = nil           // (days since 1970) of the first date plotted
    // worked out while drawing
    plotBox = nil           // [x, y, w, h] in pixels
    view = nil              // [x0, x1, y0, y1] in data units
    xt = nil                // ticks: #{values:, labels:, rotation:}
    yt = nil
    cbt = nil
    sx = 1.0
    ox = 0.0
    sy = 1.0
    oy = 0.0

    init(fig, where = nil) {
        self figure = fig
        self artists = []
        self twins = []
        w = where ?? [1, 1, 0, 0]
        self cell = (w size == 4) ifTrue { w + [1, 1] } ifFalse { w }
        self gridOn = Plot rc get("axes.grid") ?? false
    }

    // ---- drawing --------------------------------------------------------

    // plot(ys), plot(xs, ys), plot(xs, ys, "r--"), each with an optional
    // options Dict last: color, label, linewidth (lw), linestyle (ls), marker,
    // markersize (ms), alpha. Rows of numbers plot one line per column.
    plot(a = nil, b = nil, c = nil, d = nil) {
        [items, fmt, opts] = _split([a, b, c, d])
        (items size == 0) ifTrue { raise("Plot: plot needs y values: plot(ys) or plot(xs, ys)") }
        (items size > 2) ifTrue { raise("Plot: plot takes xs and ys (then a format string and an options Dict)") }
        ys = _seq(items last)
        xs = (items size == 2) ifTrue { _seq(items first) } ifFalse { nil }
        ((ys size > 0) && (ys first type == "Array")) ifTrue {
            labels = opts get("label")
            out = []
            ys first size times { |j|
                o = _copy(opts)
                (labels type == "Array") ifTrue { o set("label", labels at(j)) }
                out append(_line(xs, ys map { |row| row at(j) }, fmt, o))
            }
            return out
        }
        _line(xs, ys, fmt, opts)
    }

    // scatter(xs, ys, #{s:, c:, cmap:, vmin:, vmax:, marker:, alpha:, label:,
    // edgecolors:}). s is a marker area in points squared (one number, or one
    // per point); c is a colour, a colour per point, or a number per point
    // mapped through cmap.
    scatter(x, y, opts = nil) {
        opts = opts ?? #{}
        xs = _dx(_seq(x))
        ys = _seq(y)
        (xs size != ys size) ifTrue { raise("Plot: scatter: x and y must be the same length (" + xs size toString + " and " + ys size toString + ")") }
        c = opts get("c") ?? opts get("color")
        art = #{kind: "scatter", xs: xs, ys: ys, marker: opts get("marker") ?? "o",
                sizes: opts get("s") ?? Math pow(_rc("lines.markersize"), 2),
                alpha: opts get("alpha"), label: opts get("label"),
                edgecolor: _hexOrNil(opts get("edgecolors") ?? opts get("edgecolor")),
                cmap: opts get("cmap") ?? _rc("image.cmap")}
        ((c type == "Array") && (c size == xs size) && (c size > 0) && (c first type == "Number")) ifTrue {
            art set("values", c)
            _setRange(art, c, opts)
        } ifFalse {
            ((c type == "Array") && (c size == xs size) && (c size > 0) && (c first type == "String")) ifTrue {
                art set("colors", c map { |s| PlotColor hex(s) })
                art set("color", art get("colors") first)
            } ifFalse {
                art set("color", PlotColor hex(c ?? _nextCycle))
            }
        }
        artists append(art)
        art
    }

    // bar(xs, heights, #{width:, bottom:, align:, color:, edgecolor:,
    // linewidth:, label:, alpha:}). xs may be strings: the bars go at 0, 1,
    // 2 ... and the strings label them.
    bar(x, height, opts = nil) { _bars("v", x, height, opts ?? #{}) }

    // Horizontal bars: barh(ys, widths, #{height:, left:, ...})
    barh(y, width, opts = nil) { _bars("h", y, width, opts ?? #{}) }

    // A histogram: hist(values, bins, opts) or hist(values, #{bins:, range:,
    // density:, histtype: "bar" or "step", color:, alpha:, label:}). bins is a
    // count or an Array of edges. Returns [counts, edges, artist], as
    // matplotlib's (n, bins, patches).
    hist(data, bins = nil, opts = nil) {
        (bins type == "Dict") ifTrue { opts = bins; bins = nil }
        opts = opts ?? #{}
        bins = bins ?? opts get("bins") ?? 10
        values = _seq(data) filter { |v| (v != nil) && (v == v) }
        edges = nil
        (bins type == "Array") ifTrue { edges = bins } ifFalse {
            rng = opts get("range")
            lo = (rng != nil) ifTrue { rng at(0) } ifFalse { (values size > 0) ifTrue { values min } ifFalse { 0 } }
            hi = (rng != nil) ifTrue { rng at(1) } ifFalse { (values size > 0) ifTrue { values max } ifFalse { 1 } }
            (hi == lo) ifTrue { lo = lo - 0.5; hi = hi + 0.5 }
            lo = lo toFloat
            span = hi - lo
            edges = (0..bins) map { |i| lo + ((span * i) / bins) }
        }
        n = edges size - 1
        (n < 1) ifTrue { raise("Plot: hist needs at least one bin") }
        counts = (1..n) map { |i| 0 }
        first = edges first
        last = edges last
        values each { |v|
            ((v >= first) && (v <= last)) ifTrue {
                i = _bin(edges, v)
                counts setAt(i, counts at(i) + 1)
            }
        }
        (opts get("density") == true) ifTrue {
            total = counts sum
            (total > 0) ifTrue {
                counts = (0..(n - 1)) map { |i| counts at(i) / (total * (edges at(i + 1) - edges at(i))) toFloat }
            }
        }
        color = PlotColor hex(opts get("color") ?? _nextCycle)
        art = nil
        (opts get("histtype") == "step") ifTrue {
            sx2 = [edges first]
            sy2 = [0]
            n times { |i|
                sx2 append(edges at(i)); sy2 append(counts at(i))
                sx2 append(edges at(i + 1)); sy2 append(counts at(i))
            }
            sx2 append(edges last); sy2 append(0)
            art = #{kind: "line", xs: sx2, ys: sy2, color: color, linewidth: opts get("linewidth") ?? _rc("lines.linewidth"),
                    linestyle: "-", label: opts get("label"), alpha: opts get("alpha"), stickyY: [0]}
        } ifFalse {
            art = #{kind: "bars", orient: "v", pos: edges slice(0, n), lengths: counts,
                    width: (0..(n - 1)) map { |i| edges at(i + 1) - edges at(i) },
                    bottom: 0, align: "edge", color: color, label: opts get("label"),
                    alpha: opts get("alpha"), edgecolor: _hexOrNil(opts get("edgecolor")),
                    linewidth: opts get("linewidth")}
        }
        artists append(art)
        [counts, edges, art]
    }

    // Shade between two curves: fillBetween(xs, y1, y2 = 0, #{color:, alpha:,
    // label:}). y2 may be a number or an Array.
    fillBetween(x, y1, y2 = nil, opts = nil) {
        (y2 type == "Dict") ifTrue { opts = y2; y2 = nil }
        opts = opts ?? #{}
        xs = _dx(_seq(x))
        a = _seq(y1)
        b = (y2 == nil) ifTrue { 0 } ifFalse { y2 }
        bs = (b type == "Number") ifTrue { xs map { |v| b } } ifFalse { _seq(b) }
        ((a size != xs size) || (bs size != xs size)) ifTrue { raise("Plot: fillBetween: xs, y1 and y2 must be the same length") }
        art = #{kind: "fill", xs: xs, y1: a, y2: bs, color: PlotColor hex(opts get("color") ?? _nextCycle),
                alpha: opts get("alpha"), label: opts get("label"), edgecolor: _hexOrNil(opts get("edgecolor"))}
        artists append(art)
        art
    }

    // A horizontal line across the axes at y: axhline(y, #{color:, linestyle:,
    // linewidth:, label:, alpha:})
    axhline(y = 0, opts = nil) { _refLine("hline", y, opts ?? #{}) }

    // A vertical line across the axes at x
    axvline(x = 0, opts = nil) { _refLine("vline", _dx1(x), opts ?? #{}) }

    // Text at data coordinates: text(x, y, "label", #{fontsize:, color:, ha:,
    // va:, rotation:, transform: "axes"}). With transform "axes", x and y are
    // fractions of the axes (0, 0 bottom left; 1, 1 top right).
    text(x, y, s, opts = nil) {
        opts = opts ?? #{}
        art = #{kind: "text", x: _dx1(x), y: y, text: s toString, fontsize: opts get("fontsize") ?? _rc("font.size"),
                color: PlotColor hex(opts get("color") ?? "k"), ha: opts get("ha") ?? "left",
                va: opts get("va") ?? "baseline", rotation: opts get("rotation") ?? 0,
                transform: opts get("transform") ?? "data", weight: opts get("fontweight")}
        artists append(art)
        art
    }

    // Text pointing at a point, as matplotlib's annotate:
    //   annotate("peak", [x, y])                     text at the point
    //   annotate("peak", [x, y], [tx, ty], #{arrowprops: #{}})
    //   annotate("best", [x, y], #{xytext: [20, 30], textcoords: "offset points",
    //            arrowprops: #{arrowstyle: "->"}})
    // xy and xytext are data units, or by xycoords / textcoords: "axes
    // fraction" (0..1 of the axes, 0, 0 bottom left), "figure fraction", or
    // for the text, "offset points" from xy (up and right). textcoords is
    // xycoords unless given. arrowprops draws an arrow from the text to xy:
    // arrowstyle ("-|>" by default, "->", "-", "<-", "<->", "<|-", "<|-|>"),
    // color, linewidth (lw), linestyle, alpha, shrink (a fraction of the
    // length left off each end), shrinkA / shrinkB (points; 2). Also text's
    // fontsize, color, ha, va, fontweight, and bbox: #{fc:, ec:, lw:, pad:,
    // alpha:} for a box behind the text.
    annotate(s, xy, xytext = nil, opts = nil) {
        (xytext type == "Dict") ifTrue { opts = xytext; xytext = nil }
        opts = opts ?? #{}
        xytext = xytext ?? opts get("xytext")
        ((xy type == "Array") && (xy size == 2)) ifTrue { xy = [_dx1(xy at(0)), xy at(1)] }
        ((xytext type == "Array") && (xytext size == 2)) ifTrue { xytext = [_dx1(xytext at(0)), xytext at(1)] }
        _pair(xy, "xy")
        xc = _coords(opts get("xycoords") ?? "data", false)
        tc = xc
        (xytext == nil) ifTrue { xytext = xy } ifFalse {
            _pair(xytext, "xytext")
            tc = _coords(opts get("textcoords") ?? xc, true)
        }
        art = #{kind: "annotation", text: s toString, xy: xy, xycoords: xc, xytext: xytext, textcoords: tc,
                fontsize: opts get("fontsize") ?? _rc("font.size"), color: PlotColor hex(opts get("color") ?? "k"),
                ha: opts get("ha") ?? "left", va: opts get("va") ?? "baseline", weight: opts get("fontweight")}
        ap = opts get("arrowprops")
        (ap != nil) ifTrue {
            style = ap get("arrowstyle") ?? "-|>"
            ((["-", "->", "-|>", "<-", "<|-", "<->", "<|-|>"] find { |v| v == style }) == nil) ifTrue {
                raise("Plot: annotate: unknown arrowstyle \"" + style toString + "\" (use \"-|>\", \"->\", \"-\", \"<-\", \"<->\", \"<|-\" or \"<|-|>\")")
            }
            headA = (style startsWith("<|")) ifTrue { "filled" } ifFalse { (style startsWith("<")) ifTrue { "open" } ifFalse { nil } }
            headB = (style endsWith("|>")) ifTrue { "filled" } ifFalse { (style endsWith(">")) ifTrue { "open" } ifFalse { nil } }
            art set("arrow", #{headA: headA, headB: headB,
                color: PlotColor hex(ap get("color") ?? ap get("facecolor") ?? ap get("fc") ?? ap get("edgecolor") ?? ap get("ec") ?? "k"),
                linewidth: ap get("linewidth") ?? ap get("lw") ?? 1, linestyle: ap get("linestyle") ?? ap get("ls") ?? "-",
                alpha: ap get("alpha"), shrink: ap get("shrink"),
                shrinkA: ap get("shrinkA") ?? 2, shrinkB: ap get("shrinkB") ?? 2})
        }
        bb = opts get("bbox")
        (bb != nil) ifTrue {
            art set("bbox", #{fill: _hexOrNil(bb get("fc") ?? bb get("facecolor") ?? "white"),
                              stroke: _hexOrNil(bb get("ec") ?? bb get("edgecolor") ?? "k"),
                              linewidth: bb get("lw") ?? bb get("linewidth") ?? 1, pad: bb get("pad"), alpha: bb get("alpha")})
        }
        artists append(art)
        art
    }

    // Show a 2-D array as an image: rows of numbers (mapped through cmap) or
    // rows of [r, g, b] pixels (0..1, or 0..255 when any value is over 1). A
    // flat Array needs #{shape: [rows, cols]}, unless it is square (784
    // numbers show as 28 x 28). An Image from the image brick works too.
    // Options: cmap, vmin, vmax, aspect ("equal" or "auto"), origin ("upper"
    // or "lower"), extent [left, right, bottom, top].
    imshow(data, opts = nil) {
        opts = opts ?? #{}
        // a colour Image is drawn as it is; anything else becomes rows
        source = nil
        rows = nil
        ((data hasMethod("pngBytes")) && (data hasMethod("channels"))) ifTrue {
            (data channels >= 3) ifTrue { source = data }
        }
        (source == nil) ifTrue { rows = _grid(data, opts get("shape")) }
        nr = (source != nil) ifTrue { source height } ifFalse { rows size }
        nc = (source != nil) ifTrue { source width } ifFalse { rows first size }
        rgb = (source != nil) || (rows first first type == "Array")
        lower = opts get("origin") == "lower"
        ext = opts get("extent")
        (ext == nil) ifTrue {
            ext = lower ifTrue { [-0.5, nc - 0.5, -0.5, nr - 0.5] } ifFalse { [-0.5, nc - 0.5, nr - 0.5, -0.5] }
        }
        art = #{kind: "image", rows: rows, source: source, nrows: nr, ncols: nc, rgb: rgb, extent: ext,
                cmap: opts get("cmap") ?? _rc("image.cmap"), alpha: opts get("alpha"), label: nil}
        rgb ifFalse { _setRange(art, rows flatten, opts) }
        artists append(art)
        ((opts get("aspect") ?? "equal") == "equal") ifTrue { self aspect = "equal" }
        self yInverted = lower not
        (opts get("extent") == nil) ifTrue { self integerX = true; self integerY = true }
        art
    }

    // A colour bar for an image or a colour-mapped scatter (the last one,
    // unless you pass it): colorbar(artist, #{label:})
    colorbar(art = nil, opts = nil) {
        (art type == "Dict" && art get("kind") == nil) ifTrue { opts = art; art = nil }
        target = art ?? (artists reverse find { |x|
            k = x get("kind")
            (k == "image" && x get("rgb") not) || (x get("values") != nil) || (k == "contour") || (k == "contourf")
        })
        (target == nil) ifTrue { raise("Plot: colorbar needs an image, a contour or a scatter with numeric colours (c:) first") }
        self colorbarArtist = target
        self colorbarLabel = (opts == nil) ifTrue { nil } ifFalse { opts get("label") }
        target
    }

    // A step plot: step(xs, ys, fmt, #{where: "pre" (default), "post" or
    // "mid", and plot's options})
    step(x, y, a = nil, b = nil) {
        [items, fmt, opts] = _split([a, b])
        art = _line(_seq(x), _seq(y), fmt, opts)
        art set("drawstyle", "steps-" + (opts get("where") ?? "pre"))
        art
    }

    // Points with error bars: errorbar(xs, ys, #{yerr:, xerr:, fmt:,
    // capsize:, ecolor:, elinewidth:, and plot's options}). yerr and xerr
    // are a number, one per point, or [lows, highs]; errorbar(xs, ys, yerr)
    // works too. fmt "none" draws no line or markers. Returns [line, bars].
    errorbar(x, y, a = nil, b = nil) {
        opts = #{}
        yerr = nil
        [a, b] each { |v|
            (v type == "Dict") ifTrue { opts = v } ifFalse { (v != nil) ifTrue { yerr = v } }
        }
        yerr = opts get("yerr") ?? yerr
        xerr = opts get("xerr")
        xs = _dx(_seq(x))
        ys = _seq(y)
        fmt = opts get("fmt")
        o = _copy(opts)
        (fmt == "none") ifTrue { fmt = nil; o set("linestyle", "none"); o set("marker", nil) }
        line = _line(xs, ys, fmt, o)
        artists pop
        segs = []
        (yerr != nil) ifTrue {
            [lo, hi] = _errs(yerr, ys size)
            ys size times { |i| segs append([xs at(i), ys at(i) - lo at(i), xs at(i), ys at(i) + hi at(i)]) }
        }
        (xerr != nil) ifTrue {
            [lo, hi] = _errs(xerr, xs size)
            xs size times { |i| segs append([xs at(i) - lo at(i), ys at(i), xs at(i) + hi at(i), ys at(i)]) }
        }
        bars = #{kind: "errbar", segs: segs, color: PlotColor hex(opts get("ecolor") ?? line get("color")),
                 linewidth: opts get("elinewidth") ?? line get("linewidth"), capsize: opts get("capsize") ?? 0,
                 alpha: opts get("alpha"), label: nil}
        artists append(bars)
        artists append(line)
        [line, bars]
    }

    // A pie chart: pie(values, #{labels:, colors:, autopct: "%1.1f%%" (or
    // a block given the percentage), startangle: degrees, counterclock:,
    // explode: [offsets], radius:, pctdistance:, labeldistance:, wedgeprops:
    // #{width: (a donut), edgecolor:, linewidth:}, textprops: #{fontsize:,
    // color:}}). Returns [wedges, texts, autotexts], as matplotlib's.
    pie(values, opts = nil) {
        opts = opts ?? #{}
        xs = _seq(values)
        ((xs find { |v| _ok(v) not || (v < 0) }) != nil) ifTrue { raise("Plot: pie values must be numbers, none below zero") }
        total = xs sum
        (total <= 0) ifTrue { raise("Plot: pie needs a value above zero") }
        labels = opts get("labels")
        colors = opts get("colors")
        explode = opts get("explode")
        ccw = opts get("counterclock") ?? true
        r = opts get("radius") ?? 1
        wp = opts get("wedgeprops") ?? #{}
        tp = opts get("textprops") ?? #{}
        autopct = opts get("autopct")
        pctd = opts get("pctdistance") ?? 0.6
        ld = opts get("labeldistance") ?? 1.1
        fsz = tp get("fontsize") ?? _rc("font.size")
        tcolor = tp get("color") ?? "k"
        r0 = (wp get("width") != nil) ifTrue { r - wp get("width") } ifFalse { 0 }
        wedges = []
        texts = []
        autotexts = []
        a = (opts get("startangle") ?? 0) toFloat
        xs size times { |i|
            frac = xs at(i) / total toFloat
            sweep = ccw ifTrue { frac * 360 } ifFalse { 0 - (frac * 360) }
            mid = ((a + (sweep / 2)) * Math pi) / 180
            c = Math cos(mid)
            sn = Math sin(mid)
            off = (explode == nil) ifTrue { 0 } ifFalse { explode at(i) ?? 0 }
            cx = off * c
            cy = off * sn
            color = (colors != nil) ifTrue { colors at(i % colors size) } ifFalse { _nextCycle }
            label = (labels != nil) ifTrue { labels at(i) } ifFalse { nil }
            w = #{kind: "wedge", cx: cx, cy: cy, r: r, r0: r0, a0: a, a1: a + sweep, value: xs at(i),
                  color: PlotColor hex(color), edgecolor: _hexOrNil(wp get("edgecolor")),
                  linewidth: wp get("linewidth"), alpha: wp get("alpha") ?? opts get("alpha"),
                  label: (label == nil) ifTrue { nil } ifFalse { label toString }}
            artists append(w)
            wedges append(w)
            ((label != nil) && (ld != nil)) ifTrue {
                t = text(cx + (ld * r * c), cy + (ld * r * sn), label, #{ha: (c > 0) ifTrue { "left" } ifFalse { "right" },
                        va: "center", fontsize: fsz, color: tcolor})
                texts append(t)
            }
            (autopct != nil) ifTrue {
                t = text(cx + (pctd * r * c), cy + (pctd * r * sn), PlotTicks printf(autopct, frac * 100),
                         #{ha: "center", va: "center", fontsize: fsz, color: tcolor})
                autotexts append(t)
            }
            a = a + sweep
        }
        self aspect = "equal"
        self axisVisible = false
        self xlimits = [-1.25 * r, 1.25 * r]
        self ylimits = [-1.25 * r, 1.25 * r]
        [wedges, texts, autotexts]
    }

    // A stacked area chart: stackplot(xs, [ys1, ys2, ...], #{labels:,
    // colors:, alpha:, baseline: "zero" or "sym"}), or stackplot(xs, ys1,
    // ys2, ..., opts). Returns the areas, bottom first.
    stackplot(x, a = nil, b = nil, c = nil, d = nil, e = nil, f = nil, g = nil, h = nil) {
        [items, fmt, opts] = _split([a, b, c, d, e, f, g, h])
        series = items
        ((items size == 1) && (items first size > 0) && (items first first type == "Array")) ifTrue { series = items first }
        series = series map { |s| _seq(s) }
        xs = _dx(_seq(x))
        series each { |s| (s size != xs size) ifTrue { raise("Plot: stackplot: every series needs one value per x (" + xs size toString + ")") } }
        labels = opts get("labels")
        colors = opts get("colors")
        base = xs map { |v| 0.0 }
        (opts get("baseline") == "sym") ifTrue {
            base = (0..(xs size - 1)) map { |i| 0 - ((series reduce(0) { |m, s| m + s at(i) }) / 2.0) }
        }
        out = []
        series size times { |k|
            s = series at(k)
            top = (0..(xs size - 1)) map { |i| base at(i) + s at(i) }
            color = (colors != nil) ifTrue { colors at(k % colors size) } ifFalse { _nextCycle }
            art = #{kind: "fill", xs: xs, y1: top, y2: base, color: PlotColor hex(color), alpha: opts get("alpha"),
                    label: (labels != nil) ifTrue { labels at(k) } ifFalse { nil },
                    edgecolor: _hexOrNil(opts get("edgecolor")),
                    stickyX: [xs first, xs last], stickyY: [0]}
            artists append(art)
            out append(art)
            base = top
        }
        out
    }

    // Write each bar's value on it: barLabel(bars, #{fmt: "%g" or
    // "{:,.0f}" or a block, labels: [...], labelType: "edge" or "center",
    // padding: points, fontsize:, color:}), as matplotlib's bar_label.
    // Returns the text artists.
    barLabel(bars, opts = nil) {
        opts = opts ?? #{}
        (bars type == "Array") ifTrue { bars = bars at(2) }
        ((bars type != "Dict") || (bars get("kind") != "bars")) ifTrue { raise("Plot: barLabel needs what bar, barh or hist returned") }
        labels = opts get("labels")
        center = opts get("labelType") == "center"
        pad = opts get("padding") ?? 0
        horiz = bars get("orient") == "h"
        out = []
        bars get("pos") size times { |i|
            len = bars get("lengths") at(i)
            _ok(len) ifTrue {
                span = _barSpan(bars, i)
                mid = (span at(0) + span at(1)) / 2.0
                base = _nth(bars get("bottom"), i) ?? 0
                tip = center ifTrue { base + (len / 2.0) } ifFalse { base + len }
                s = (labels != nil) ifTrue { (labels at(i) ?? "") toString } ifFalse { PlotTicks printf(opts get("fmt") ?? "%g", len) }
                up = len >= 0
                o = #{fontsize: opts get("fontsize") ?? _rc("font.size"), color: opts get("color") ?? "k"}
                t = nil
                horiz ifTrue {
                    o set("va", "center")
                    o set("ha", center ifTrue { "center" } ifFalse { up ifTrue { "left" } ifFalse { "right" } })
                    t = text(tip, mid, s, o)
                    center ifFalse { t set("offset", [up ifTrue { pad } ifFalse { 0 - pad }, 0]) }
                } ifFalse {
                    o set("ha", "center")
                    o set("va", center ifTrue { "center" } ifFalse { up ifTrue { "bottom" } ifFalse { "top" } })
                    t = text(mid, tip, s, o)
                    center ifFalse { t set("offset", [0, up ifTrue { pad } ifFalse { 0 - pad }]) }
                }
                out append(t)
            }
        }
        out
    }

    // A band across the axes from ymin to ymax (data units), as matplotlib's
    // axhspan: axhspan(ymin, ymax), axhspan(ymin, ymax, xmin, xmax) with
    // xmin and xmax fractions of the axes' width (0 and 1), and an options
    // Dict last: color (or facecolor), alpha, edgecolor, linewidth, label.
    axhspan(ymin, ymax, a = nil, b = nil, c = nil) { _span("h", ymin, ymax, [a, b, c]) }

    // A band from xmin to xmax (dates work too), across ymin..ymax of the
    // axes' height: axvspan(xmin, xmax, ymin, ymax, opts)
    axvspan(xmin, xmax, a = nil, b = nil, c = nil) { _span("v", _dx1(xmin), _dx1(xmax), [a, b, c]) }

    _span(orient, lo, hi, args) {
        opts = #{}
        f = []
        args each { |v| (v type == "Dict") ifTrue { opts = v } ifFalse { (v != nil) ifTrue { f append(v) } } }
        art = #{kind: "span", orient: orient, lo: lo, hi: hi, f0: f at(0) ?? 0, f1: f at(1) ?? 1,
                color: PlotColor hex(opts get("color") ?? opts get("facecolor") ?? opts get("fc") ?? "C0"),
                alpha: opts get("alpha"), edgecolor: _hexOrNil(opts get("edgecolor") ?? opts get("ec")),
                linewidth: opts get("linewidth") ?? opts get("lw"), label: opts get("label")}
        artists append(art)
        art
    }

    // Points binned into hexagons, coloured by how many fall in each (or by
    // C values reduced per hexagon): hexbin(xs, ys, #{gridsize: 100 (across;
    // or [nx, ny]), C:, reduceC: "mean" ("sum", "max", "min", "median" or a
    // block given a hexagon's values), mincnt: 1, bins: "log" (colour by
    // log10), cmap, vmin, vmax, alpha, edgecolors, extent: [x0, x1, y0, y1],
    // label}). Empty hexagons are left out. Returns the artist (its centres
    // and values), for colorbar.
    hexbin(x, y, opts = nil) {
        opts = opts ?? #{}
        xs0 = _seq(x)
        ys0 = _seq(y)
        (xs0 size != ys0 size) ifTrue { raise("Plot: hexbin: x and y must be the same length (" + xs0 size toString + " and " + ys0 size toString + ")") }
        cs0 = _seq(opts get("C"))
        ((cs0 != nil) && (cs0 size != xs0 size)) ifTrue { raise("Plot: hexbin: C needs one value per point") }
        keep = (0..(xs0 size - 1)) filter { |i| _ok(xs0 at(i)) && _ok(ys0 at(i)) && ((cs0 == nil) || _ok(cs0 at(i))) }
        (keep size == 0) ifTrue { raise("Plot: hexbin needs points") }
        xs = keep map { |i| xs0 at(i) }
        ys = keep map { |i| ys0 at(i) }
        ext = opts get("extent") ?? [xs min, xs max, ys min, ys max]
        x0 = ext at(0) toFloat
        x1 = ext at(1) toFloat
        y0 = ext at(2) toFloat
        y1 = ext at(3) toFloat
        (x1 == x0) ifTrue { x0 = x0 - 0.5; x1 = x1 + 0.5 }
        (y1 == y0) ifTrue { y0 = y0 - 0.5; y1 = y1 + 0.5 }
        g = opts get("gridsize") ?? 100
        nx = (g type == "Array") ifTrue { g at(0) } ifFalse { g }
        ny = (g type == "Array") ifTrue { g at(1) } ifFalse { Math max(1, (nx / Math sqrt(3)) toInt) }
        sx = (x1 - x0) / nx
        sy = (y1 - y0) / ny
        // two offset lattices, as matplotlib's: each point goes to the nearer centre
        cells = Dict clone
        order = []
        xs size times { |k|
            u = (xs at(k) - x0) / sx
            v = (ys at(k) - y0) / sy
            i1 = Math round(u)
            j1 = Math round(v)
            i2 = Math floor(u)
            j2 = Math floor(v)
            d1 = ((u - i1) * (u - i1)) + (3 * ((v - j1) * (v - j1)))
            d2 = ((u - i2 - 0.5) * (u - i2 - 0.5)) + (3 * ((v - j2 - 0.5) * (v - j2 - 0.5)))
            key = (d1 < d2) ifTrue { "a" + i1 toString + "," + j1 toString } ifFalse { "b" + i2 toString + "," + j2 toString }
            c = cells get(key)
            (c == nil) ifTrue {
                cx = (d1 < d2) ifTrue { x0 + (i1 * sx) } ifFalse { x0 + ((i2 + 0.5) * sx) }
                cy = (d1 < d2) ifTrue { y0 + (j1 * sy) } ifFalse { y0 + ((j2 + 0.5) * sy) }
                c = [cx, cy, []]
                cells set(key, c)
                order append(key)
            }
            c at(2) append((cs0 == nil) ifTrue { 1 } ifFalse { cs0 at(keep at(k)) })
        }
        mincnt = opts get("mincnt") ?? 1
        reduce = opts get("reduceC") ?? "mean"
        log = opts get("bins") == "log"
        cxs = []
        cys = []
        vals = []
        order each { |key|
            c = cells get(key)
            items = c at(2)
            (items size >= mincnt) ifTrue {
                v = (cs0 == nil) ifTrue { items size } ifFalse { _reduce(items, reduce) }
                log ifTrue { v = PlotTicks log10(v) }
                (v != nil) ifTrue { cxs append(c at(0)); cys append(c at(1)); vals append(v) }
            }
        }
        lim = #{}
        (opts get("vmin") != nil) ifTrue { lim set("vmin", log ifTrue { PlotTicks log10(opts get("vmin")) } ifFalse { opts get("vmin") }) }
        (opts get("vmax") != nil) ifTrue { lim set("vmax", log ifTrue { PlotTicks log10(opts get("vmax")) } ifFalse { opts get("vmax") }) }
        art = #{kind: "hexbin", xs: cxs, ys: cys, values: vals, sx: sx, sy: sy, log: log, extent: [x0, x1, y0, y1],
                cmap: opts get("cmap") ?? _rc("image.cmap"), alpha: opts get("alpha"),
                edgecolor: _hexOrNil(opts get("edgecolors") ?? opts get("edgecolor")), label: opts get("label")}
        _setRange(art, vals, lim)
        artists append(art)
        art
    }

    // A hexagon's values reduced to one number
    _reduce(items, how) {
        (how type == "Block") ifTrue { return how value(items) }
        (how == "mean") ifTrue { return items sum / items size toFloat }
        (how == "sum") ifTrue { return items sum }
        (how == "max") ifTrue { return items max }
        (how == "min") ifTrue { return items min }
        (how == "median") ifTrue { return PlotStats quantile(items sort, 0.5) }
        raise("Plot: hexbin: reduceC must be \"mean\", \"sum\", \"max\", \"min\", \"median\" or a block")
    }

    // A 2-D histogram: hist2d(xs, ys, bins, opts) or hist2d(xs, ys, opts).
    // bins: a count for both (10), [nx, ny], or [xEdges, yEdges]. Options:
    // bins, range: [[x0, x1], [y0, y1]], density, cmin / cmax (cells with
    // fewer / more counts are left empty), cmap, vmin, vmax, alpha. Returns
    // [counts, xEdges, yEdges, artist] as numpy's: counts at(i) at(j) is x
    // bin i, y bin j.
    hist2d(x, y, bins = nil, opts = nil) {
        (bins type == "Dict") ifTrue { opts = bins; bins = nil }
        opts = opts ?? #{}
        bins = bins ?? opts get("bins") ?? 10
        xs0 = _seq(x)
        ys0 = _seq(y)
        (xs0 size != ys0 size) ifTrue { raise("Plot: hist2d: x and y must be the same length (" + xs0 size toString + " and " + ys0 size toString + ")") }
        keep = (0..(xs0 size - 1)) filter { |i| _ok(xs0 at(i)) && _ok(ys0 at(i)) }
        xs = keep map { |i| xs0 at(i) }
        ys = keep map { |i| ys0 at(i) }
        rng = opts get("range")
        bx = ((bins type == "Array") && (bins size == 2)) ifTrue { bins at(0) } ifFalse { bins }
        by = ((bins type == "Array") && (bins size == 2)) ifTrue { bins at(1) } ifFalse { bins }
        xe = _edges(xs, bx, (rng == nil) ifTrue { nil } ifFalse { rng at(0) })
        ye = _edges(ys, by, (rng == nil) ifTrue { nil } ifFalse { rng at(1) })
        nx = xe size - 1
        ny = ye size - 1
        counts = (1..nx) map { |i| (1..ny) map { |j| 0 } }
        xs size times { |k|
            u = xs at(k)
            v = ys at(k)
            ((u >= xe first) && (u <= xe last) && (v >= ye first) && (v <= ye last)) ifTrue {
                row = counts at(_bin(xe, u))
                j = _bin(ye, v)
                row setAt(j, row at(j) + 1)
            }
        }
        (opts get("density") == true) ifTrue {
            total = (counts map { |r| r sum }) sum
            (total > 0) ifTrue {
                counts = (0..(nx - 1)) map { |i| (0..(ny - 1)) map { |j|
                    counts at(i) at(j) / (total * (xe at(i + 1) - xe at(i)) * (ye at(j + 1) - ye at(j))) toFloat
                } }
            }
        }
        cmin = opts get("cmin")
        cmax = opts get("cmax")
        nan = 0.0 / 0.0
        shown = (0..(ny - 1)) map { |j| (0..(nx - 1)) map { |i|
            c = counts at(i) at(j)
            (((cmin != nil) && (c < cmin)) || ((cmax != nil) && (c > cmax))) ifTrue { nan } ifFalse { c }
        } }
        art = #{kind: "mesh", xedges: xe, yedges: ye, cells: shown, cmap: opts get("cmap") ?? _rc("image.cmap"),
                alpha: opts get("alpha"), label: opts get("label")}
        flat = (shown flatten) filter { |v| _ok(v) }
        _setRange(art, flat, opts)
        art set("values", flat)
        artists append(art)
        [counts, xe, ye, art]
    }

    // Bin edges: given edges as they are, or a count of equal bins over
    // range [lo, hi] (the data's, when not given)
    _edges(values, bins, rng) {
        (bins type == "Array") ifTrue { return bins }
        lo = (rng != nil) ifTrue { rng at(0) } ifFalse { (values size > 0) ifTrue { values min } ifFalse { 0 } }
        hi = (rng != nil) ifTrue { rng at(1) } ifFalse { (values size > 0) ifTrue { values max } ifFalse { 1 } }
        (hi == lo) ifTrue { lo = lo - 0.5; hi = hi + 0.5 }
        lo = lo toFloat
        (0..bins) map { |i| lo + (((hi - lo) * i) / bins) }
    }

    // Box plots: boxplot(values), boxplot([set1, set2, ...]) or
    // boxplot(#{name: values, ...}) (the names label the boxes). Each box
    // runs from the first to the third quartile with a line at the median;
    // whiskers reach the furthest data within whis box lengths (1.5), or
    // whis: [5, 95] percentiles, and points beyond are drawn as fliers.
    // Options: positions (1, 2, ...), widths (0.5), labels, orientation
    // ("vertical" or "horizontal"; or vert: false), notch, showmeans,
    // showfliers, showcaps, showbox, sym ("" hides fliers; "r+" etc.),
    // patchArtist (fill the boxes), colors (a fill per box), label, and
    // boxprops (facecolor, edgecolor, linewidth, linestyle), medianprops,
    // whiskerprops, capprops (color, linewidth, linestyle), flierprops,
    // meanprops (marker, markerfacecolor, markeredgecolor, markersize).
    // Returns the artist; its "stats" are each box's numbers (PlotStats
    // boxStats: q1, med, q3, whislo, whishi, fliers, mean ...).
    boxplot(data, opts = nil) {
        opts = opts ?? #{}
        [sets, names] = _datasets(data, "boxplot")
        n = sets size
        vert = _vertical(opts)
        positions = _positions(opts, n, "boxplot")
        stats = sets map { |s| PlotStats boxStats(s, opts get("whis") ?? 1.5) }
        bp = opts get("boxprops") ?? #{}
        fill = nil
        ((opts get("patchArtist") == true) || (bp get("facecolor") != nil)) ifTrue {
            fill = _hexOrNil(bp get("facecolor") ?? PlotColor cycleColor(0))
        }
        colors = opts get("colors")
        (colors != nil) ifTrue { colors = _seq(colors) map { |c| PlotColor hex(c) } }
        flier = _markerProps(opts get("flierprops"), "o", nil, "k")
        showfliers = opts get("showfliers") ?? true
        sym = opts get("sym")
        (sym != nil) ifTrue {
            (sym == "") ifTrue { showfliers = false } ifFalse {
                f = _parseFmt(sym)
                flier set("marker", f get("marker") ?? "o")
                (f get("color") != nil) ifTrue { flier set("edge", PlotColor hex(f get("color"))); flier set("face", PlotColor hex(f get("color"))) }
            }
        }
        green = PlotColor cycleColor(2)
        art = #{kind: "boxes", vert: vert, positions: positions, widths: opts get("widths") ?? 0.5, stats: stats,
                notch: opts get("notch") == true, showfliers: showfliers, showmeans: opts get("showmeans") == true,
                showcaps: opts get("showcaps") ?? true, showbox: opts get("showbox") ?? true,
                fill: fill, colors: colors,
                box: _lineProps(bp, "k", 1, bp get("edgecolor")),
                median: _lineProps(opts get("medianprops"), PlotColor cycleColor(1), 1, nil),
                whisker: _lineProps(opts get("whiskerprops"), "k", 1, nil),
                cap: _lineProps(opts get("capprops"), "k", 1, nil),
                flier: flier, mean: _markerProps(opts get("meanprops"), "^", green, green),
                label: opts get("label")}
        art set("color", (colors != nil) ifTrue { colors first } ifFalse { fill })
        _categoryTicks(vert, positions, opts get("labels") ?? opts get("tickLabels") ?? names)
        artists append(art)
        art
    }

    // Violin plots: the shape of each data set's distribution (a Gaussian
    // kernel density estimate), mirrored about its position. Data as for
    // boxplot. Options: positions, widths (0.5), labels, orientation (or
    // vert: false), showextrema (true), showmeans, showmedians, quantiles
    // ([0.25, 0.75] for every set, or a list per set), points (100),
    // bwMethod ("scott", "silverman" or a number), color, colors (one per
    // violin), alpha (0.3), label. Returns the artist; its "bodies" hold
    // each violin's coords, density, min, max, mean and median.
    violinplot(data, opts = nil) {
        opts = opts ?? #{}
        [sets, names] = _datasets(data, "violinplot")
        n = sets size
        vert = _vertical(opts)
        positions = _positions(opts, n, "violinplot")
        qs = opts get("quantiles")
        bodies = []
        n times { |i|
            s = PlotStats clean(sets at(i))
            k = PlotStats kde(s, opts get("points") ?? 100, opts get("bwMethod") ?? opts get("bw_method"))
            q = nil
            (qs != nil) ifTrue {
                q = ((qs size > 0) && (qs first type == "Array")) ifTrue { qs at(i) ?? [] } ifFalse { qs }
            }
            bodies append(#{coords: k get("coords"), density: k get("density"),
                            min: (s size > 0) ifTrue { s first } ifFalse { nil },
                            max: (s size > 0) ifTrue { s last } ifFalse { nil },
                            mean: PlotStats mean(s), median: PlotStats quantile(s, 0.5),
                            quantiles: (q ?? []) map { |p| PlotStats quantile(s, p) }})
        }
        colors = opts get("colors")
        (colors != nil) ifTrue { colors = _seq(colors) map { |c| PlotColor hex(c) } }
        color = PlotColor hex(opts get("color") ?? opts get("facecolor") ?? _nextCycle)
        art = #{kind: "violin", vert: vert, positions: positions, widths: opts get("widths") ?? 0.5,
                bodies: bodies, color: color, colors: colors, alpha: opts get("alpha") ?? 0.3,
                showextrema: opts get("showextrema") ?? true, showmeans: opts get("showmeans") == true,
                showmedians: opts get("showmedians") == true, label: opts get("label")}
        _categoryTicks(vert, positions, opts get("labels") ?? opts get("tickLabels") ?? names)
        artists append(art)
        art
    }

    // Contour lines of Z, rows of numbers (Z at(i) at(j) is at row i, column
    // j): contour(Z), contour(Z, levels), contour(X, Y, Z), contour(X, Y, Z,
    // levels), each with an options Dict last. X and Y place the columns and
    // rows: one value per column / row, or rows like Z's (a mesh grid);
    // without them, columns are at 0, 1, 2 ... and rows likewise, row 0 at
    // the bottom. levels: about how many (7), or a list. Options: levels,
    // colors (one for all, or one per level; with one colour, negative
    // levels are dashed), cmap (otherwise), linewidths, linestyles, alpha,
    // label. Returns the artist, for clabel and colorbar.
    contour(a = nil, b = nil, c = nil, d = nil, e = nil) { _contour(false, [a, b, c, d, e]) }

    // Filled contours: bands of colour between the levels; arguments as
    // contour's. With a number of levels, the bands cover all the data.
    // Options: levels, colors (one per band), cmap, alpha, label.
    contourf(a = nil, b = nil, c = nil, d = nil, e = nil) { _contour(true, [a, b, c, d, e]) }

    // Write each contour line's level on it, in a gap in the line:
    // clabel(cs, #{fmt: "%.1f", fontsize:, colors:, inline: true})
    clabel(cs, opts = nil) {
        ((cs type != "Dict") || (cs get("kind") != "contour")) ifTrue { raise("Plot: clabel needs what contour returned (contourf has no lines to label)") }
        o = opts ?? #{}
        cs set("clabel", #{fmt: o get("fmt"), fontsize: o get("fontsize") ?? _rc("font.size"), inline: o get("inline") ?? true,
                           color: (o get("colors") == nil) ifTrue { nil } ifFalse { PlotColor hex(o get("colors")) }})
        cs
    }

    _contour(filled, args) {
        who = filled ifTrue { "contourf" } ifFalse { "contour" }
        items = args filter { |v| v != nil }
        opts = #{}
        ((items size > 0) && (items last type == "Dict")) ifTrue { opts = items last; items = items slice(0, items size - 1) }
        n = items size
        ((n < 1) || (n > 4)) ifTrue { raise("Plot: " + who + " takes Z, Z and levels, X, Y and Z, or X, Y, Z and levels (then an options Dict)") }
        z = (n <= 2) ifTrue { items at(0) } ifFalse { items at(2) }
        spec = (n == 2) ifTrue { items at(1) } ifFalse { (n == 4) ifTrue { items at(3) } ifFalse { nil } }
        spec = spec ?? opts get("levels")
        g = PlotContour grid((n >= 3) ifTrue { _seqOrRows(items at(0)) } ifFalse { nil },
                             (n >= 3) ifTrue { _seqOrRows(items at(1)) } ifFalse { nil },
                             _grid(z, opts get("shape")))
        levels = PlotContour levels(g, spec, filled)
        (filled && (levels size < 2)) ifTrue { raise("Plot: contourf needs at least two levels") }
        // where each level (or band) falls on the colormap
        lo = (levels size > 0) ifTrue { levels first } ifFalse { 0 }
        hi = (levels size > 0) ifTrue { levels last } ifFalse { 1 }
        marks = filled ifTrue { (0..(levels size - 2)) map { |k| (levels at(k) + levels at(k + 1)) / 2.0 } } ifFalse { levels }
        cmap = opts get("cmap") ?? _rc("image.cmap")
        given = opts get("colors")
        colors = []
        marks size times { |k|
            v = marks at(k)
            (given != nil) ifTrue {
                colors append((given type == "Array") ifTrue { PlotColor hex(given at(k % given size)) } ifFalse { PlotColor hex(given) })
            } ifFalse {
                colors append(PlotColor toHex(PlotColor colormap(cmap, (hi == lo) ifTrue { 0.5 } ifFalse { (v - lo) / (hi - lo) toFloat })))
            }
        }
        xr = _extentOf(g get("xs"))
        yr = _extentOf(g get("ys"))
        art = #{kind: who, levels: levels, colors: colors, alpha: opts get("alpha"), cmap: cmap, vmin: lo, vmax: hi,
                extent: [xr at(0), xr at(1), yr at(0), yr at(1)], label: opts get("label")}
        art set("color", (colors size > 0) ifTrue { colors at(colors size / 2) } ifFalse { "#000000" })
        filled ifTrue {
            art set("polys", PlotContour bands(g, levels))
        } ifFalse {
            art set("paths", levels map { |l| PlotContour lines(g, l) })
            lws = opts get("linewidths") ?? _rc("lines.linewidth")
            mono = (given != nil) && (given type != "Array")
            lss = opts get("linestyles") ?? (levels map { |l| (mono && (l < 0)) ifTrue { "--" } ifFalse { "-" } })
            art set("linewidths", lws)
            art set("linestyles", lss)
            art set("linewidth", _nth(lws, 0))
            art set("linestyle", "-")
        }
        artists append(art)
        art
    }

    // X or Y for contour: a flat Array, rows, or a Range
    _seqOrRows(v) { (v type == "Range") ifTrue { v toArray } ifFalse { v } }

    // [smallest, largest] of rows of numbers
    _extentOf(rows) {
        lo = nil
        hi = nil
        rows each { |r| r each { |v|
            ((lo == nil) || (v < lo)) ifTrue { lo = v }
            ((hi == nil) || (v > hi)) ifTrue { hi = v }
        } }
        [lo, hi]
    }

    // ---- machine-learning plots (ml.clay) --------------------------------

    // Training history: what clay-ann's fit returns (a Dict per epoch), net
    // history rows [loss, learningRate, validationLoss] (-1 for none), an
    // Array of losses, or a Dict of named series
    learningCurve(history, opts = nil) { PlotML learningCurve(self, history, opts ?? #{}) }

    // A confusion matrix (rows: actual class) as an annotated heatmap
    confusionMatrix(matrix, opts = nil) { PlotML confusionMatrix(self, matrix, opts ?? #{}) }

    // ROC curves (one per class for rows of scores), with their AUC
    roc(scores, targets, opts = nil) { PlotML roc(self, scores, targets, opts ?? #{}) }

    // Precision-recall curves, with their average precision
    precisionRecall(scores, targets, opts = nil) { PlotML precisionRecall(self, scores, targets, opts ?? #{}) }

    // What a classifier decides across the plane of its two inputs, with
    // the data on top (see PlotML decisionBoundary)
    decisionBoundary(model, inputs, labels = nil, opts = nil) {
        (labels type == "Dict") ifTrue { opts = labels; labels = nil }
        PlotML decisionBoundary(self, model, inputs, labels, opts ?? #{})
    }

    // ---- twin axes ------------------------------------------------------

    // A second axes over this one, sharing its x axis, with its own y axis
    // on the right (matplotlib's twinx): ax2 = ax twinx; ax2 plot(xs, acc).
    // The twins share one colour cycle, and a legend on either lists the
    // labelled artists of both.
    twinx() { _twin("x") }

    // A second axes sharing this one's y axis, with its own x axis along the top
    twiny() { _twin("y") }

    _twin(kind) {
        (host != nil) ifTrue { return host _twin(kind) }
        t = PlotAxes new(figure, cell)
        t host = self
        t twinKind = kind
        t gridOn = false
        twins append(t)
        figure axesList append(t)
        t
    }

    // This axes and its twins (or its host and the host's twins)
    _group() { (host != nil) ifTrue { host _group } ifFalse { [self] + twins } }

    // A twin's share of its host's view: the shared axis's range, scale and direction
    _share(hv) {
        (twinKind == "x") ifTrue { self xLog = host xLog } ifFalse { self yLog = host yLog; self yInverted = host yInverted }
        v = _view
        self view = (twinKind == "x") ifTrue { [hv at(0), hv at(1), v at(2), v at(3)] } ifFalse { [v at(0), v at(1), hv at(2), hv at(3)] }
    }

    // ---- labels and settings --------------------------------------------

    title(s, opts = nil) { self titleText = s; self titleOpts = opts ?? #{}; self }
    xlabel(s) { self xlabelText = s; self }
    ylabel(s) { self ylabelText = s; self }

    // xlim(lo, hi) or xlim([lo, hi]) sets the x range (nil keeps that end
    // automatic); xlim() returns the range in use, [lo, hi]
    xlim(lo = nil, hi = nil) {
        (twinKind == "x") ifTrue { return host xlim(lo, hi) }
        ((lo == nil) && (hi == nil)) ifTrue { v = _view; return [_untx(v at(0), xLog), _untx(v at(1), xLog)] }
        (lo type == "Array") ifTrue { hi = lo at(1); lo = lo at(0) }
        lims = [_dx1(lo), _dx1(hi)]
        (xGroup ?? [self]) each { |a| a xlimits = lims }
        self
    }

    ylim(lo = nil, hi = nil) {
        (twinKind == "y") ifTrue { return host ylim(lo, hi) }
        ((lo == nil) && (hi == nil)) ifTrue { v = _view; return [_untx(v at(2), yLog), _untx(v at(3), yLog)] }
        (lo type == "Array") ifTrue { hi = lo at(1); lo = lo at(0) }
        lims = [lo, hi]
        (yGroup ?? [self]) each { |a| a ylimits = lims }
        self
    }

    // xticks(values), xticks(values, labels), xticks(values, labels,
    // #{rotation: 45}); xticks([]) hides them
    xticks(values = nil, labels = nil, opts = nil) { self xtickSpec = _tickSpec(values, labels, opts); self }
    yticks(values = nil, labels = nil, opts = nil) { self ytickSpec = _tickSpec(values, labels, opts); self }

    // grid(), grid(false), grid(true, #{axis: "y", color:, linestyle:, alpha:})
    grid(on = true, opts = nil) {
        (on type == "Dict") ifTrue { opts = on; on = true }
        self gridOn = on
        self gridOpts = opts ?? #{}
        self
    }

    // legend(), legend(["a", "b"]) to name the artists in order, or
    // legend(#{loc: "upper left", fontsize:, title:}). loc: "best" (default),
    // "upper right", "upper left", "lower left", "lower right", "right",
    // "center left", "center right", "lower center", "upper center", "center"
    legend(a = nil, b = nil) {
        opts = #{}
        (a type == "Dict") ifTrue { opts = a }
        (b type == "Dict") ifTrue { opts = b }
        (a type == "Array") ifTrue {
            named = []
            _group each { |ax| ax artists each { |x|
                k = x get("kind")
                ((k != "text") && (k != "annotation") && (k != "image")) ifTrue { named append(x) }
            } }
            (a size) times { |i| (i < named size) ifTrue { named at(i) set("label", a at(i)) } }
        }
        self legendOpts = opts
        self
    }

    // axis("off"), axis("on"), axis("equal"), axis("tight"), or
    // axis([x0, x1, y0, y1])
    axis(mode) {
        (mode type == "Array") ifTrue { xlim(mode at(0), mode at(1)); ylim(mode at(2), mode at(3)); return self }
        (mode == "off") ifTrue { self axisVisible = false; return self }
        (mode == "on") ifTrue { self axisVisible = true; return self }
        (mode == "equal" || mode == "image" || mode == "scaled") ifTrue { self aspect = "equal"; return self }
        (mode == "auto") ifTrue { self aspect = nil; return self }
        (mode == "tight") ifTrue { xlim(xlim); ylim(ylim); return self }
        raise("Plot: axis takes \"off\", \"on\", \"equal\", \"auto\", \"tight\" or [x0, x1, y0, y1]")
    }

    // Remove everything drawn and set on the axes (matplotlib's ax.clear,
    // pyplot's cla): to redraw it afresh, as each frame of a movie
    clear() {
        self artists = []
        self nextColor = 0
        self titleText = nil
        self titleOpts = nil
        self xlabelText = nil
        self ylabelText = nil
        self xlimits = nil
        self ylimits = nil
        self xtickSpec = nil
        self ytickSpec = nil
        self legendOpts = nil
        self colorbarArtist = nil
        self colorbarLabel = nil
        self aspect = nil
        self yInverted = false
        self axisVisible = true
        self integerX = false
        self integerY = false
        self xLog = false
        self yLog = false
        self xDates = false
        self xOrigin = nil
        self
    }

    invertYaxis() {
        (twinKind == "y") ifTrue { host invertYaxis; return self }
        self yInverted = yInverted not
        self
    }

    // xscale("log") or xscale("linear"); yscale likewise
    xscale(kind) {
        (twinKind == "x") ifTrue { host xscale(kind); return self }
        log = _scale(kind)
        (xGroup ?? [self]) each { |a| a xLog = log }
        self
    }
    yscale(kind) {
        (twinKind == "y") ifTrue { host yscale(kind); return self }
        log = _scale(kind)
        (yGroup ?? [self]) each { |a| a yLog = log }
        self
    }

    _scale(kind) {
        (kind == "log") ifTrue { return true }
        (kind == "linear") ifTrue { return false }
        raise("Plot: scale must be \"linear\" or \"log\"")
    }

    // plot with a log y axis, a log x axis, or both
    semilogy(a = nil, b = nil, c = nil, d = nil) { yscale("log"); plot(a, b, c, d) }
    semilogx(a = nil, b = nil, c = nil, d = nil) { xscale("log"); plot(a, b, c, d) }
    loglog(a = nil, b = nil, c = nil, d = nil) { xscale("log"); yscale("log"); plot(a, b, c, d) }

    // Several settings at once, as matplotlib's ax.set: set(#{title:, xlabel:,
    // ylabel:, xlim:, ylim:, xticks:, yticks:})
    set(opts) {
        opts each { |k, v|
            (k == "title") ifTrue { title(v) }
            (k == "xlabel") ifTrue { xlabel(v) }
            (k == "ylabel") ifTrue { ylabel(v) }
            (k == "xlim") ifTrue { xlim(v) }
            (k == "ylim") ifTrue { ylim(v) }
            (k == "xticks") ifTrue { xticks(v) }
            (k == "yticks") ifTrue { yticks(v) }
            (k == "xscale") ifTrue { xscale(v) }
            (k == "yscale") ifTrue { yscale(v) }
            (k == "aspect") ifTrue { self aspect = (v == "equal") ifTrue { "equal" } ifFalse { nil } }
        }
        self
    }

    // ---- layout (used by the figure) ------------------------------------

    // Space needed around the plot box: [left, top, right, bottom] in pixels,
    // given ticks worked out for an axis length of about w x h
    _margins(cv, w, h) {
        self view = _view
        _computeTicks(cv, w, h)
        tl = _pt(3.5)
        pad = _pt(3.5)
        fs = _pt(_rc("xtick.labelsize"))
        left = 0
        top = 0
        right = 0
        bottom = 0
        axisVisible ifTrue {
            ywid = yt get("labels") reduce(0) { |m, s| Math max(m, _tickWidth(cv, s, fs)) }
            left = tl + (hideYTicks ifTrue { 0 } ifFalse { pad + ywid })
            (ylabelText != nil) ifTrue { left = left + (_pt(_rc("axes.labelsize")) * 1.2) + _pt(4) }
            bottom = tl + (hideXTicks ifTrue { 0 } ifFalse { pad + _xLabelHeight(cv, fs) })
            ((xlabelText != nil) || ((xt get("offset") ?? "") != "")) ifTrue { bottom = bottom + (_pt(_rc("axes.labelsize")) * 1.25) + _pt(4) }
            labs = xt get("labels")
            ((labs size > 0) && (xt get("rotation") == 0)) ifTrue { right = _tickWidth(cv, labs last, fs) / 2 }
            (yt get("labels") size > 0) ifTrue { top = fs / 2 }
        }
        (colorbarArtist != nil) ifTrue { right = _colorbarWidth(cv, h) }
        // twins: their axes go on the right (twinx) or along the top (twiny)
        twins each { |t|
            t _share(view)
            t _computeTicks(cv, w, h)
            room = t _twinRoom(cv)
            (t twinKind == "x") ifTrue { right = Math max(right, room) } ifFalse { top = Math max(top, room) }
        }
        ta = _titleAxes
        (ta != nil) ifTrue { top = _twinTop(cv) + (ta _titleSize * 1.25) + _pt(6) }
        // a legend anchored outside the axes
        room = _legendRoom(cv, w, h)
        [left + room at(0), Math max(top, room at(1)), Math max(right, room at(2)), bottom + room at(3)]
    }

    // The room a twin's own axis takes beside the plot box, in pixels
    _twinRoom(cv) {
        axisVisible ifFalse { return 0 }
        tl = _pt(3.5)
        pad = _pt(3.5)
        fs = _pt(_rc("xtick.labelsize"))
        (twinKind == "x") ifTrue {
            ywid = yt get("labels") reduce(0) { |m, s| Math max(m, _tickWidth(cv, s, fs)) }
            room = tl + pad + ywid
            (ylabelText != nil) ifTrue { room = room + (_pt(_rc("axes.labelsize")) * 1.2) + _pt(4) }
            return room
        }
        room = tl + pad + _xLabelHeight(cv, fs)
        (xlabelText != nil) ifTrue { room = room + (_pt(_rc("axes.labelsize")) * 1.25) + _pt(4) }
        room
    }

    // The room twiny axes take above the plot box
    _twinTop(cv) {
        twins reduce(0) { |m, t| (t twinKind == "y") ifTrue { Math max(m, t _twinRoom(cv)) } ifFalse { m } }
    }

    // The axes whose title is shown over the box: this one's, or a twin's
    // (Plot title after Plot twinx sets the twin's)
    _titleAxes() {
        (titleText != nil) ifTrue { return self }
        twins find { |t| t titleText != nil }
    }

    // Place the plot box (the figure has worked out the margins)
    _place(cv, box) {
        x = box at(0)
        y = box at(1)
        w = Math max(box at(2), 10)
        h = Math max(box at(3), 10)
        v = view
        (aspect == "equal") ifTrue {
            dx = (v at(1) - v at(0)) abs
            dy = (v at(3) - v at(2)) abs
            ((dx > 0) && (dy > 0)) ifTrue {
                (w / dx > h / dy) ifTrue {
                    nw = (h * dx) / dy
                    x = x + ((w - nw) / 2)
                    w = nw
                } ifFalse {
                    nh = (w * dy) / dx
                    y = y + ((h - nh) / 2)
                    h = nh
                }
            }
        }
        self plotBox = [x, y, w, h]
        self sx = w / (v at(1) - v at(0))
        self ox = x - (v at(0) * sx)
        yInverted ifTrue {
            self sy = h / (v at(3) - v at(2))
            self oy = y - (v at(2) * sy)
        } ifFalse {
            self sy = 0 - (h / (v at(3) - v at(2)))
            self oy = (y + h) - (v at(2) * sy)
        }
        _computeTicks(cv, w, h)
        twins each { |t| t _place(cv, plotBox) }
    }

    // Data to pixels. On a log axis, values at or below zero land far
    // outside the plot box (the clip hides them), so bars still reach down.
    _px(x) { xLog ifTrue { ox + ((PlotTicks log10(x) ?? (Math min(view at(0), view at(1)) - 30)) * sx) } ifFalse { ox + (x * sx) } }
    _py(y) { yLog ifTrue { oy + ((PlotTicks log10(y) ?? (Math min(view at(2), view at(3)) - 30)) * sy) } ifFalse { oy + (y * sy) } }

    // View units (log10 of the data on a log axis; ticks are in these) to pixels
    _vx(t) { ox + (t * sx) }
    _vy(t) { oy + (t * sy) }

    // ---- rendering ------------------------------------------------------

    draw(cv) {
        b = plotBox
        bx = b at(0)
        by = b at(1)
        bw = b at(2)
        bh = b at(3)
        axisVisible ifTrue {
            fc = _rc("axes.facecolor")
            (fc != nil && fc != "white" && fc != "#ffffff") ifTrue { cv rect(bx, by, bw, bh, #{fill: PlotColor hex(fc)}) }
        }
        // twins are drawn here with their host, over the same box
        group = _group
        group each { |ax| (ax gridOn && ax axisVisible) ifTrue { ax _drawGrid(cv) } }
        cv clip(bx, by, bw, bh)
        group each { |ax|
            [0, 1, 2] each { |z|
                ax artists each { |art| (ax _zorder(art) == z) ifTrue { ax _drawArtist(cv, art) } }
            }
        }
        cv unclip
        group each { |ax|
            ax artists each { |art|
                k = art get("kind")
                (k == "text") ifTrue { ax _drawText(cv, art) }
                (k == "annotation") ifTrue { ax _drawAnnotation(cv, art) }
            }
        }
        axisVisible ifTrue { _drawAxis(cv) }
        twins each { |t| t axisVisible ifTrue { t _drawTwinAxis(cv) } }
        ta = _titleAxes
        (ta != nil) ifTrue {
            topts = ta titleOpts ?? #{}
            loc = topts get("loc") ?? "center"
            tx = (loc == "left") ifTrue { bx } ifFalse { (loc == "right") ifTrue { bx + bw } ifFalse { bx + (bw / 2) } }
            anchor = (loc == "left") ifTrue { "start" } ifFalse { (loc == "right") ifTrue { "end" } ifFalse { "middle" } }
            cv text(tx, by - _pt(6) - _twinTop(cv), ta titleText, #{size: ta _titleSize, anchor: anchor, valign: "bottom",
                                                                   color: PlotColor hex(topts get("color") ?? "k")})
        }
        group each { |ax| (ax legendOpts != nil) ifTrue { ax _drawLegend(cv) } }
        (colorbarArtist != nil) ifTrue { _drawColorbar(cv) }
    }

    _drawArtist(cv, art) {
        k = art get("kind")
        (k == "line") ifTrue { return _drawLine(cv, art) }
        (k == "scatter") ifTrue { return _drawScatter(cv, art) }
        (k == "bars") ifTrue { return _drawBars(cv, art) }
        (k == "fill") ifTrue { return _drawFill(cv, art) }
        (k == "hline" || k == "vline") ifTrue { return _drawRefLine(cv, art) }
        (k == "image") ifTrue { return _drawImage(cv, art) }
        (k == "wedge") ifTrue { return _drawWedge(cv, art) }
        (k == "errbar") ifTrue { return _drawErrbar(cv, art) }
        (k == "boxes") ifTrue { return _drawBoxes(cv, art) }
        (k == "violin") ifTrue { return _drawViolins(cv, art) }
        (k == "contour") ifTrue { return _drawContour(cv, art) }
        (k == "contourf") ifTrue { return _drawContourf(cv, art) }
        (k == "span") ifTrue { return _drawSpan(cv, art) }
        (k == "hexbin") ifTrue { return _drawHexbin(cv, art) }
        (k == "mesh") ifTrue { return _drawMesh(cv, art) }
        nil
    }

    _zorder(art) {
        k = art get("kind")
        (k == "image" || k == "contourf" || k == "mesh") ifTrue { return 0 }
        (k == "span") ifTrue { return 1 }
        (k == "bars" || k == "fill" || k == "wedge" || k == "violin") ifTrue { return 1 }
        (k == "text") ifTrue { return 3 }
        2
    }

    _drawLine(cv, art) {
        xs = art get("xs")
        ys = art get("ys")
        color = PlotColor hex(art get("color"))
        lw = _pt(art get("linewidth"))
        ls = art get("linestyle")
        alpha = art get("alpha")
        ((ls != "none") && (ls != "") && (ls != " ")) ifTrue {
            style = #{stroke: color, width: lw, dash: _dash(ls, lw), alpha: alpha, join: "round", cap: "butt"}
            ds = art get("drawstyle")
            px = []
            py = []
            xs size times { |i|
                x = xs at(i)
                y = ys at(i)
                (_okX(x) && _okY(y)) ifTrue {
                    px append(_px(x)); py append(_py(y))
                } ifFalse {
                    _polyline(cv, px, py, ds, style)
                    px = []
                    py = []
                }
            }
            _polyline(cv, px, py, ds, style)
        }
        marker = art get("marker")
        ((marker != nil) && (marker != "none") && (marker != "")) ifTrue {
            ms = _pt(art get("markersize") ?? _rc("lines.markersize"))
            face = _hexOrNil(art get("markerfacecolor")) ?? color
            edge = _hexOrNil(art get("markeredgecolor")) ?? face
            xs size times { |i|
                x = xs at(i)
                y = ys at(i)
                (_okX(x) && _okY(y)) ifTrue { _marker(cv, marker, _px(x), _py(y), ms, face, edge, alpha) }
            }
        }
    }

    // A run of points, as steps for drawstyle "steps-pre", "steps-post" or
    // "steps-mid" (step plots)
    _polyline(cv, px, py, ds, style) {
        ((ds == nil) || (ds == "default") || (px size < 2)) ifTrue { return cv polyline(px, py, style) }
        qx = [px first]
        qy = [py first]
        (1..(px size - 1)) each { |i|
            (ds == "steps-pre") ifTrue { qx append(qx last); qy append(py at(i)) }
            (ds == "steps-post") ifTrue { qx append(px at(i)); qy append(qy last) }
            (ds == "steps-mid") ifTrue {
                mid = (px at(i - 1) + px at(i)) / 2
                qx append(mid); qy append(qy last)
                qx append(mid); qy append(py at(i))
            }
            qx append(px at(i)); qy append(py at(i))
        }
        cv polyline(qx, qy, style)
    }

    _drawScatter(cv, art) {
        xs = art get("xs")
        ys = art get("ys")
        sizes = art get("sizes")
        values = art get("values")
        colors = art get("colors")
        lut = (values != nil) ifTrue { PlotColor lut(art get("cmap")) } ifFalse { nil }
        lo = art get("vmin")
        hi = art get("vmax")
        span = ((hi ?? 1) - (lo ?? 0)) toFloat
        (span == 0) ifTrue { span = 1.0 }
        one = art get("color")
        edge = art get("edgecolor")
        marker = art get("marker")
        alpha = art get("alpha")
        xs size times { |i|
            x = xs at(i)
            y = ys at(i)
            (_okX(x) && _okY(y)) ifTrue {
                s = (sizes type == "Array") ifTrue { sizes at(i) } ifFalse { sizes }
                color = one
                (values != nil) ifTrue {
                    v = values at(i)
                    color = _ok(v) ifTrue { lut at(Math round((((v - lo) / span) clamp(0, 1)) * 255)) } ifFalse { nil }
                }
                (colors != nil) ifTrue { color = colors at(i) }
                (color != nil) ifTrue { _marker(cv, marker, _px(x), _py(y), _pt(Math sqrt(s)), color, edge ?? color, alpha) }
            }
        }
    }

    _drawBars(cv, art) {
        pos = art get("pos")
        lens = art get("lengths")
        horiz = art get("orient") == "h"
        edge = art get("edgecolor")
        lw = (edge != nil) ifTrue { _pt(art get("linewidth") ?? 1) } ifFalse { nil }
        colors = art get("colors")
        pos size times { |i|
            span = _barSpan(art, i)
            base = _nth(art get("bottom"), i) ?? 0
            len = lens at(i)
            _ok(len) ifTrue {
                fill = (colors != nil) ifTrue { colors at(i % colors size) } ifFalse { art get("color") }
                style = #{fill: fill, stroke: edge, width: lw, alpha: art get("alpha")}
                horiz ifTrue {
                    x0 = _px(base)
                    x1 = _px(base + len)
                    y0 = _py(span at(0))
                    y1 = _py(span at(1))
                    cv rect(Math min(x0, x1), Math min(y0, y1), (x1 - x0) abs, (y1 - y0) abs, style)
                } ifFalse {
                    x0 = _px(span at(0))
                    x1 = _px(span at(1))
                    y0 = _py(base)
                    y1 = _py(base + len)
                    cv rect(Math min(x0, x1), Math min(y0, y1), (x1 - x0) abs, (y1 - y0) abs, style)
                }
            }
        }
    }

    _drawFill(cv, art) {
        xs = art get("xs")
        a = art get("y1")
        b = art get("y2")
        px = []
        py = []
        xs size times { |i| px append(_px(xs at(i))); py append(_py(a at(i))) }
        (xs size) times { |j|
            i = (xs size - 1) - j
            px append(_px(xs at(i))); py append(_py(b at(i)))
        }
        edge = art get("edgecolor")
        cv polygon(px, py, #{fill: art get("color"), alpha: art get("alpha"), stroke: edge, width: (edge != nil) ifTrue { _pt(1) } ifFalse { nil }})
    }

    // A pie wedge: an arc from a0 to a1 degrees (anticlockwise from east)
    // around cx, cy, closed through the centre or along an inner arc (donuts)
    _drawWedge(cv, art) {
        cx = art get("cx")
        cy = art get("cy")
        r = art get("r")
        r0 = art get("r0")
        a0 = art get("a0")
        a1 = art get("a1")
        sweep = a1 - a0
        steps = Math max(2, Math ceil(sweep abs / 2) toInt)
        px = []
        py = []
        arc = { |rad, from, to|
            (0..steps) each { |i|
                ang = ((from + (((to - from) * i) / steps)) * Math pi) / 180
                px append(_px(cx + (rad * Math cos(ang)))); py append(_py(cy + (rad * Math sin(ang))))
            }
        }
        arc value(r, a0, a1)
        (r0 > 0) ifTrue { arc value(r0, a1, a0) } ifFalse {
            (sweep abs < 359.99) ifTrue { px append(_px(cx)); py append(_py(cy)) }
        }
        edge = art get("edgecolor")
        cv polygon(px, py, #{fill: art get("color"), alpha: art get("alpha"), stroke: edge,
                             width: (edge != nil) ifTrue { _pt(art get("linewidth") ?? 1) } ifFalse { nil }, join: "round"})
    }

    // Error bars: segments [x0, y0, x1, y1] in data units, with caps
    _drawErrbar(cv, art) {
        lw = _pt(art get("linewidth"))
        style = #{stroke: art get("color"), width: lw, alpha: art get("alpha")}
        cap = _pt(art get("capsize")) / 2
        art get("segs") each { |s|
            ok = _okX(s at(0)) && _okY(s at(1)) && _okX(s at(2)) && _okY(s at(3))
            ok ifTrue {
                x0 = _px(s at(0))
                y0 = _py(s at(1))
                x1 = _px(s at(2))
                y1 = _py(s at(3))
                cv line(x0, y0, x1, y1, style)
                (cap > 0) ifTrue {
                    (s at(0) == s at(2)) ifTrue {
                        cv line(x0 - cap, y0, x0 + cap, y0, style)
                        cv line(x1 - cap, y1, x1 + cap, y1, style)
                    } ifFalse {
                        cv line(x0, y0 - cap, x0, y0 + cap, style)
                        cv line(x1, y1 - cap, x1, y1 + cap, style)
                    }
                }
            }
        }
    }

    // A point of a box or violin in pixels: pos along the category axis, v
    // along the value axis
    _boxPoint(vert, pos, v) { vert ifTrue { [_px(pos), _py(v)] } ifFalse { [_px(v), _py(pos)] } }

    // A line from (pos0, v0) to (pos1, v1) in box coordinates
    _boxLine(cv, vert, pos0, v0, pos1, v1, style) {
        a = _boxPoint(vert, pos0, v0)
        b = _boxPoint(vert, pos1, v1)
        cv line(a at(0), a at(1), b at(0), b at(1), style)
    }

    _drawBoxes(cv, art) {
        vert = art get("vert")
        whisker = _strokeOf(art get("whisker"))
        cap = _strokeOf(art get("cap"))
        median = _strokeOf(art get("median"))
        boxStyle = _strokeOf(art get("box"))
        fl = art get("flier")
        mn = art get("mean")
        colors = art get("colors")
        art get("stats") size times { |i|
            st = art get("stats") at(i)
            (st get("n") > 0) ifTrue {
                pos = art get("positions") at(i)
                half = _nth(art get("widths"), i) / 2.0
                q1 = st get("q1")
                q3 = st get("q3")
                med = st get("med")
                _boxLine(cv, vert, pos, q1, pos, st get("whislo"), whisker)
                _boxLine(cv, vert, pos, q3, pos, st get("whishi"), whisker)
                art get("showcaps") ifTrue {
                    _boxLine(cv, vert, pos - (half / 2), st get("whislo"), pos + (half / 2), st get("whislo"), cap)
                    _boxLine(cv, vert, pos - (half / 2), st get("whishi"), pos + (half / 2), st get("whishi"), cap)
                }
                // the box's outline as [offset from pos, value] corners;
                // a notch narrows it to half its width at the median
                inner = half
                shape = [[0 - half, q1], [half, q1], [half, q3], [0 - half, q3]]
                art get("notch") ifTrue {
                    inner = half / 2
                    lo = Math max(st get("cilo"), q1)
                    hi = Math min(st get("cihi"), q3)
                    shape = [[0 - half, q1], [half, q1], [half, lo], [inner, med], [half, hi], [half, q3],
                             [0 - half, q3], [0 - half, hi], [0 - inner, med], [0 - half, lo]]
                }
                art get("showbox") ifTrue {
                    xs = []
                    ys = []
                    shape each { |c|
                        p = _boxPoint(vert, pos + c at(0), c at(1))
                        xs append(p at(0)); ys append(p at(1))
                    }
                    fill = (colors != nil) ifTrue { colors at(i % colors size) } ifFalse { art get("fill") }
                    style = _copy(boxStyle)
                    style set("fill", fill)
                    style set("join", "miter")
                    cv polygon(xs, ys, style)
                }
                _boxLine(cv, vert, pos - inner, med, pos + inner, med, median)
                art get("showfliers") ifTrue {
                    ms = _pt(fl get("size"))
                    st get("fliers") each { |v|
                        p = _boxPoint(vert, pos, v)
                        _marker(cv, fl get("marker"), p at(0), p at(1), ms, fl get("face"), fl get("edge") ?? fl get("face"), fl get("alpha"))
                    }
                }
                art get("showmeans") ifTrue {
                    p = _boxPoint(vert, pos, st get("mean"))
                    _marker(cv, mn get("marker"), p at(0), p at(1), _pt(mn get("size")), mn get("face"), mn get("edge") ?? mn get("face"), mn get("alpha"))
                }
            }
        }
    }

    _drawViolins(cv, art) {
        vert = art get("vert")
        colors = art get("colors")
        lines = #{stroke: art get("color"), width: _pt(1), cap: "butt"}
        art get("bodies") size times { |i|
            b = art get("bodies") at(i)
            coords = b get("coords")
            (coords size > 0) ifTrue {
                pos = art get("positions") at(i)
                half = _nth(art get("widths"), i) / 2.0
                dens = b get("density")
                top = dens max
                scale = (top > 0) ifTrue { half / top } ifFalse { 0 }
                xs = []
                ys = []
                coords size times { |j|
                    p = _boxPoint(vert, pos + (dens at(j) * scale), coords at(j))
                    xs append(p at(0)); ys append(p at(1))
                }
                coords size times { |j|
                    k = (coords size - 1) - j
                    p = _boxPoint(vert, pos - (dens at(k) * scale), coords at(k))
                    xs append(p at(0)); ys append(p at(1))
                }
                fill = (colors != nil) ifTrue { colors at(i % colors size) } ifFalse { art get("color") }
                cv polygon(xs, ys, #{fill: fill, alpha: art get("alpha"), stroke: fill, width: _pt(1)})
                q = half / 2
                art get("showextrema") ifTrue {
                    _boxLine(cv, vert, pos, b get("min"), pos, b get("max"), lines)
                    _boxLine(cv, vert, pos - q, b get("min"), pos + q, b get("min"), lines)
                    _boxLine(cv, vert, pos - q, b get("max"), pos + q, b get("max"), lines)
                }
                art get("showmedians") ifTrue { _boxLine(cv, vert, pos - q, b get("median"), pos + q, b get("median"), lines) }
                art get("showmeans") ifTrue { _boxLine(cv, vert, pos - q, b get("mean"), pos + q, b get("mean"), lines) }
                b get("quantiles") each { |v| _boxLine(cv, vert, pos - q, v, pos + q, v, lines) }
            }
        }
    }

    _drawSpan(cv, art) {
        b = plotBox
        a = 0
        c = 0
        (art get("orient") == "v") ifTrue {
            x0 = _px(art get("lo"))
            x1 = _px(art get("hi"))
            y0 = (b at(1) + b at(3)) - (art get("f1") * b at(3))
            y1 = (b at(1) + b at(3)) - (art get("f0") * b at(3))
            a = [Math min(x0, x1), y0, (x1 - x0) abs, y1 - y0]
        } ifFalse {
            y0 = _py(art get("lo"))
            y1 = _py(art get("hi"))
            x0 = b at(0) + (art get("f0") * b at(2))
            x1 = b at(0) + (art get("f1") * b at(2))
            a = [x0, Math min(y0, y1), x1 - x0, (y1 - y0) abs]
        }
        edge = art get("edgecolor")
        cv rect(a at(0), a at(1), a at(2), a at(3), #{fill: art get("color"), alpha: art get("alpha"), stroke: edge,
                                                      width: (edge != nil) ifTrue { _pt(art get("linewidth") ?? 1) } ifFalse { nil }})
    }

    // Hexagons, pointy side up, in a colour from their value. Opaque ones
    // get a hairline of their own colour (no seams between neighbours).
    _drawHexbin(cv, art) {
        lut = PlotColor lut(art get("cmap"))
        lo = art get("vmin")
        span = (art get("vmax") - lo) toFloat
        (span == 0) ifTrue { span = 1.0 }
        hx = art get("sx") / 2
        hy = art get("sy") / 6
        dx = [hx, hx, 0, 0 - hx, 0 - hx, 0]
        dy = [0 - hy, hy, hy * 2, hy, 0 - hy, 0 - (hy * 2)]
        alpha = art get("alpha")
        edge = art get("edgecolor")
        art get("values") size times { |i|
            v = art get("values") at(i)
            c = lut at(Math round((((v - lo) / span) clamp(0, 1)) * 255))
            cx = art get("xs") at(i)
            cy = art get("ys") at(i)
            px = dx map { |d| _px(cx + d) }
            py = dy map { |d| _py(cy + d) }
            style = (edge != nil) ifTrue { #{fill: c, alpha: alpha, stroke: edge, width: _pt(0.5)} } ifFalse {
                ((alpha == nil) || (alpha >= 1)) ifTrue { #{fill: c, stroke: c, width: 1.0} } ifFalse { #{fill: c, alpha: alpha} }
            }
            cv polygon(px, py, style)
        }
    }

    // Cells between x and y edges, in a colour from their value; nil and
    // nan cells are left empty
    _drawMesh(cv, art) {
        lut = PlotColor lut(art get("cmap"))
        lo = art get("vmin")
        span = (art get("vmax") - lo) toFloat
        (span == 0) ifTrue { span = 1.0 }
        xe = art get("xedges")
        ye = art get("yedges")
        alpha = art get("alpha")
        hair = (alpha == nil) || (alpha >= 1)
        art get("cells") size times { |j|
            row = art get("cells") at(j)
            row size times { |i|
                v = row at(i)
                _ok(v) ifTrue {
                    c = lut at(Math round((((v - lo) / span) clamp(0, 1)) * 255))
                    x0 = _px(xe at(i))
                    x1 = _px(xe at(i + 1))
                    y0 = _py(ye at(j))
                    y1 = _py(ye at(j + 1))
                    style = hair ifTrue { #{fill: c, stroke: c, width: 1.0} } ifFalse { #{fill: c, alpha: alpha} }
                    cv rect(Math min(x0, x1), Math min(y0, y1), (x1 - x0) abs, (y1 - y0) abs, style)
                }
            }
        }
    }

    // Filled contours. Each band is many polygons; opaque ones get a hairline
    // of their own colour, so antialiased edges don't leave seams between them
    _drawContourf(cv, art) {
        alpha = art get("alpha")
        hair = (alpha == nil) || (alpha >= 1)
        art get("polys") size times { |b|
            c = art get("colors") at(b)
            style = hair ifTrue { #{fill: c, stroke: c, width: 1.25, join: "round"} } ifFalse { #{fill: c, alpha: alpha} }
            art get("polys") at(b) each { |poly|
                cv polygon(poly map { |p| _px(p at(0)) }, poly map { |p| _py(p at(1)) }, style)
            }
        }
    }

    _drawContour(cv, art) {
        lab = art get("clabel")
        levels = art get("levels")
        levels size times { |k|
            lw = _pt(_nth(art get("linewidths"), k))
            style = #{stroke: art get("colors") at(k), width: lw, dash: _dash(_nth(art get("linestyles"), k), lw),
                      alpha: art get("alpha"), join: "round", cap: "butt"}
            art get("paths") at(k) each { |line|
                px = []
                py = []
                line each { |p| (_okX(p at(0)) && _okY(p at(1))) ifTrue { px append(_px(p at(0))); py append(_py(p at(1))) } }
                (px size >= 2) ifTrue {
                    (lab != nil) ifTrue { _labelledLine(cv, px, py, levels at(k), lab, style) } ifFalse { cv polyline(px, py, style) }
                }
            }
        }
    }

    // A contour line with its level written halfway along it, turned to
    // follow the line, in a gap cut for it (inline) or over it. Lines too
    // short for the text are left unlabelled.
    _labelledLine(cv, px, py, level, lab, style) {
        text = (lab get("fmt") != nil) ifTrue { PlotTicks printf(lab get("fmt"), level) } ifFalse { PlotTicks short(level) }
        fs = _pt(lab get("fontsize"))
        w = cv measure(text, fs)
        cum = [0.0]
        (px size - 1) times { |i|
            dx = px at(i + 1) - px at(i)
            dy = py at(i + 1) - py at(i)
            cum append(cum last + Math sqrt((dx * dx) + (dy * dy)))
        }
        total = cum last
        (total < (w * 2.5)) ifTrue { return cv polyline(px, py, style) }
        mid = total / 2
        pad = fs * 0.3
        g0 = mid - (w / 2) - pad
        g1 = mid + (w / 2) + pad
        a = _along(px, py, cum, g0)
        b = _along(px, py, cum, g1)
        m = _along(px, py, cum, mid)
        (lab get("inline")) ifTrue {
            x1 = []
            y1 = []
            x2 = [b at(0)]
            y2 = [b at(1)]
            px size times { |i|
                (cum at(i) < g0) ifTrue { x1 append(px at(i)); y1 append(py at(i)) }
                (cum at(i) > g1) ifTrue { x2 append(px at(i)); y2 append(py at(i)) }
            }
            x1 append(a at(0)); y1 append(a at(1))
            cv polyline(x1, y1, style)
            cv polyline(x2, y2, style)
        } ifFalse {
            cv polyline(px, py, style)
        }
        // pixels run down; angles run anticlockwise. Keep the text upright.
        rot = PlotContour angle(b at(0) - a at(0), a at(1) - b at(1))
        (rot > 90) ifTrue { rot = rot - 180 }
        (rot < -90) ifTrue { rot = rot + 180 }
        cv text(m at(0), m at(1), text, #{size: fs, anchor: "middle", valign: "center", rotate: rot,
                                          color: lab get("color") ?? style get("stroke")})
    }

    // The point at distance s along a polyline (cum: the distance at each point)
    _along(px, py, cum, s) {
        i = 0
        { (i < cum size - 2) && (cum at(i + 1) < s) } whileTrue { i = i + 1 }
        seg = cum at(i + 1) - cum at(i)
        f = (seg > 0) ifTrue { ((s - cum at(i)) / seg) clamp(0, 1) } ifFalse { 0 }
        [px at(i) + (f * (px at(i + 1) - px at(i))), py at(i) + (f * (py at(i + 1) - py at(i)))]
    }

    _drawRefLine(cv, art) {
        b = plotBox
        lw = _pt(art get("linewidth"))
        style = #{stroke: art get("color"), width: lw, dash: _dash(art get("linestyle"), lw), alpha: art get("alpha")}
        (art get("kind") == "hline") ifTrue {
            y = _py(art get("value"))
            cv line(b at(0), y, b at(0) + b at(2), y, style)
        } ifFalse {
            x = _px(art get("value"))
            cv line(x, b at(1), x, b at(1) + b at(3), style)
        }
    }

    _drawImage(cv, art) {
        ext = art get("extent")
        xa = _px(ext at(0))
        xb = _px(ext at(1))
        ya = _py(ext at(2))
        yb = _py(ext at(3))
        img = art get("source") ?? _imageOf(art)
        // the first row belongs at the extent's top: flip when that is lower
        cv image(Math min(xa, xb), Math min(ya, yb), (xb - xa) abs, (yb - ya) abs, img,
                 #{alpha: art get("alpha"), flipY: yb > ya})
    }

    // An image artist's rows as an Image: colours as they are (0..1, or
    // 0..255 when any is over 1), numbers through the colormap (nil and nan
    // left transparent)
    _imageOf(art) {
        rows = art get("rows")
        nr = rows size
        nc = rows first size
        art get("rgb") ifTrue {
            ch = (rows first first size >= 4) ifTrue { 4 } ifFalse { 3 }
            flat = (rows flatten) map { |p| p slice(0, ch) }
            flat = flat flatten
            (flat max > 1) ifTrue { flat = flat map { |v| v / 255.0 } }
            return Image fromFloats(nc, nr, ch, flat)
        }
        nan = 0.0 / 0.0
        flat = (rows flatten) map { |v| _ok(v) ifTrue { v } ifFalse { nan } }
        Image colormap(nc, nr, flat, PlotColor palette(art get("cmap")), art get("vmin"), art get("vmax"))
    }

    _drawText(cv, art) {
        x = art get("x")
        y = art get("y")
        px = 0
        py = 0
        (art get("transform") == "axes") ifTrue {
            b = plotBox
            px = b at(0) + (x * b at(2))
            py = (b at(1) + b at(3)) - (y * b at(3))
        } ifFalse {
            px = _px(x)
            py = _py(y)
        }
        off = art get("offset")
        (off != nil) ifTrue {
            px = px + _pt(off at(0))
            py = py - _pt(off at(1))
        }
        ha = art get("ha")
        anchor = (ha == "center") ifTrue { "middle" } ifFalse { (ha == "right") ifTrue { "end" } ifFalse { "start" } }
        va = art get("va")
        valign = (va == "center") ifTrue { "center" } ifFalse { (va == "top") ifTrue { "top" } ifFalse { (va == "bottom") ifTrue { "bottom" } ifFalse { "baseline" } } }
        cv text(px, py, art get("text"), #{size: _pt(art get("fontsize")), color: art get("color"), anchor: anchor,
                                         valign: valign, rotate: art get("rotation"), weight: art get("weight")})
    }

    // An annotation: an arrow from the text (from the edge of its box) to
    // xy, then the box, then the text
    _drawAnnotation(cv, art) {
        p = _coordsAt(art get("xy"), art get("xycoords"), nil)
        q = _coordsAt(art get("xytext"), art get("textcoords"), p)
        fs = _pt(art get("fontsize"))
        s = art get("text")
        ha = art get("ha")
        anchor = (ha == "center") ifTrue { "middle" } ifFalse { (ha == "right") ifTrue { "end" } ifFalse { "start" } }
        va = art get("va")
        valign = (va == "center") ifTrue { "center" } ifFalse { (va == "top") ifTrue { "top" } ifFalse { (va == "bottom") ifTrue { "bottom" } ifFalse { "baseline" } } }
        w = cv measure(s, fs)
        left = (anchor == "middle") ifTrue { q at(0) - (w / 2) } ifFalse { (anchor == "end") ifTrue { q at(0) - w } ifFalse { q at(0) } }
        // a line of text spans 0.76 of its size above the baseline, 0.24 below
        top = (q at(1) + PlotSvg _baselineShift(valign, fs)) - (fs * 0.76)
        box = [left, top, w, fs]
        bb = art get("bbox")
        (bb != nil) ifTrue {
            pad = _pt(bb get("pad") ?? (art get("fontsize") * 0.3))
            box = [left - pad, top - pad, w + (pad * 2), fs + (pad * 2)]
        }
        (art get("arrow") != nil) ifTrue { _drawArrow(cv, box, p, art get("arrow"), fs) }
        (bb != nil) ifTrue {
            cv rect(box at(0), box at(1), box at(2), box at(3),
                    #{fill: bb get("fill"), stroke: bb get("stroke"), width: _pt(bb get("linewidth")), alpha: bb get("alpha")})
        }
        cv text(q at(0), q at(1), s, #{size: fs, color: art get("color"), anchor: anchor, valign: valign, weight: art get("weight")})
    }

    // An arrow from the edge of box (pixels [x, y, w, h]) towards the point
    // p, its heads sized by the text's size fs as matplotlib's are
    _drawArrow(cv, box, p, ap, fs) {
        cx = box at(0) + (box at(2) / 2)
        cy = box at(1) + (box at(3) / 2)
        dx = p at(0) - cx
        dy = p at(1) - cy
        len = Math sqrt((dx * dx) + (dy * dy))
        (len < 1) ifTrue { return nil }
        // where the line leaves the box (and shrinkA beyond it), as a
        // fraction of the way from the box's centre to p
        hw = (box at(2) / 2) + _pt(ap get("shrinkA"))
        hh = (box at(3) / 2) + _pt(ap get("shrinkA"))
        tx = (dx abs > 0.001) ifTrue { hw / dx abs } ifFalse { 1000000.0 }
        ty = (dy abs > 0.001) ifTrue { hh / dy abs } ifFalse { 1000000.0 }
        t0 = Math min(tx, ty)
        t1 = 1 - (_pt(ap get("shrinkB")) / len)
        f = ap get("shrink")
        (f != nil) ifTrue { t0 = t0 + f; t1 = t1 - f }
        (t0 >= t1) ifTrue { return nil }       // the point is under the text
        x0 = cx + (dx * t0)
        y0 = cy + (dy * t0)
        x1 = cx + (dx * t1)
        y1 = cy + (dy * t1)
        ux = dx / len
        uy = dy / len
        seg = (t1 - t0) * len
        hl = Math min(fs * 0.4, seg * 0.45)
        hw2 = hl / 2
        color = ap get("color")
        lw = _pt(ap get("linewidth"))
        alpha = ap get("alpha")
        // the line stops at the base of a filled head, so its end can't show past the tip
        la = (ap get("headA") == "filled") ifTrue { hl } ifFalse { 0 }
        lb = (ap get("headB") == "filled") ifTrue { hl } ifFalse { 0 }
        cv line(x0 + (ux * la), y0 + (uy * la), x1 - (ux * lb), y1 - (uy * lb),
                #{stroke: color, width: lw, dash: _dash(ap get("linestyle"), lw), alpha: alpha})
        (ap get("headB") != nil) ifTrue { _arrowHead(cv, x1, y1, ux, uy, ap get("headB"), hl, hw2, color, lw, alpha) }
        (ap get("headA") != nil) ifTrue { _arrowHead(cv, x0, y0, 0 - ux, 0 - uy, ap get("headA"), hl, hw2, color, lw, alpha) }
    }

    // An arrow head with its tip at tx, ty pointing along ux, uy: a filled
    // triangle, or two open strokes
    _arrowHead(cv, tx, ty, ux, uy, kind, l, w, color, lw, alpha) {
        bx = tx - (ux * l)
        by = ty - (uy * l)
        nx = 0 - (uy * w)
        ny = ux * w
        (kind == "filled") ifTrue {
            return cv polygon([tx, bx + nx, bx - nx], [ty, by + ny, by - ny], #{fill: color, stroke: color, width: lw * 0.5, alpha: alpha})
        }
        cv polyline([bx + nx, tx, bx - nx], [by + ny, ty, by - ny], #{stroke: color, width: lw, alpha: alpha, join: "miter", cap: "butt"})
    }

    // A point [a, b] in the given coordinates as pixels; "offset points"
    // are from base (pixels)
    _coordsAt(xy, coords, base) {
        a = xy at(0)
        b = xy at(1)
        (coords == "data") ifTrue { return [_px(a), _py(b)] }
        (coords == "axes fraction") ifTrue {
            bx = plotBox
            return [bx at(0) + (a * bx at(2)), (bx at(1) + bx at(3)) - (b * bx at(3))]
        }
        (coords == "figure fraction") ifTrue { return [a * figure width, (1 - b) * figure height] }
        [base at(0) + _pt(a), base at(1) - _pt(b)]
    }

    // annotate's coordinate names ("axes" and "figure" for short)
    _coords(name, forText) {
        (name == "axes") ifTrue { name = "axes fraction" }
        (name == "figure") ifTrue { name = "figure fraction" }
        ok = (name == "data") || (name == "axes fraction") || (name == "figure fraction") || (forText && (name == "offset points"))
        ok ifFalse {
            raise("Plot: annotate: unknown coordinates \"" + name toString + "\" (use \"data\", \"axes fraction\", \"figure fraction\"" +
                  (forText ifTrue { " or \"offset points\")" } ifFalse { ")" }))
        }
        name
    }

    _pair(v, what) {
        ok = (v type == "Array") && (v size == 2) && (v at(0) type == "Number") && (v at(1) type == "Number")
        ok ifFalse { raise("Plot: annotate: " + what + " must be two numbers, [x, y]") }
        v
    }

    _drawGrid(cv) {
        o = gridOpts ?? #{}
        which = o get("axis") ?? "both"
        // a twin's grid follows its own axis; the shared one is the host's
        (twinKind == "x") ifTrue { which = (which == "x") ifTrue { "none" } ifFalse { "y" } }
        (twinKind == "y") ifTrue { which = (which == "y") ifTrue { "none" } ifFalse { "x" } }
        (which == "none") ifTrue { return nil }
        lw = _pt(o get("linewidth") ?? _rc("grid.linewidth"))
        style = #{stroke: PlotColor hex(o get("color") ?? _rc("grid.color")), width: lw,
                  dash: _dash(o get("linestyle") ?? "-", lw), alpha: o get("alpha") ?? _rc("grid.alpha")}
        b = plotBox
        (which != "y") ifTrue {
            xt get("values") each { |v| x = _vx(v); cv line(x, b at(1), x, b at(1) + b at(3), style) }
        }
        (which != "x") ifTrue {
            yt get("values") each { |v| y = _vy(v); cv line(b at(0), y, b at(0) + b at(2), y, style) }
        }
    }

    _drawAxis(cv) {
        b = plotBox
        bx = b at(0)
        by = b at(1)
        bw = b at(2)
        bh = b at(3)
        lw = _pt(_rc("axes.linewidth"))
        spine = #{stroke: "#000000", width: lw, cap: "square"}
        cv line(bx, by, bx + bw, by, spine)
        cv line(bx, by + bh, bx + bw, by + bh, spine)
        cv line(bx, by, bx, by + bh, spine)
        cv line(bx + bw, by, bx + bw, by + bh, spine)
        tl = _pt(3.5)
        pad = _pt(3.5)
        fs = _pt(_rc("xtick.labelsize"))
        tick = #{stroke: "#000000", width: lw}
        rot = xt get("rotation")
        xv = xt get("values")
        xl = xt get("labels")
        xv size times { |i|
            x = _vx(xv at(i))
            cv line(x, by + bh, x, by + bh + tl, tick)
            (rot == 0) ifTrue {
                _tickText(cv, x, by + bh + tl + pad, xl at(i), #{size: fs, anchor: "middle", valign: "top"})
            } ifFalse {
                cv text(x, by + bh + tl + pad, xl at(i), #{size: fs, anchor: "end", valign: "top", rotate: rot})
            }
        }
        yv = yt get("values")
        yl = yt get("labels")
        yv size times { |i|
            y = _vy(yv at(i))
            cv line(bx - tl, y, bx, y, tick)
            _tickText(cv, bx - tl - pad, y, yl at(i), #{size: fs, anchor: "end", valign: "center"})
        }
        // minor ticks (log axes)
        minor = #{stroke: "#000000", width: _pt(0.6)}
        (xt get("minor") ?? []) each { |v| x = _vx(v); cv line(x, by + bh, x, by + bh + _pt(2), minor) }
        (yt get("minor") ?? []) each { |v| y = _vy(v); cv line(bx - _pt(2), y, bx, y, minor) }
        ls = _pt(_rc("axes.labelsize"))
        (xlabelText != nil) ifTrue {
            cv text(bx + (bw / 2), by + bh + tl + pad + _xLabelHeight(cv, fs) + _pt(4), xlabelText, #{size: ls, anchor: "middle", valign: "top"})
        }
        off = xt get("offset") ?? ""
        (off != "") ifTrue {
            cv text(bx + bw, by + bh + tl + pad + _xLabelHeight(cv, fs) + _pt(4), off, #{size: fs, anchor: "end", valign: "top"})
        }
        (ylabelText != nil) ifTrue {
            ywid = yl reduce(0) { |m, s| Math max(m, _tickWidth(cv, s, fs)) }
            cv text(bx - tl - pad - ywid - _pt(4), by + (bh / 2), ylabelText, #{size: ls, anchor: "middle", valign: "bottom", rotate: 90})
        }
    }

    // A twin's own axis: ticks and labels on the right (twinx) or along the
    // top (twiny); the host draws the frame
    _drawTwinAxis(cv) {
        b = plotBox
        bx = b at(0)
        by = b at(1)
        bw = b at(2)
        bh = b at(3)
        lw = _pt(_rc("axes.linewidth"))
        tl = _pt(3.5)
        pad = _pt(3.5)
        fs = _pt(_rc("xtick.labelsize"))
        ls = _pt(_rc("axes.labelsize"))
        tick = #{stroke: "#000000", width: lw}
        minor = #{stroke: "#000000", width: _pt(0.6)}
        (twinKind == "x") ifTrue {
            right = bx + bw
            yv = yt get("values")
            yl = yt get("labels")
            yv size times { |i|
                y = _vy(yv at(i))
                cv line(right, y, right + tl, y, tick)
                _tickText(cv, right + tl + pad, y, yl at(i), #{size: fs, anchor: "start", valign: "center"})
            }
            (yt get("minor") ?? []) each { |v| y = _vy(v); cv line(right, y, right + _pt(2), y, minor) }
            (ylabelText != nil) ifTrue {
                ywid = yl reduce(0) { |m, s| Math max(m, _tickWidth(cv, s, fs)) }
                cv text(right + tl + pad + ywid + _pt(4), by + (bh / 2), ylabelText, #{size: ls, anchor: "middle", valign: "top", rotate: 90})
            }
            return nil
        }
        rot = xt get("rotation")
        xv = xt get("values")
        xl = xt get("labels")
        xv size times { |i|
            x = _vx(xv at(i))
            cv line(x, by, x, by - tl, tick)
            (rot == 0) ifTrue {
                _tickText(cv, x, by - tl - pad, xl at(i), #{size: fs, anchor: "middle", valign: "bottom"})
            } ifFalse {
                cv text(x, by - tl - pad, xl at(i), #{size: fs, anchor: "start", valign: "bottom", rotate: rot})
            }
        }
        (xt get("minor") ?? []) each { |v| x = _vx(v); cv line(x, by, x, by - _pt(2), minor) }
        (xlabelText != nil) ifTrue {
            cv text(bx + (bw / 2), by - tl - pad - _xLabelHeight(cv, fs) - _pt(4), xlabelText, #{size: ls, anchor: "middle", valign: "bottom"})
        }
    }

    // The artists a legend lists: the labelled ones of this axes and its twins
    _legendEntries() {
        out = []
        _group each { |ax|
            ax artists each { |a|
                k = a get("kind")
                ok = (a get("label") != nil) && (k != "text") && (k != "annotation") && (k != "image")
                (ok && (a get("label") toString startsWith("_") not)) ifTrue { out append(a) }
            }
        }
        out
    }

    _drawLegend(cv) {
        entries = _legendEntries
        (entries size == 0) ifTrue { return nil }
        o = legendOpts
        lay = _legendLayout(cv, entries, o)
        pos = _legendAt(lay, o)
        _legendBox(cv, lay, pos at(0), pos at(1), o)
    }

    // Where the legend's top left goes: anchored by bboxToAnchor (axes
    // fractions, which may be outside 0..1: the legend's loc corner goes
    // there), or at loc inside the axes ("best" finds the emptiest corner)
    _legendAt(lay, o) {
        w = lay get("w")
        h = lay get("h")
        anchor = o get("bboxToAnchor") ?? o get("bbox_to_anchor")
        (anchor != nil) ifTrue {
            b = plotBox
            ax = b at(0) + (anchor at(0) * b at(2))
            ay = (b at(1) + b at(3)) - (anchor at(1) * b at(3))
            return _cornerAt(o get("loc") ?? "upper left", ax, ay, w, h)
        }
        inset = lay get("fs") * 0.5
        loc = o get("loc") ?? "best"
        (loc == "best") ifTrue { loc = _bestLoc(w, h, inset) }
        _legendPos(loc, w, h, inset)
    }

    // The top left of a w x h box whose loc corner (or side, or centre) is at x, y
    _cornerAt(loc, x, y, w, h) {
        lx = x
        ly = y
        (loc contains("right")) ifTrue { lx = x - w }
        ((loc == "center") || (loc == "upper center") || (loc == "lower center")) ifTrue { lx = x - (w / 2) }
        (loc contains("lower")) ifTrue { ly = y - h }
        ((loc == "center") || (loc == "center left") || (loc == "center right") || (loc == "right")) ifTrue { ly = y - (h / 2) }
        [lx, ly]
    }

    // The room a legend anchored outside the axes takes beside them, as
    // [left, top, right, bottom] for a plot box about w x h
    _legendRoom(cv, w, h) {
        none = [0, 0, 0, 0]
        ((legendOpts == nil) || ((legendOpts get("bboxToAnchor") ?? legendOpts get("bbox_to_anchor")) == nil)) ifTrue { return none }
        entries = _legendEntries
        (entries size == 0) ifTrue { return none }
        lay = _legendLayout(cv, entries, legendOpts)
        anchor = legendOpts get("bboxToAnchor") ?? legendOpts get("bbox_to_anchor")
        p = _cornerAt(legendOpts get("loc") ?? "upper left", anchor at(0) * w, (1 - anchor at(1)) * h, lay get("w"), lay get("h"))
        gap = lay get("fs") * 0.5
        lx = p at(0)
        ly = p at(1)
        [Math max(0, 0 - lx) + ((lx < 0) ifTrue { gap } ifFalse { 0 }),
         Math max(0, 0 - ly),
         Math max(0, (lx + lay get("w")) - w) + (((lx + lay get("w")) > w) ifTrue { gap } ifFalse { 0 }),
         Math max(0, (ly + lay get("h")) - h)]
    }

    // A legend's size and arrangement: entries in ncol columns (filled
    // down each column in turn), with an optional title
    _legendLayout(cv, entries, o) {
        fs = _pt(o get("fontsize") ?? _rc("legend.fontsize"))
        pad = fs * 0.4
        handle = fs * 2.0
        gap = fs * 0.8
        rowH = fs * 1.5
        colSp = fs * 2.0
        ncol = Math max(1, Math min(o get("ncol") ?? o get("ncols") ?? 1, entries size))
        nrows = (entries size + ncol - 1) / ncol
        widths = (0..(ncol - 1)) map { |c|
            col = entries slice(c * nrows, Math min((c + 1) * nrows, entries size))
            handle + gap + (col reduce(0) { |m, a| Math max(m, cv measure(a get("label") toString, fs)) })
        }
        heading = o get("title")
        inner = widths sum + (colSp * (ncol - 1))
        (heading != nil) ifTrue { inner = Math max(inner, cv measure(heading, fs)) }
        h = (pad * 2) + (nrows * rowH) - (fs * 0.5)
        (heading != nil) ifTrue { h = h + rowH }
        #{entries: entries, fs: fs, pad: pad, handle: handle, gap: gap, rowH: rowH, colSp: colSp,
          ncol: ncol, nrows: nrows, widths: widths, heading: heading, w: (pad * 2) + inner, h: h}
    }

    // Draw a laid-out legend with its top left at lx, ly
    _legendBox(cv, lay, lx, ly, o) {
        fs = lay get("fs")
        pad = lay get("pad")
        w = lay get("w")
        (o get("frameon") != false) ifTrue {
            cv rect(lx, ly, w, lay get("h"), #{fill: "#ffffff", stroke: "#cccccc", width: _pt(0.8), alpha: o get("framealpha") ?? 0.8})
        }
        top = ly + pad + (fs * 0.5)
        heading = lay get("heading")
        (heading != nil) ifTrue {
            cv text(lx + (w / 2), top, heading, #{size: fs, anchor: "middle", valign: "center"})
            top = top + lay get("rowH")
        }
        entries = lay get("entries")
        nrows = lay get("nrows")
        x = lx + pad
        lay get("ncol") times { |c|
            y = top
            (entries slice(c * nrows, Math min((c + 1) * nrows, entries size))) each { |a|
                _legendHandle(cv, a, x, y, fs, lay get("handle"))
                cv text(x + lay get("handle") + lay get("gap"), y, a get("label") toString, #{size: fs, valign: "center"})
                y = y + lay get("rowH")
            }
            x = x + (lay get("widths") at(c)) + lay get("colSp")
        }
    }

    // An artist's legend handle, handle wide, centred on y
    _legendHandle(cv, a, hx, y, fs, handle) {
        k = a get("kind")
        color = PlotColor hex(a get("color") ?? "#000000")
        (k == "line" || k == "hline" || k == "vline" || k == "contour") ifTrue {
            ls = a get("linestyle") ?? "-"
            lw = _pt(a get("linewidth") ?? _rc("lines.linewidth"))
            ((ls != "none") && (ls != "")) ifTrue {
                cv line(hx, y, hx + handle, y, #{stroke: color, width: lw, dash: _dash(ls, lw), alpha: a get("alpha")})
            }
            m = a get("marker")
            ((m != nil) && (m != "none")) ifTrue {
                face = _hexOrNil(a get("markerfacecolor")) ?? color
                _marker(cv, m, hx + (handle / 2), y, _pt(a get("markersize") ?? _rc("lines.markersize")), face, _hexOrNil(a get("markeredgecolor")) ?? face, a get("alpha"))
            }
        }
        (k == "scatter") ifTrue {
            c = a get("color") ?? PlotColor lut(a get("cmap")) at(128)
            s = a get("sizes")
            (s type == "Array") ifTrue { s = Math pow(_rc("lines.markersize"), 2) }
            _marker(cv, a get("marker"), hx + (handle / 2), y, _pt(Math sqrt(s)), c, a get("edgecolor") ?? c, a get("alpha"))
        }
        (k == "boxes") ifTrue {
            cv rect(hx, y - (fs * 0.35), handle, fs * 0.7, #{fill: a get("color"), stroke: a get("box") get("color"), width: _pt(1)})
        }
        (k == "violin") ifTrue {
            fill = (a get("colors") != nil) ifTrue { a get("colors") first } ifFalse { a get("color") }
            cv rect(hx, y - (fs * 0.35), handle, fs * 0.7, #{fill: fill, alpha: a get("alpha")})
        }
        (k == "contourf" || k == "span") ifTrue {
            cv rect(hx, y - (fs * 0.35), handle, fs * 0.7, #{fill: a get("color"), alpha: a get("alpha"),
                                                             stroke: a get("edgecolor"), width: _pt(1)})
        }
        (k == "bars" || k == "fill" || k == "wedge") ifTrue {
            fill = (a get("colors") != nil) ifTrue { a get("colors") first } ifFalse { a get("color") }
            cv rect(hx, y - (fs * 0.35), handle, fs * 0.7, #{fill: fill, alpha: a get("alpha"), stroke: a get("edgecolor"), width: _pt(1)})
        }
    }

    _legendPos(loc, w, h, inset) {
        b = plotBox
        left = b at(0) + inset
        right = (b at(0) + b at(2)) - inset - w
        cx = b at(0) + ((b at(2) - w) / 2)
        top = b at(1) + inset
        bottom = (b at(1) + b at(3)) - inset - h
        cy = b at(1) + ((b at(3) - h) / 2)
        (loc == "upper right") ifTrue { return [right, top] }
        (loc == "upper left") ifTrue { return [left, top] }
        (loc == "lower left") ifTrue { return [left, bottom] }
        (loc == "lower right") ifTrue { return [right, bottom] }
        (loc == "right" || loc == "center right") ifTrue { return [right, cy] }
        (loc == "center left") ifTrue { return [left, cy] }
        (loc == "lower center") ifTrue { return [cx, bottom] }
        (loc == "upper center") ifTrue { return [cx, top] }
        (loc == "center") ifTrue { return [cx, cy] }
        raise("Plot: unknown legend loc: " + loc toString)
    }

    // The legend corner covering the fewest data points (matplotlib's "best")
    _bestLoc(w, h, inset) {
        pts = []
        _group each { |ax| ax _legendPoints(pts) }
        best = "upper right"
        fewest = nil
        ["upper right", "upper left", "lower left", "lower right", "right", "center left",
         "lower center", "upper center", "center"] each { |loc|
            p = _legendPos(loc, w, h, inset)
            n = 0
            pts each { |q|
                ((q at(0) >= p at(0)) && (q at(0) <= p at(0) + w) && (q at(1) >= p at(1)) && (q at(1) <= p at(1) + h)) ifTrue { n = n + 1 }
            }
            ((fewest == nil) || (n < fewest)) ifTrue { fewest = n; best = loc }
        }
        best
    }

    // This axes' data as pixel points (sampled), for the legend to avoid
    _legendPoints(pts) {
        artists each { |a|
            k = a get("kind")
            (k == "line" || k == "scatter" || k == "fill") ifTrue {
                xs = a get("xs")
                ys = (k == "fill") ifTrue { a get("y1") } ifFalse { a get("ys") }
                stride = Math max(1, xs size / 500)
                i = 0
                { i < xs size } whileTrue {
                    (_okX(xs at(i)) && _okY(ys at(i))) ifTrue { pts append([_px(xs at(i)), _py(ys at(i))]) }
                    i = i + stride
                }
            }
            (k == "bars") ifTrue {
                a get("pos") size times { |i|
                    span = _barSpan(a, i)
                    top = (_nth(a get("bottom"), i) ?? 0) + a get("lengths") at(i)
                    (a get("orient") == "h") ifTrue {
                        pts append([_px(top), _py(span at(0))]); pts append([_px(top), _py(span at(1))])
                    } ifFalse {
                        pts append([_px(span at(0)), _py(top)]); pts append([_px(span at(1)), _py(top)])
                        pts append([_px((span at(0) + span at(1)) / 2), _py(top)])
                    }
                }
            }
        }
        artists each { |a|
            k = a get("kind")
            (k == "boxes" || k == "violin") ifTrue {
                a get("positions") size times { |i|
                    pos = a get("positions") at(i)
                    vals = (k == "boxes") ifTrue {
                        st = a get("stats") at(i)
                        (st get("n") > 0) ifTrue { [st get("whislo"), st get("q1"), st get("med"), st get("q3"), st get("whishi")] + st get("fliers") } ifFalse { [] }
                    } ifFalse {
                        b = a get("bodies") at(i)
                        b get("coords")
                    }
                    vals each { |v| pts append(_boxPoint(a get("vert"), pos, v)) }
                }
            }
        }
        pts
    }

    _colorbarWidth(cv, h) {
        fs = _pt(_rc("ytick.labelsize"))
        a = colorbarArtist
        t = PlotTicks locate(a get("vmin"), a get("vmax"), Math max(2, Math min(9, (h / (fs * 2.5)) toInt)))
        self cbt = #{values: t get("values"), labels: PlotTicks labels(t get("values"), t get("decimals"))}
        // a log hexbin's colour is log10 of the counts: ticks at powers of ten
        (a get("log") == true) ifTrue {
            t = PlotTicks locateLog(a get("vmin"), a get("vmax"), Math max(2, Math min(9, (h / (fs * 2.5)) toInt)))
            self cbt = #{values: t get("values"), labels: t get("labels")}
        }
        // a contour's colour bar is ticked at its levels, when they fit
        lv = a get("levels")
        ((lv != nil) && (lv size >= 2) && (lv size <= Math max(2, (h / (fs * 1.6)) toInt))) ifTrue {
            self cbt = #{values: lv, labels: lv map { |v| PlotTicks short(v) }}
        }
        widest = cbt get("labels") reduce(0) { |m, s| Math max(m, _tickWidth(cv, s, fs)) }
        extra = (colorbarLabel != nil) ifTrue { (_pt(_rc("axes.labelsize")) * 1.2) + _pt(4) } ifFalse { 0 }
        _pt(14) + _pt(10) + _pt(3.5) + _pt(3.5) + widest + extra
    }

    _drawColorbar(cv) {
        b = plotBox
        a = colorbarArtist
        x = b at(0) + b at(2) + _pt(14)
        y = b at(1)
        w = _pt(10)
        h = b at(3)
        (a get("kind") == "contourf") ifTrue {
            // one block per band, in the band's colour
            lv = a get("levels")
            sp = (lv last - lv first) toFloat
            (lv size - 1) times { |k|
                y0 = (y + h) - (((lv at(k + 1) - lv first) / sp) * h)
                y1 = (y + h) - (((lv at(k) - lv first) / sp) * h)
                cv rect(x, y0, w, y1 - y0, #{fill: a get("colors") at(k), stroke: a get("colors") at(k), width: 0.75})
            }
        } ifFalse {
            // 256 steps of the colormap, highest at the top
            cv image(x, y, w, h, Image colormap(1, 256, (0..255) map { |i| 255 - i }, PlotColor palette(a get("cmap")), 0, 255))
        }
        lw = _pt(_rc("axes.linewidth"))
        cv rect(x, y, w, h, #{stroke: "#000000", width: lw})
        lo = a get("vmin")
        span = (a get("vmax") - lo) toFloat
        (span == 0) ifTrue { span = 1.0 }
        fs = _pt(_rc("ytick.labelsize"))
        tl = _pt(3.5)
        vals = cbt get("values")
        labs = cbt get("labels")
        vals size times { |i|
            ty = (y + h) - (((vals at(i) - lo) / span) * h)
            cv line(x + w, ty, x + w + tl, ty, #{stroke: "#000000", width: lw})
            _tickText(cv, x + w + tl + _pt(3.5), ty, labs at(i), #{size: fs, anchor: "start", valign: "center"})
        }
        (colorbarLabel != nil) ifTrue {
            widest = labs reduce(0) { |m, s| Math max(m, _tickWidth(cv, s, fs)) }
            cv text(x + w + tl + _pt(3.5) + widest + _pt(4), y + (h / 2), colorbarLabel,
                    #{size: _pt(_rc("axes.labelsize")), anchor: "middle", valign: "top", rotate: 90})
        }
    }

    // Draw one marker centred at x, y (pixels), size = its width in pixels
    _marker(cv, kind, x, y, size, face, edge, alpha) {
        r = size / 2
        filled = #{fill: face, stroke: edge, width: _pt(1), alpha: alpha}
        stroked = #{stroke: edge, width: _pt(1), alpha: alpha}
        (kind == "o") ifTrue { return cv circle(x, y, r, filled) }
        (kind == ".") ifTrue { return cv circle(x, y, r * 0.5, filled) }
        (kind == ",") ifTrue { return cv rect(x - 0.5, y - 0.5, 1, 1, #{fill: face, alpha: alpha}) }
        (kind == "s") ifTrue { return cv rect(x - (r * 0.85), y - (r * 0.85), r * 1.7, r * 1.7, filled) }
        (kind == "+") ifTrue {
            cv line(x - r, y, x + r, y, stroked)
            return cv line(x, y - r, x, y + r, stroked)
        }
        (kind == "x") ifTrue {
            d = r * 0.75
            cv line(x - d, y - d, x + d, y + d, stroked)
            return cv line(x - d, y + d, x + d, y - d, stroked)
        }
        (kind == "|") ifTrue { return cv line(x, y - r, x, y + r, stroked) }
        (kind == "_") ifTrue { return cv line(x - r, y, x + r, y, stroked) }
        (kind == "D") ifTrue { return cv polygon([x, x + r, x, x - r], [y - r, y, y + r, y], filled) }
        (kind == "d") ifTrue { return cv polygon([x, x + (r * 0.6), x, x - (r * 0.6)], [y - r, y, y + r, y], filled) }
        (kind == "^") ifTrue { return _regular(cv, x, y, r, 3, 90, filled) }
        (kind == "v") ifTrue { return _regular(cv, x, y, r, 3, 270, filled) }
        (kind == "<") ifTrue { return _regular(cv, x, y, r, 3, 180, filled) }
        (kind == ">") ifTrue { return _regular(cv, x, y, r, 3, 0, filled) }
        (kind == "p") ifTrue { return _regular(cv, x, y, r, 5, 90, filled) }
        (kind == "h") ifTrue { return _regular(cv, x, y, r, 6, 90, filled) }
        (kind == "*") ifTrue {
            px = []
            py = []
            10 times { |i|
                rr = ((i % 2) == 0) ifTrue { r * 1.1 } ifFalse { r * 0.45 }
                ang = ((90 + (i * 36)) * Math pi) / 180
                px append(x + (rr * Math cos(ang))); py append(y - (rr * Math sin(ang)))
            }
            return cv polygon(px, py, filled)
        }
        raise("Plot: unknown marker: " + kind toString)
    }

    _regular(cv, x, y, r, n, start, style) {
        px = []
        py = []
        n times { |i|
            ang = ((start + ((i * 360) / n)) * Math pi) / 180
            px append(x + (r * Math cos(ang))); py append(y - (r * Math sin(ang)))
        }
        cv polygon(px, py, style)
    }

    // ---- scales and ticks -----------------------------------------------

    // The range shown: [x0, x1, y0, y1], from the data with a 5% margin
    // (none for images), or the limits set with xlim / ylim
    _view() {
        v = _ownView
        (xGroup != nil) ifTrue {
            xGroup each { |a| (a != self) ifTrue {
                o = a _ownView
                v = [Math min(v at(0), o at(0)), Math max(v at(1), o at(1)), v at(2), v at(3)]
            } }
        }
        (yGroup != nil) ifTrue {
            yGroup each { |a| (a != self) ifTrue {
                o = a _ownView
                v = [v at(0), v at(1), Math min(v at(2), o at(2)), Math max(v at(3), o at(3))]
            } }
        }
        v
    }

    // The range this axes' own data and limits ask for
    _ownView() {
        lim = [nil, nil, nil, nil]
        stickyX = []
        stickyY = []
        tight = [false, false]
        // in view units: log10 of the data on a log axis
        // twins' data counts on the axis they share with this one only
        useX = true
        useY = true
        incX = { |v| (useX && _okX(v)) ifTrue {
            t = _tx(v)
            ((lim at(0) == nil) || (t < lim at(0))) ifTrue { lim setAt(0, t) }
            ((lim at(1) == nil) || (t > lim at(1))) ifTrue { lim setAt(1, t) } } }
        incY = { |v| (useY && _okY(v)) ifTrue {
            t = _ty(v)
            ((lim at(2) == nil) || (t < lim at(2))) ifTrue { lim setAt(2, t) }
            ((lim at(3) == nil) || (t > lim at(3))) ifTrue { lim setAt(3, t) } } }
        scan = { |a|
            k = a get("kind")
            (useX && (a get("stickyX") != nil)) ifTrue { stickyX = stickyX + a get("stickyX") }
            (useY && (a get("stickyY") != nil)) ifTrue { stickyY = stickyY + a get("stickyY") }
            (k == "line" || k == "scatter") ifTrue {
                a get("xs") each(incX)
                a get("ys") each(incY)
            }
            (k == "errbar") ifTrue {
                a get("segs") each { |s| incX value(s at(0)); incX value(s at(2)); incY value(s at(1)); incY value(s at(3)) }
            }
            (k == "wedge") ifTrue {
                incX value(a get("cx") - a get("r")); incX value(a get("cx") + a get("r"))
                incY value(a get("cy") - a get("r")); incY value(a get("cy") + a get("r"))
            }
            (k == "fill") ifTrue {
                a get("xs") each(incX)
                a get("y1") each(incY)
                a get("y2") each(incY)
            }
            (k == "hline") ifTrue { incY value(a get("value")) }
            (k == "vline") ifTrue { incX value(a get("value")) }
            (k == "bars") ifTrue {
                horiz = a get("orient") == "h"
                a get("pos") size times { |i|
                    span = _barSpan(a, i)
                    base = _nth(a get("bottom"), i) ?? 0
                    horiz ifTrue {
                        incY value(span at(0)); incY value(span at(1))
                        incX value(base); incX value(base + a get("lengths") at(i))
                        useX ifTrue { stickyX append(base) }
                    } ifFalse {
                        incX value(span at(0)); incX value(span at(1))
                        incY value(base); incY value(base + a get("lengths") at(i))
                        useY ifTrue { stickyY append(base) }
                    }
                }
            }
            (k == "span") ifTrue {
                inc = (a get("orient") == "h") ifTrue { incY } ifFalse { incX }
                inc value(a get("lo")); inc value(a get("hi"))
            }
            (k == "hexbin") ifTrue {
                e = a get("extent")
                incX value(e at(0)); incX value(e at(1))
                incY value(e at(2) - (a get("sy") / 3)); incY value(e at(3) + (a get("sy") / 3))
            }
            (k == "mesh") ifTrue {
                incX value(a get("xedges") first); incX value(a get("xedges") last)
                incY value(a get("yedges") first); incY value(a get("yedges") last)
                useX ifTrue { tight setAt(0, true) }
                useY ifTrue { tight setAt(1, true) }
            }
            (k == "contour" || k == "contourf") ifTrue {
                e = a get("extent")
                incX value(e at(0)); incX value(e at(1))
                incY value(e at(2)); incY value(e at(3))
                useX ifTrue { tight setAt(0, true) }
                useY ifTrue { tight setAt(1, true) }
            }
            (k == "boxes" || k == "violin") ifTrue {
                incPos = a get("vert") ifTrue { incX } ifFalse { incY }
                incVal = a get("vert") ifTrue { incY } ifFalse { incX }
                a get("positions") size times { |i|
                    half = _nth(a get("widths"), i) / 2.0
                    pos = a get("positions") at(i)
                    incPos value(pos - half); incPos value(pos + half)
                    (k == "boxes") ifTrue {
                        st = a get("stats") at(i)
                        (st get("n") > 0) ifTrue {
                            incVal value(st get("whislo")); incVal value(st get("whishi"))
                            a get("showfliers") ifTrue { st get("fliers") each(incVal) }
                            a get("showmeans") ifTrue { incVal value(st get("mean")) }
                        }
                    } ifFalse {
                        b = a get("bodies") at(i)
                        incVal value(b get("min")); incVal value(b get("max"))
                    }
                }
            }
            (k == "image") ifTrue {
                e = a get("extent")
                incX value(e at(0)); incX value(e at(1))
                incY value(e at(2)); incY value(e at(3))
                useX ifTrue { tight setAt(0, true) }
                useY ifTrue { tight setAt(1, true) }
            }
        }
        artists each(scan)
        twins each { |t|
            useX = t twinKind == "x"
            useY = t twinKind == "y"
            t artists each(scan)
        }
        stickyX = (stickyX filter { |v| _okX(v) }) map { |v| _tx(v) }
        stickyY = (stickyY filter { |v| _okY(v) }) map { |v| _ty(v) }
        xs = _expand(lim at(0), lim at(1), tight at(0), stickyX, _rc("axes.xmargin"))
        ys = _expand(lim at(2), lim at(3), tight at(1), stickyY, _rc("axes.ymargin"))
        (xlimits != nil) ifTrue {
            (_okX(xlimits at(0))) ifTrue { xs setAt(0, _tx(xlimits at(0))) }
            (_okX(xlimits at(1))) ifTrue { xs setAt(1, _tx(xlimits at(1))) }
        }
        (ylimits != nil) ifTrue {
            (_okY(ylimits at(0))) ifTrue { ys setAt(0, _ty(ylimits at(0))) }
            (_okY(ylimits at(1))) ifTrue { ys setAt(1, _ty(ylimits at(1))) }
        }
        (xs at(0) == xs at(1)) ifTrue { xs setAt(1, xs at(0) + 1) }
        (ys at(0) == ys at(1)) ifTrue { ys setAt(1, ys at(0) + 1) }
        [xs at(0) toFloat, xs at(1) toFloat, ys at(0) toFloat, ys at(1) toFloat]
    }

    _expand(lo, hi, tight, sticky, margin) {
        (lo == nil) ifTrue { return [0.0, 1.0] }
        lo = lo toFloat
        hi = hi toFloat
        (lo == hi) ifTrue {
            d = (lo == 0) ifTrue { 0.5 } ifFalse { lo abs * 0.05 }
            return [lo - d, hi + d]
        }
        tight ifTrue { return [lo, hi] }
        m = (hi - lo) * margin
        a = lo - m
        b = hi + m
        sticky each { |s|
            ((a < s) && (s <= lo)) ifTrue { a = s }
            ((b > s) && (s >= hi)) ifTrue { b = s }
        }
        [a, b]
    }

    _computeTicks(cv, w, h) {
        v = view
        da = _dateAxes
        dates = da xDates && (xtickSpec == nil) && (twinKind != "y")
        self xt = dates ifTrue { _dateTicks(cv, v at(0), v at(1), w, da xOrigin) } ifFalse {
            _axisTicks(cv, xtickSpec, v at(0), v at(1), w, true, integerX, xLog)
        }
        self yt = _axisTicks(cv, ytickSpec, v at(2), v at(3), h, false, integerY, yLog)
        hideXTicks ifTrue { xt set("labels", xt get("labels") map { |s| "" }); xt set("offset", "") }
        hideYTicks ifTrue { yt set("labels", yt get("labels") map { |s| "" }) }
    }

    // Date ticks, as many as fit side by side: #{values:, labels:, rotation:, offset:}
    _dateTicks(cv, lo, hi, length, origin) {
        fs = _pt(_rc("xtick.labelsize"))
        n = ((length / (fs * 4)) toInt) clamp(1, 9)
        t = nil
        tries = 0
        { tries < 9 } whileTrue {
            t = PlotDates ticks(lo, hi, origin, n)
            widest = t get("labels") reduce(0) { |m, s| Math max(m, cv measure(s, fs)) }
            (((widest + fs) * t get("labels") size) <= (length * 1.1) || (n <= 1)) ifTrue { break }
            n = n - 1
            tries = tries + 1
        }
        #{values: t get("values"), labels: t get("labels"), rotation: 0, offset: t get("offset")}
    }

    // The axes whose x axis the dates belong to (a twinx's host)
    _dateAxes() {
        (twinKind == "x") ifTrue { return host _dateAxes }
        (xGroup != nil) ifTrue { return xGroup first }
        self
    }

    // Values for the x axis: dates (Date objects, or text such as
    // "2024-03-15") become days since the axes' first date; numbers stay
    _dx(values) {
        (values == nil) ifTrue { return nil }
        ((values find { |v| (v type == "Date") || (v type == "String") }) == nil) ifTrue { return values }
        values map { |v| _dx1(v) }
    }

    _dx1(v) {
        ((v type != "Date") && (v type != "String")) ifTrue { return v }
        da = _dateAxes
        p = PlotDates parts(v)
        (da xOrigin == nil) ifTrue { da xOrigin = p at(0) }
        da xDates = true
        (p at(0) - da xOrigin) + (p at(1) / 86400.0)
    }

    // Ticks in view units (lo and hi are too)
    _axisTicks(cv, spec, lo, hi, length, isX, integer, log) {
        a = Math min(lo, hi)
        b = Math max(lo, hi)
        tol = (b - a) * 0.0001
        rot = 0
        (spec != nil) ifTrue { rot = spec get("rotation") ?? 0 }
        ((spec != nil) && (spec get("values") != nil)) ifTrue {
            vals = spec get("values")
            labs = spec get("labels") ?? (vals map { |x| PlotTicks short(x) })
            keepV = []
            keepL = []
            vals size times { |i|
                x = vals at(i)
                ((log not) || (_ok(x) && (x > 0))) ifTrue {
                    t = log ifTrue { PlotTicks log10(x) } ifFalse { x }
                    ((t >= a - tol) && (t <= b + tol)) ifTrue { keepV append(t); keepL append((labs at(i) ?? "") toString) }
                }
            }
            return #{values: keepV, labels: keepL, rotation: rot}
        }
        fs = _pt(_rc("xtick.labelsize"))
        n = isX ifTrue { (length / (fs * 3.2)) toInt } ifFalse { (length / (fs * 2.2)) toInt }
        n = n clamp(1, 9)
        log ifTrue {
            t = PlotTicks locateLog(a, b, n)
            t set("rotation", rot)
            return t
        }
        t = nil
        labs = nil
        tries = 0
        { tries < 9 } whileTrue {
            t = PlotTicks locate(a, b, n, integer)
            labs = PlotTicks labels(t get("values"), t get("decimals"))
            fits = true
            (isX && (rot == 0)) ifTrue {
                widest = labs reduce(0) { |m, s| Math max(m, _tickWidth(cv, s, fs)) }
                fits = ((widest + fs) * labs size) <= (length * 1.1)
            }
            (fits || (n <= 1)) ifTrue { break }
            n = n - 1
            tries = tries + 1
        }
        #{values: t get("values"), labels: labs, rotation: rot}
    }

    // Tick labels may be "10^k" (log axes): 10 with k smaller and raised
    _tickWidth(cv, s, fs) {
        i = s indexOf("^")
        (i < 0) ifTrue { return cv measure(s, fs) }
        (cv hasMethod("superscript")) ifTrue { return cv measure(s slice(0, i) + cv superscript(s slice(i + 1, s length)), fs) }
        cv measure(s slice(0, i), fs) + cv measure(s slice(i + 1, s length), fs * 0.7)
    }

    _tickText(cv, x, y, s, opts) {
        i = s indexOf("^")
        (i < 0) ifTrue { return cv text(x, y, s, opts) }
        (cv hasMethod("superscript")) ifTrue { return cv text(x, y, s slice(0, i) + cv superscript(s slice(i + 1, s length)), opts) }
        fs = opts get("size")
        base = s slice(0, i)
        sup = s slice(i + 1, s length)
        w = _tickWidth(cv, s, fs)
        anchor = opts get("anchor")
        left = (anchor == "middle") ifTrue { x - (w / 2) } ifFalse { (anchor == "end") ifTrue { x - w } ifFalse { x } }
        valign = opts get("valign")
        // raised exponents need room above: drop top-aligned labels a little
        y0 = (valign == "top") ifTrue { y + (fs * 0.3) } ifFalse { y }
        cv text(left, y0, base, #{size: fs, anchor: "start", valign: valign})
        cv text(left + cv measure(base, fs), y0 - (fs * 0.4), sup, #{size: fs * 0.7, anchor: "start", valign: valign})
    }

    _xLabelHeight(cv, fs) {
        rot = xt get("rotation")
        (rot == 0) ifTrue { return xLog ifTrue { fs * 1.3 } ifFalse { fs } }
        widest = xt get("labels") reduce(0) { |m, s| Math max(m, cv measure(s, fs)) }
        ang = (rot abs * Math pi) / 180
        (widest * Math sin(ang)) + (fs * Math cos(ang))
    }

    _titleSize() { _pt((titleOpts ?? #{}) get("fontsize") ?? _rc("axes.titlesize")) }

    // ---- helpers --------------------------------------------------------

    _line(xs, ys, fmt, opts) {
        xs = _dx(xs)
        (xs == nil) ifTrue { xs = (0..(ys size - 1)) toArray }
        (xs size != ys size) ifTrue { raise("Plot: plot: x and y must be the same length (" + xs size toString + " and " + ys size toString + ")") }
        f = _parseFmt(fmt)
        marker = opts get("marker") ?? f get("marker")
        ls = opts get("linestyle") ?? opts get("ls") ?? f get("linestyle")
        (ls == nil) ifTrue { ls = (f get("marker") != nil) ifTrue { "none" } ifFalse { "-" } }
        color = opts get("color") ?? opts get("c") ?? f get("color")
        (color == nil) ifTrue { color = _nextCycle }
        art = #{kind: "line", xs: xs, ys: ys, color: PlotColor hex(color),
                linewidth: opts get("linewidth") ?? opts get("lw") ?? _rc("lines.linewidth"),
                linestyle: ls, marker: marker, markersize: opts get("markersize") ?? opts get("ms"),
                markerfacecolor: opts get("markerfacecolor") ?? opts get("mfc"),
                markeredgecolor: opts get("markeredgecolor") ?? opts get("mec"),
                label: opts get("label"), alpha: opts get("alpha")}
        artists append(art)
        art
    }

    _bars(orient, x, length, opts) {
        // Date objects place bars on a date axis; strings name categories
        xs = _seq(x)
        ((orient == "v") && (xs size > 0) && (xs first type == "Date")) ifTrue { xs = _dx(xs) }
        lens = (length type == "Number") ifTrue { xs map { |v| length } } ifFalse { _seq(length) }
        (xs size != lens size) ifTrue { raise("Plot: bar: positions and lengths must be the same length (" + xs size toString + " and " + lens size toString + ")") }
        pos = xs
        ((xs size > 0) && (xs first type == "String")) ifTrue {
            pos = (0..(xs size - 1)) toArray
            spec = #{values: pos, labels: xs, rotation: 0}
            (orient == "h") ifTrue {
                (ytickSpec == nil) ifTrue { self ytickSpec = spec }
                self yInverted = true
            } ifFalse {
                (xtickSpec == nil) ifTrue { self xtickSpec = spec }
            }
        }
        thick = (orient == "h") ifTrue { opts get("height") } ifFalse { opts get("width") }
        base = (orient == "h") ifTrue { opts get("left") } ifFalse { opts get("bottom") }
        c = opts get("color")
        art = #{kind: "bars", orient: orient, pos: pos, lengths: lens, width: thick ?? 0.8,
                bottom: base ?? 0, align: opts get("align") ?? "center",
                edgecolor: _hexOrNil(opts get("edgecolor")), linewidth: opts get("linewidth"),
                label: opts get("label"), alpha: opts get("alpha")}
        (c type == "Array") ifTrue {
            art set("colors", c map { |s| PlotColor hex(s) })
            art set("color", art get("colors") first)
        } ifFalse {
            art set("color", PlotColor hex(c ?? _nextCycle))
        }
        artists append(art)
        art
    }

    // [start, end] of bar i along its position axis
    _barSpan(art, i) {
        p = art get("pos") at(i)
        w = _nth(art get("width"), i) ?? 0.8
        (art get("align") == "edge") ifTrue { [p, p + w] } ifFalse { [p - (w / 2.0), p + (w / 2.0)] }
    }

    _refLine(kind, v, opts) {
        art = #{kind: kind, value: v, color: PlotColor hex(opts get("color") ?? "C0"),
                linewidth: opts get("linewidth") ?? opts get("lw") ?? _rc("lines.linewidth"),
                linestyle: opts get("linestyle") ?? opts get("ls") ?? "-", label: opts get("label"),
                alpha: opts get("alpha")}
        artists append(art)
        art
    }

    _tickSpec(values, labels, opts) {
        (labels type == "Dict") ifTrue { opts = labels; labels = nil }
        (values type == "Dict") ifTrue { opts = values; values = nil }
        spec = #{values: (values == nil) ifTrue { nil } ifFalse { _seq(values) },
                 labels: (labels == nil) ifTrue { nil } ifFalse { _seq(labels) map { |s| s toString } },
                 rotation: (opts == nil) ifTrue { 0 } ifFalse { opts get("rotation") ?? 0 }}
        spec
    }

    _setRange(art, values, opts) {
        nums = values filter { |v| _ok(v) }
        lo = opts get("vmin") ?? ((nums size > 0) ifTrue { nums min } ifFalse { 0 })
        hi = opts get("vmax") ?? ((nums size > 0) ifTrue { nums max } ifFalse { 1 })
        art set("vmin", lo)
        art set("vmax", hi)
    }

    // Rows of values for imshow, from rows, a flat Array or an Image
    _grid(data, shape) {
        (data hasMethod("floats") && data hasMethod("channels")) ifTrue {
            w = data width
            ch = data channels
            fl = data floats
            rows = []
            data height times { |r|
                row = []
                w times { |c|
                    i = ((r * w) + c) * ch
                    (ch >= 3) ifTrue { row append([fl at(i), fl at(i + 1), fl at(i + 2)]) } ifFalse { row append(fl at(i)) }
                }
                rows append(row)
            }
            return rows
        }
        d = _seq(data)
        (d size == 0) ifTrue { raise("Plot: imshow needs data") }
        (d first type == "Array") ifTrue { return d }
        nr = 0
        nc = 0
        (shape != nil) ifTrue {
            nr = shape at(0)
            nc = shape at(1)
        } ifFalse {
            side = Math round(Math sqrt(d size))
            ((side * side) != d size) ifTrue { raise("Plot: imshow: give a flat Array its shape, #{shape: [rows, cols]}") }
            nr = side
            nc = side
        }
        ((nr * nc) != d size) ifTrue { raise("Plot: imshow: shape " + nr toString + " x " + nc toString + " needs " + (nr * nc) toString + " values, not " + d size toString) }
        (0..(nr - 1)) map { |r| d slice(r * nc, (r + 1) * nc) }
    }

    _parseFmt(fmt) {
        res = Dict clone
        (fmt == nil) ifTrue { return res }
        i = 0
        { i < fmt length } whileTrue {
            two = fmt slice(i, i + 2)
            ch = fmt at(i)
            step = 1
            (two == "--" || two == "-.") ifTrue {
                res set("linestyle", two)
                step = 2
            } ifFalse {
                // "C0".."C9": the colour cycle's colours, as matplotlib's
                ((ch == "C") && (i + 1 < fmt length) && ("0123456789" contains(fmt at(i + 1)))) ifTrue {
                    res set("color", two)
                    step = 2
                } ifFalse {
                ("bgrcmykw" contains(ch)) ifTrue { res set("color", ch) } ifFalse {
                    (".,o^v<>sDdph*+x|_" contains(ch)) ifTrue { res set("marker", ch) } ifFalse {
                        (ch == "-" || ch == ":") ifTrue { res set("linestyle", ch) } ifFalse {
                            raise("Plot: can't read format string \"" + fmt + "\" (colour b g r c m y k w or C0 to C9, marker . o s ^ v < > D d p h * + x, line - -- -. :)")
                        }
                    }
                }
                }
            }
            i = i + step
        }
        res
    }

    _dash(ls, lw) {
        ((ls == nil) || (ls == "-") || (ls == "solid")) ifTrue { return nil }
        ((ls == "--") || (ls == "dashed")) ifTrue { return [3.7 * lw, 1.6 * lw] }
        ((ls == ":") || (ls == "dotted")) ifTrue { return [lw, 1.65 * lw] }
        ((ls == "-.") || (ls == "dashdot")) ifTrue { return [6.4 * lw, 1.6 * lw, lw, 1.6 * lw] }
        (ls type == "Array") ifTrue { return ls map { |d| d * lw } }
        raise("Plot: unknown linestyle: " + ls toString + " (use \"-\", \"--\", \":\", \"-.\" or \"none\")")
    }

    _split(list) {
        items = list filter { |v| v != nil }
        opts = #{}
        ((items size > 0) && (items last type == "Dict")) ifTrue { opts = items pop }
        fmt = nil
        ((items size > 0) && (items last type == "String")) ifTrue { fmt = items pop }
        [items, fmt, opts]
    }

    // Data for boxplot / violinplot as [sets, names]: one Array of numbers
    // is one set; an Array of Arrays is several; a Dict's keys name its sets
    _datasets(data, who) {
        (data type == "Dict") ifTrue {
            sets = []
            names = []
            data each { |k, v| names append(k toString); sets append(_seq(v)) }
            (sets size == 0) ifTrue { raise("Plot: " + who + " needs data") }
            return [sets, names]
        }
        d = _seq(data)
        ((d == nil) || (d size == 0)) ifTrue { raise("Plot: " + who + " needs data: values, or a list of value lists") }
        ((d first type == "Number") || (d first == nil)) ifTrue { return [[d], nil] }
        [d map { |s| _seq(s) }, nil]
    }

    // orientation: "vertical" / "horizontal", or vert: false
    _vertical(opts) {
        o = opts get("orientation")
        (o == nil) ifTrue { return opts get("vert") ?? true }
        ((o != "vertical") && (o != "horizontal")) ifTrue { raise("Plot: orientation must be \"vertical\" or \"horizontal\"") }
        o == "vertical"
    }

    _positions(opts, n, who) {
        p = _seq(opts get("positions")) ?? (1..n) toArray
        (p size != n) ifTrue { raise("Plot: " + who + ": " + n toString + " data sets but " + p size toString + " positions") }
        p
    }

    // Ticks naming the boxes or violins, unless ticks were chosen already
    _categoryTicks(vert, positions, labels) {
        labs = (labels == nil) ifTrue { positions map { |p| PlotTicks short(p) } } ifFalse { _seq(labels) map { |s| s toString } }
        spec = #{values: positions, labels: labs, rotation: 0}
        vert ifTrue { (xtickSpec == nil) ifTrue { self xtickSpec = spec } } ifFalse { (ytickSpec == nil) ifTrue { self ytickSpec = spec } }
    }

    // A line style from matplotlib-style props: color, linewidth (lw), linestyle (ls), alpha
    _lineProps(p, color, lw, edge) {
        p = p ?? #{}
        #{color: PlotColor hex(edge ?? p get("color") ?? color), linewidth: p get("linewidth") ?? p get("lw") ?? lw,
          linestyle: p get("linestyle") ?? p get("ls") ?? "-", alpha: p get("alpha")}
    }

    // A marker style from props: marker, markerfacecolor (mfc; "none" for
    // hollow), markeredgecolor (mec), markersize (ms), alpha
    _markerProps(p, marker, face, edge) {
        p = p ?? #{}
        f = p get("markerfacecolor") ?? p get("mfc") ?? face
        #{marker: p get("marker") ?? marker, face: _hexOrNil(f),
          edge: _hexOrNil(p get("markeredgecolor") ?? p get("mec") ?? p get("color") ?? edge),
          size: p get("markersize") ?? p get("ms") ?? _rc("lines.markersize"), alpha: p get("alpha")}
    }

    _strokeOf(props) {
        lw = _pt(props get("linewidth"))
        #{stroke: props get("color"), width: lw, dash: _dash(props get("linestyle"), lw), alpha: props get("alpha"), cap: "butt"}
    }

    _seq(v) {
        (v == nil) ifTrue { return nil }
        t = v type
        (t == "Array") ifTrue { return v }
        (t == "Range") ifTrue { return v toArray }
        (t == "Number") ifTrue { return [v] }
        (v hasMethod("toArray")) ifTrue { return v toArray }
        raise("Plot: expected an Array of numbers, got " + t)
    }

    // Error sizes as [lows, highs]: from a number, one per point, or [lows, highs]
    _errs(e, n) {
        (e type == "Number") ifTrue { all = (1..n) map { |i| e }; return [all, all] }
        e = _seq(e)
        ((e size == 2) && (e first type == "Array")) ifTrue { return [_seq(e at(0)), _seq(e at(1))] }
        (e size != n) ifTrue { raise("Plot: errorbar: need one error per point (" + n toString + "), or [lows, highs]") }
        [e, e]
    }

    _nth(v, i) { (v type == "Array") ifTrue { v at(i) } ifFalse { v } }

    _copy(d) {
        out = Dict clone
        d each { |k, v| out set(k, v) }
        out
    }

    _ok(v) { (v != nil) && (v type == "Number") && (v == v) }

    // usable on this axis: a number, and above zero on a log axis
    _okX(v) { _ok(v) && (xLog not || (v > 0)) }
    _okY(v) { _ok(v) && (yLog not || (v > 0)) }

    // data to view units, and back
    _tx(v) { xLog ifTrue { PlotTicks log10(v) } ifFalse { v } }
    _ty(v) { yLog ifTrue { PlotTicks log10(v) } ifFalse { v } }
    _untx(t, log) { log ifTrue { Math pow(10, t) toFloat } ifFalse { t } }

    _hexOrNil(c) { ((c == nil) || (c == "none")) ifTrue { nil } ifFalse { PlotColor hex(c) } }

    _nextCycle() {
        (host != nil) ifTrue { return host _nextCycle }
        c = PlotColor cycleColor(nextColor)
        self nextColor = nextColor + 1
        c
    }

    _bin(edges, v) {
        lo = 0
        hi = edges size - 2
        { lo < hi } whileTrue {
            mid = (lo + hi + 1) / 2
            (edges at(mid) <= v) ifTrue { lo = mid } ifFalse { hi = mid - 1 }
        }
        lo
    }

    _pt(v) { (v * figure dpi) / 72.0 }

    _rc(key) { Plot rc get(key) }
}
