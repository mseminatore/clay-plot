// PlotTicks -- where ticks go on an axis and how their labels read
//
//   PlotTicks locate(0, 0.83, 8)   // #{values: [0, 0.1, ... 0.8], step: 0.1, decimals: 1}
//   PlotTicks labels([0, 0.5, 1], 1)   // ["0.0", "0.5", "1.0"]
//   PlotTicks format(-2.5, 2)          // "−2.50" (with a real minus sign, as matplotlib)
//
// Ticks fall on multiples of 1, 2, 2.5 or 5 times a power of ten, the steps
// matplotlib's MaxNLocator uses, choosing the smallest step that gives at most
// maxTicks intervals across the range.
//
// Clay's floats are 32-bit, so values are worked out as an integer count of
// steps and formatted by rounding to a fixed number of decimals, never by
// printing a float as it is.

PlotTicks = Object clone {
    minus = "\xe2\x88\x92"

    // e such that 10^e <= |x| < 10^(e+1); 0 for 0
    exponent(x) {
        v = x abs toFloat
        (v == 0) ifTrue { return 0 }
        e = 0
        { v >= 9.99999 } whileTrue { v = v / 10; e = e + 1 }
        { v < 0.999999 } whileTrue { v = v * 10; e = e - 1 }
        e
    }

    // 10^e as a float (e an integer, either sign)
    pow10(e) { Math pow(10, e) toFloat }

    // Ticks inside [lo, hi]: #{values:, step:, decimals:}. integer: true
    // keeps the step a whole number (for pixel and category axes).
    locate(lo, hi, maxTicks = 8, integer = false) {
        (hi < lo) ifTrue { t = lo; lo = hi; hi = t }
        span = (hi - lo) toFloat
        (span <= 0) ifTrue { span = (lo == 0) ifTrue { 1.0 } ifFalse { lo abs } }
        n = Math max(maxTicks, 1)
        raw = span / n
        e = exponent(raw)
        mag = pow10(e)
        f = raw / mag
        mult = [1, 2, 2.5, 5, 10] find { |m| m >= (f - 0.00001) }
        (mult == 10) ifTrue { mult = 1; e = e + 1; mag = pow10(e) }
        (integer && (e < 0)) ifTrue { mult = 1; e = 0; mag = 1.0 }
        (integer && (mult == 2.5)) ifTrue { mult = 5 }
        step = mult * mag
        k0 = Math ceil((lo / step) - 0.0001) toInt
        k1 = Math floor((hi / step) + 0.0001) toInt
        values = []
        k = k0
        { k <= k1 } whileTrue {
            values append(k * step)
            k = k + 1
        }
        // 2.5 x 10^e needs one decimal more than 10^e does (25 none, 2.5 one)
        decimals = (mult == 2.5) ifTrue { Math max(0, 1 - e) } ifFalse { Math max(0, 0 - e) }
        #{values: values, step: step, decimals: decimals}
    }

    // Labels for tick values. Very large or very small magnitudes get an
    // exponent suffix ("2.5e6").
    labels(values, decimals) {
        (values size == 0) ifTrue { return [] }
        biggest = values reduce(0) { |m, v| Math max(m, v abs) }
        big = exponent(biggest)
        (biggest > 0 && (big >= 6 || big <= -5)) ifTrue {
            scale = pow10(big)
            step = (values size > 1) ifTrue { (values at(1) - values at(0)) abs } ifFalse { biggest }
            d = _decimalsFor(step / scale)
            return values map { |v|
                (v == 0) ifTrue { "0" } ifFalse { format(v / scale, d) + "e" + big toString }
            }
        }
        values map { |v| format(v, decimals) }
    }

    // Decimals needed to show multiples of step exactly (0.25: 2, 5: 0)
    _decimalsFor(step) {
        e = exponent(step)
        m = step / pow10(e)
        ((m - 2.5) abs < 0.01) ifTrue { Math max(0, 1 - e) } ifFalse { Math max(0, 0 - e) }
    }

    // v rounded to d decimals, as text; negative numbers use a real minus sign
    format(v, d = 0) {
        (v == nil) ifTrue { return "" }
        (v != v) ifTrue { return "nan" }
        (d <= 0) ifTrue {
            n = Math round(v)
            (n == 0) ifTrue { return "0" }
            return (n < 0) ifTrue { minus + n abs toString } ifFalse { n toString }
        }
        scale = Math round(pow10(d))
        n = Math round(v * scale)
        neg = n < 0
        n = n abs
        frac = (n % scale) toString padLeft(d, "0")
        text = (n / scale) toString + "." + frac
        (neg && n != 0) ifTrue { minus + text } ifFalse { text }
    }

    // log10 of a positive number (Clay's Math has no logarithm): split off
    // the power of two, then ln(m) = 2 atanh((m - 1) / (m + 1)) for m in
    // [1, 2), whose series converges quickly there
    log10(x) {
        v = x toFloat
        (v <= 0) ifTrue { return nil }
        k = 0
        { v >= 2.0 } whileTrue { v = v / 2; k = k + 1 }
        { v < 1.0 } whileTrue { v = v * 2; k = k - 1 }
        z = (v - 1) / (v + 1)
        z2 = z * z
        term = z
        sum = 0.0
        n = 1
        { n < 24 } whileTrue {
            sum = sum + (term / n)
            term = term * z2
            n = n + 2
        }
        ((k * 0.6931471805599453) + (2 * sum)) / 2.302585092994046
    }

    // Ticks for a log axis whose view is [lo, hi] in powers of ten (log10 of
    // the data): #{values:, labels:, minor:}. Majors fall on decades (every
    // second or more when there are many) and read "10^k", which PlotAxes
    // draws with a raised exponent. Minor ticks go at 2..9 times each decade.
    // With fewer than two decades in view, 1, 2 and 5 times each are labelled.
    locateLog(lo, hi, maxTicks = 8) {
        (hi < lo) ifTrue { t = lo; lo = hi; hi = t }
        k0 = Math ceil(lo - 0.0001) toInt
        k1 = Math floor(hi + 0.0001) toInt
        every = 1
        { (((k1 - k0) / every) + 1) > Math max(maxTicks, 2) } whileTrue { every = every + 1 }
        k = Math ceil(k0 / every toFloat) toInt * every
        values = []
        { k <= k1 } whileTrue { values append(k toFloat); k = k + every }
        labels = values map { |e| _powLabel(Math round(e)) }
        minor = []
        (every == 1) ifTrue {
            d = Math floor(lo) toInt
            { d <= k1 } whileTrue {
                (2..9) each { |m|
                    v = d + log10(m)
                    ((v >= lo - 0.0001) && (v <= hi + 0.0001)) ifTrue { minor append(v) }
                }
                d = d + 1
            }
        }
        (values size < 2) ifTrue {
            values = []
            labels = []
            d = Math floor(lo) toInt
            { d <= k1 } whileTrue {
                [1, 2, 5] each { |m|
                    v = d + log10(m)
                    ((v >= lo - 0.0001) && (v <= hi + 0.0001)) ifTrue {
                        values append(v)
                        labels append(short(m * pow10(d)))
                    }
                }
                d = d + 1
            }
        }
        #{values: values, labels: labels, minor: minor}
    }

    // "10^k": a label drawn as 10 with k raised
    _powLabel(k) { "10^" + ((k < 0) ifTrue { minus + k abs toString } ifFalse { k toString }) }

    // A number in a printf or Python format: "%.1f%%", "%d", "%g", "%s",
    // "{:.1f}", "{:,.0f}", "{:.0%}", "{}". A format with braces is Python's
    // str.format style, where % is plain text. A block is called with v
    // instead.
    printf(fmt, v) {
        (fmt == nil) ifTrue { return short(v) }
        (fmt type == "Block") ifTrue { return (fmt value(v)) toString }
        braces = fmt contains("{")
        out = ""
        i = 0
        n = fmt length
        { i < n } whileTrue {
            ch = fmt at(i)
            ((ch == "%") && braces not) ifTrue {
                (fmt slice(i + 1, i + 2) == "%") ifTrue { out = out + "%"; i = i + 2 } ifFalse {
                    j = i + 1
                    { (j < n) && ("0123456789.-+ #," contains(fmt at(j))) } whileTrue { j = j + 1 }
                    (j >= n) ifTrue { raise("Plot: format \"" + fmt + "\" ends in the middle of a % spec") }
                    out = out + _spec(fmt slice(i + 1, j), fmt at(j), v)
                    i = j + 1
                }
            } ifFalse {
                (ch == "{") ifTrue {
                    j = i + 1
                    { (j < n) && (fmt at(j) != "}") } whileTrue { j = j + 1 }
                    body = fmt slice(i + 1, j)
                    colon = body indexOf(":")
                    spec = (colon < 0) ifTrue { "" } ifFalse { body slice(colon + 1, body length) }
                    last = (spec length > 0) ifTrue { spec at(spec length - 1) } ifFalse { "" }
                    kind = ((last != "") && ("dfgse%" contains(last))) ifTrue { last } ifFalse { "" }
                    flags = (kind == "") ifTrue { spec } ifFalse { spec slice(0, spec length - 1) }
                    out = out + _spec(flags, kind, v)
                    i = j + 1
                } ifFalse {
                    out = out + ch
                    i = i + 1
                }
            }
        }
        out
    }

    // One conversion: flags such as "1.2", ",.0" or ".1"; kind d f g s e %,
    // or "" (as str)
    _spec(flags, kind, v) {
        dot = flags indexOf(".")
        prec = (dot < 0) ifTrue { nil } ifFalse { (flags slice(dot + 1, flags length)) toInt }
        text = nil
        (kind == "s" || kind == "") ifTrue { text = (v type == "Number") ifTrue { short(v) } ifFalse { v toString } }
        (kind == "d") ifTrue { text = format(v, 0) }
        (kind == "f") ifTrue { text = format(v, prec ?? 6) }
        (kind == "g") ifTrue { text = short(v, prec ?? 6) }
        (kind == "e") ifTrue {
            e = exponent(v)
            m = format(v / pow10(e), prec ?? 6)
            text = m + "e" + ((e < 0) ifTrue { "-" } ifFalse { "+" }) + e abs toString padLeft(2, "0")
        }
        (kind == "%") ifTrue { text = format(v * 100, prec ?? 6) + "%" }
        (text == nil) ifTrue { raise("Plot: unknown format conversion: " + kind) }
        (flags contains(",")) ifTrue { text = _thousands(text) }
        text
    }

    // "1234567.5" -> "1,234,567.5"
    _thousands(text) {
        neg = text startsWith(minus)
        body = neg ifTrue { text slice(minus length, text length) } ifFalse { text }
        dot = body indexOf(".")
        whole = (dot < 0) ifTrue { body } ifFalse { body slice(0, dot) }
        rest = (dot < 0) ifTrue { "" } ifFalse { body slice(dot, body length) }
        out = ""
        k = whole length
        { k > 3 } whileTrue {
            out = "," + whole slice(k - 3, k) + out
            k = k - 3
        }
        out = whole slice(0, k) + out + rest
        neg ifTrue { minus + out } ifFalse { out }
    }

    // A short label for any number: up to 4 significant decimals, trailing
    // zeros dropped (used for annotations such as heatmap cells)
    short(v, digits = 4) {
        (v == nil) ifTrue { return "" }
        (v == Math round(v)) ifTrue { return format(v, 0) }
        e = exponent(v)
        d = Math max(0, (digits - 1) - e)
        text = format(v, Math min(d, 6))
        (text contains(".")) ifTrue {
            { text endsWith("0") } whileTrue { text = text slice(0, text length - 1) }
            (text endsWith(".")) ifTrue { text = text slice(0, text length - 1) }
        }
        text
    }
}
