// PlotMath -- math in text, as matplotlib's mathtext: "$\sigma^2$", "$x_i$"
//
//   Plot ylabel("$\\sigma^2$ (variance)")
//   Plot title("Learning rate $\\eta = 10^{-3}$")
//
// Text between a pair of $ signs is math: ^ raises and _ lowers the next
// character or {group} (they nest: $e^{-x^2}$), \alpha and the other Greek
// letters and common symbols (\pm \times \cdot \leq \geq \neq \approx
// \infty \partial \nabla \sum \int \sqrt \rightarrow \Rightarrow \in
// \subset \cup \forall \exists ...) are their characters, and - is a minus
// sign. \mathrm{...}, \text{...}, \mathbb{R} (ℝ; also N, Z, Q, C) and
// \frac{a}{b} (as a/b) work too. Outside math, \$ is a dollar sign; a lone $
// is just text.
//
// $$...$$ is display math: the same, but \sum, \prod and the limit-like
// operators (\lim \max \min \sup \inf \argmax \argmin) put their _ and ^
// below and above them, as "$$\sum_{i=1}^{n} x_i$$" (a bigger \sum, the limits
// centered over and under it), and \frac{a}{b} is stacked, a over b with a
// bar between (also \dfrac). In $...$ limits stay beside the symbol and a
// fraction is a/b, as TeX's text style is. Inside a stacked part (a limit, a
// numerator) they are in line again.
//
// The backends' text and measure come here when a text has math: it is
// broken into runs (text, size, raise), laid out along the baseline, and
// each run drawn by the backend. The terminal draws scripts as Unicode
// superscript and subscript characters instead.

PlotMath = Object clone {
    SUP = 0.7               // a script's size, of its base's
    RISE = 0.42             // how far a superscript rises, in its base's em
    DROP = 0.18             // how far a subscript drops
    BIGOP = 1.25            // a display \sum's size, of the text's
    LIMUP = 0.9             // how far the limit over an operator rises, in ems
    LIMDOWN = 0.92          // how far the limit under it drops
    RULE = "\x01"           // the text of a fraction's bar, which is drawn, not written
    BAR = 0.065             // a bar's thickness, in ems
    AXIS = 0.28             // where the bar is, above the baseline
    FRACSIZE = 0.85         // a stacked numerator's and denominator's size
    FRACUP = 0.5            // how far the numerator's baseline rises
    FRACDOWN = 0.5          // how far the denominator's drops

    // Is there math in s: two $ that aren't \$
    has(s) {
        (s == nil) ifTrue { return false }
        t = s toString
        (t contains("$")) ifFalse { return false }
        n = 0
        i = 0
        { i < t length } whileTrue {
            c = t at(i)
            (c == "\\") ifTrue { i = i + 2 } ifFalse {
                (c == "$") ifTrue { n = n + 1 }
                i = i + 1
            }
        }
        n >= 2
    }

    // The runs of s: [[text, scale, rise], ...], scale a fraction of the
    // font size and rise in ems of it (up is positive)
    runs(s) {
        t = s toString
        out = []
        plain = ""
        i = 0
        n = t length
        { i < n } whileTrue {
            c = t at(i)
            ((c == "\\") && (i + 1 < n) && (t at(i + 1) == "$")) ifTrue {
                plain = plain + "$"
                i = i + 2
            } ifFalse {
                // $$ opens display math, closed by the next unescaped $$
                disp = (c == "$") && (i + 1 < n) && (t at(i + 1) == "$")
                close = (c == "$") ifTrue { _closing(t, i + (disp ifTrue { 2 } ifFalse { 1 }), disp) } ifFalse { -1 }
                (close > 0) ifTrue {
                    _add(out, plain, 1.0, 0.0)
                    plain = ""
                    d = disp ifTrue { 2 } ifFalse { 1 }
                    _math(t slice(i + d, close), 1.0, 0.0, out, disp)
                    i = close + d
                } ifFalse {
                    plain = plain + c
                    i = i + 1
                }
            }
        }
        _add(out, plain, 1.0, 0.0)
        out
    }

    // The index of the $ (the $$ if display) that closes math opened before
    // start, or -1
    _closing(t, start, display = false) {
        i = start
        { i < t length } whileTrue {
            c = t at(i)
            (c == "\\") ifTrue { i = i + 2 } ifFalse {
                (c == "$") ifTrue {
                    (display == false) ifTrue { return i }
                    ((i + 1 < t length) && (t at(i + 1) == "$")) ifTrue { return i }
                }
                i = i + 1
            }
        }
        -1
    }

    // Add text as a run, joining it to the last run when they match; stack,
    // if given, is [column, row] (see _limits): the runs of one column are
    // drawn over each other
    _add(out, text, scale, rise, stack = nil) {
        (text == "") ifTrue { return nil }
        last = (out size > 0) ifTrue { out last } ifFalse { nil }
        lastStack = ((last != nil) && (last size > 4)) ifTrue { last at(4) } ifFalse { nil }
        ((last != nil) && (last at(1) == scale) && (last at(2) == rise) && (lastStack == stack)) ifTrue {
            last setAt(0, last at(0) + text)
        } ifFalse {
            (stack == nil) ifTrue { out append([text, scale, rise]) } ifFalse { out append([text, scale, rise, nil, stack]) }
        }
    }

    // Math source m into runs, at a scale and rise; display for $$...$$
    _math(m, scale, rise, out, display = false) {
        i = 0
        n = m length
        { i < n } whileTrue {
            c = m at(i)
            ((c == "^") || (c == "_")) ifTrue {
                [arg, next] = _argument(m, i + 1)
                up = (c == "^") ifTrue { RISE } ifFalse { 0 - DROP }
                _math(arg, scale * SUP, rise + (up * scale), out)
                i = next
            } ifFalse {
                (c == "{") ifTrue {
                    close = _group(m, i)
                    _math(m slice(i + 1, close), scale, rise, out, display)
                    i = close + 1
                } ifFalse {
                    (c == "\\") ifTrue {
                        [name, next] = _command(m, i)
                        i = (display && (_limitOps find { |s| s == name }) != nil) ifTrue {
                            _limits(name, m, next, scale, rise, out)
                        } ifFalse {
                            (display && ((name == "frac") || (name == "dfrac"))) ifTrue {
                                _stackedFrac(m, next, scale, rise, out)
                            } ifFalse {
                                _expand(name, m, next, scale, rise, out)
                            }
                        }
                    } ifFalse {
                        _add(out, (c == "-") ifTrue { PlotTicks minus } ifFalse { c }, scale, rise)
                        i = i + 1
                    }
                }
            }
        }
    }

    // Operators that take their limits above and below in display math
    _limitOps = ["sum", "prod", "lim", "max", "min", "sup", "inf", "argmax", "argmin"]

    // A display operator with limits: its _ and ^ (either order) set below and
    // above it, each centered, as one column of rows (base 0, below 1, above 2:
    // a [column, row] on their runs). Without limits it is as any command.
    _limits(name, m, next, scale, rise, out) {
        lo = nil
        hi = nil
        j = next
        more = true
        { more } whileTrue {
            k = j
            { (k < m length) && (m at(k) == " ") } whileTrue { k = k + 1 }
            ((k < m length) && (m at(k) == "_") && (lo == nil)) ifTrue {
                [lo, j] = _argument(m, k + 1)
            } ifFalse {
                ((k < m length) && (m at(k) == "^") && (hi == nil)) ifTrue {
                    [hi, j] = _argument(m, k + 1)
                } ifFalse { more = false }
            }
        }
        ((lo == nil) && (hi == nil)) ifTrue { return _expand(name, m, next, scale, rise, out) }
        col = out size
        big = (name == "sum") || (name == "prod")
        bs = big ifTrue { scale * BIGOP } ifFalse { scale }
        // a bigger sign sits lower, to stay centered on the line
        br = big ifTrue { rise - (0.1 * scale) } ifFalse { rise }
        _add(out, (_symbols get(name)) ?? name, bs, br, [col, 0])
        (lo != nil) ifTrue { _limit(lo, scale * SUP, rise - (LIMDOWN * scale), out, [col, 1]) }
        (hi != nil) ifTrue { _limit(hi, scale * SUP, rise + (LIMUP * scale), out, [col, 2]) }
        j
    }

    // \frac in display math: a column of the numerator (row 0), the bar (row 1,
    // a run of RULE whose scale is its thickness) and the denominator (row 2)
    _stackedFrac(m, next, scale, rise, out) {
        [a, mid] = _argument(m, next)
        [b, after] = _argument(m, mid)
        col = out size
        _limit(a, scale * FRACSIZE, rise + (FRACUP * scale), out, [col, 0])
        _add(out, RULE, BAR * scale, rise + (AXIS * scale), [col, 1])
        _limit(b, scale * FRACSIZE, rise - (FRACDOWN * scale), out, [col, 2])
        after
    }

    // m as runs tagged with a stack
    _limit(m, scale, rise, out, stack) {
        tmp = []
        _math(m, scale, rise, tmp)
        tmp each { |r| _add(out, r at(0), r at(1), r at(2), stack) }
    }

    // A command's name (letters after \, or one other character) and where it ends
    _command(m, i) {
        j = i + 1
        { (j < m length) && ("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ" contains(m at(j))) } whileTrue { j = j + 1 }
        (j == i + 1) ifTrue { j = Math min(i + 2, m length) }
        [m slice(i + 1, j), j]
    }

    // A command's output; returns where parsing goes on
    _expand(name, m, next, scale, rise, out) {
        sym = _symbols get(name)
        (sym != nil) ifTrue { _add(out, sym, scale, rise); return next }
        // blackboard bold: the number sets
        (name == "mathbb") ifTrue {
            [arg, after] = _argument(m, next)
            bb = #{R: "ℝ", N: "ℕ", Z: "ℤ", Q: "ℚ", C: "ℂ"} get(arg)
            (bb != nil) ifTrue { _add(out, bb, scale, rise) } ifFalse { _math(arg, scale, rise, out) }
            return after
        }
        // font changes: one font here, so their content as it is
        (([("mathrm"), "text", "mathit", "mathbf", "mathsf", "mathtt", "rm", "operatorname",
           "mathcal", "mathfrak", "mathscr", "boldsymbol", "bm"] find { |s| s == name }) != nil) ifTrue {
            [arg, after] = _argument(m, next)
            _math(arg, scale, rise, out)
            return after
        }
        // function names, upright as written: \sin x, \log p, \max_i
        (([("sin"), "cos", "tan", "log", "ln", "exp", "max", "min", "arg", "lim", "det", "sup", "inf",
           "sinh", "cosh", "tanh", "argmax", "argmin", "softmax", "Pr", "deg", "dim", "gcd"] find { |s| s == name }) != nil) ifTrue {
            _add(out, name, scale, rise)
            return next
        }
        // accents: the bundled font has none, so their letter alone
        ((["hat", "bar", "tilde", "vec", "dot", "ddot", "widehat", "widetilde", "overline", "check", "acute", "grave"] find { |s| s == name }) != nil) ifTrue {
            [arg, after] = _argument(m, next)
            _math(arg, scale, rise, out)
            return after
        }
        ((name == "frac") || (name == "dfrac") || (name == "tfrac")) ifTrue {
            [a, mid] = _argument(m, next)
            [b, after] = _argument(m, mid)
            _math(a, scale, rise, out)
            _add(out, "/", scale, rise)
            _math(b, scale, rise, out)
            return after
        }
        (name == "sqrt") ifTrue {
            [a, after] = _argument(m, next)
            _add(out, "\xe2\x88\x9a", scale, rise)
            _math(a, scale, rise, out)
            return after
        }
        // spacing
        (([",", ";", ":", " ", "quad", "qquad"] find { |s| s == name }) != nil) ifTrue { _add(out, " ", scale, rise); return next }
        (name == "!") ifTrue { return next }
        // an escaped character: \{ \} \$ \% \_ \# \&
        ((name length == 1) && ("{}$%_#&^" contains(name))) ifTrue { _add(out, name, scale, rise); return next }
        // unknown: as written, so the mistake shows
        _add(out, "\\" + name, scale, rise)
        next
    }

    // What ^, _ or a command takes: a {group}, a \command or one character
    _argument(m, i) {
        { (i < m length) && (m at(i) == " ") } whileTrue { i = i + 1 }
        (i >= m length) ifTrue { return ["", i] }
        (m at(i) == "{") ifTrue {
            close = _group(m, i)
            return [m slice(i + 1, close), close + 1]
        }
        (m at(i) == "\\") ifTrue {
            [name, next] = _command(m, i)
            return ["\\" + name, next]
        }
        [m at(i), i + 1]
    }

    // The index of the } closing the { at i (or the end)
    _group(m, i) {
        depth = 0
        j = i
        { j < m length } whileTrue {
            c = m at(j)
            (c == "\\") ifTrue { j = j + 2 } ifFalse {
                (c == "{") ifTrue { depth = depth + 1 }
                (c == "}") ifTrue {
                    depth = depth - 1
                    (depth == 0) ifTrue { return j }
                }
                j = j + 1
            }
        }
        m length
    }

    // ---- layout -----------------------------------------------------------

    // The runs as the backend draws them: its own split (PDF: into fonts)
    _laidOut(cv, s) {
        rs = runs(s)
        (cv hasMethod("_fontRuns")) ifTrue { return cv _fontRuns(rs) }
        // PNG and SVG: the bundled font has every character the symbols use
        rs map { |r| [r at(0), r at(1), r at(2), nil, (r size > 4) ifTrue { r at(4) } ifFalse { nil }] }
    }

    _runWidth(cv, r, size) {
        (r at(0) == RULE) ifTrue { return 0 }
        (r at(3) == nil) ifTrue { return cv _plainMeasure(r at(0), size * r at(1)) }
        cv _plainMeasure(r at(0), size * r at(1), r at(3))
    }

    // The width of s with math, in the backend's units
    width(cv, s, size) {
        (cv hasMethod("superscript")) ifTrue { return cv _plainMeasure(flat(cv, s), size) }
        rs = _laidOut(cv, s)
        (_columns(rs, rs map { |r| _runWidth(cv, r, size) })) at(1)
    }

    // Where each run starts, along the line, the line's width, and for a run
    // of a stack its column's [start, width] (else nil). The runs of a stack
    // (r at(4), [column, row]) are rows over each other: each row centered in
    // the column's width, which is its widest row's.
    _columns(rs, widths) {
        xs = []
        cols = []
        adv = 0
        i = 0
        n = rs size
        { i < n } whileTrue {
            st = ((rs at(i)) size > 4) ifTrue { (rs at(i)) at(4) } ifFalse { nil }
            (st == nil) ifTrue {
                xs append(adv)
                cols append(nil)
                adv = adv + (widths at(i))
                i = i + 1
            } ifFalse {
                j = i
                rowW = #{}
                { (j < n) && ((rs at(j)) size > 4) && ((rs at(j)) at(4) != nil) && (((rs at(j)) at(4)) at(0) == st at(0)) } whileTrue {
                    key = (((rs at(j)) at(4)) at(1)) toString
                    rowW set(key, (rowW get(key) ?? 0) + (widths at(j)))
                    j = j + 1
                }
                w = 0
                rowW each { |k, v| w = Math max(w, v) }
                used = #{}
                k = i
                { k < j } whileTrue {
                    key = (((rs at(k)) at(4)) at(1)) toString
                    done = used get(key) ?? 0
                    xs append(adv + ((w - (rowW get(key))) / 2) + done)
                    cols append([adv, w])
                    used set(key, done + (widths at(k)))
                    k = k + 1
                }
                adv = adv + w
                i = j
            }
        }
        [xs, adv, cols]
    }

    // Draw s with math at x, y (style as the backends' text: size, anchor,
    // valign, rotate, color, weight)
    draw(cv, x, y, s, style) {
        (cv hasMethod("superscript")) ifTrue { return cv _plainText(x, y, flat(cv, s), style) }
        st = style ?? #{}
        size = st get("size") ?? 12
        rs = _laidOut(cv, s)
        widths = rs map { |r| _runWidth(cv, r, size) }
        placed = _columns(rs, widths)
        xs = placed at(0)
        total = placed at(1)
        cols = placed at(2)
        anchor = st get("anchor") ?? "start"
        off = (anchor == "middle") ifTrue { 0 - (total / 2) } ifFalse { (anchor == "end") ifTrue { 0 - total } ifFalse { 0 } }
        rot = st get("rotate") ?? 0
        rad = (rot * Math pi) / 180
        ux = Math cos(rad)
        uy = 0 - Math sin(rad)
        // down the page in the text's own frame, to the baseline
        shift = PlotSvg _baselineShift(st get("valign"), size)
        bx = x - (uy * shift)
        by = y + (ux * shift)
        rs size times { |i|
            r = rs at(i)
            adv = off + (xs at(i))
            up = r at(2) * size
            px = bx + (ux * adv) + (uy * up)
            py = by + (uy * adv) - (ux * up)
            o = Dict clone
            st each { |k, v| o set(k, v) }
            o set("size", size * r at(1))
            o set("anchor", "start")
            o set("valign", "baseline")
            (r at(3) != nil) ifTrue { o set("font", r at(3)) }
            (r at(0) == RULE) ifTrue {
                // a fraction's bar: its column wide, from the column's start
                cs = (cols at(i)) at(0) + off
                th = (r at(1)) * size
                cv line(bx + (ux * cs) + (uy * up), by + (uy * cs) - (ux * up),
                        bx + (ux * (cs + ((cols at(i)) at(1)))) + (uy * up), by + (uy * (cs + ((cols at(i)) at(1)))) - (ux * up),
                        #{stroke: st get("color") ?? "#000000", width: Math max(th, 0.5)})
            } ifFalse {
                cv _plainText(px, py, r at(0), o)
            }
        }
        nil
    }

    // s as one line for the terminal: scripts as Unicode super- and
    // subscript characters where there are some, else as written
    flat(cv, s) {
        text = ""
        rs = runs(s)
        i = 0
        { i < rs size } whileTrue {
            r = rs at(i)
            st = (r size > 4) ifTrue { r at(4) } ifFalse { nil }
            // a stacked fraction: (numerator)/(denominator)
            j = i
            isFrac = false
            (st != nil) ifTrue {
                { (j < rs size) && ((rs at(j)) size > 4) && ((rs at(j)) at(4) != nil) && (((rs at(j)) at(4)) at(0) == st at(0)) } whileTrue {
                    isFrac = isFrac || ((rs at(j)) at(0) == RULE)
                    j = j + 1
                }
            }
            isFrac ifTrue {
                num = ""
                den = ""
                seen = false
                k = i
                { k < j } whileTrue {
                    t = (rs at(k)) at(0)
                    (t == RULE) ifTrue { seen = true } ifFalse { seen ifTrue { den = den + t } ifFalse { num = num + t } }
                    k = k + 1
                }
                text = text + (_grouped(num)) + "/" + (_grouped(den))
                i = j
            } ifFalse {
                t = r at(0)
                (r at(2) > 0.001) ifTrue { t = cv superscript(t) }
                (r at(2) < -0.001) ifTrue { t = _subscript(t) }
                text = text + t
                i = i + 1
            }
        }
        text
    }

    // t, in parentheses unless it is one character
    _grouped(t) { (t length > 1) ifTrue { "(" + t + ")" } ifFalse { t } }

    _subscript(t) {
        digits = ["\xe2\x82\x80", "\xe2\x82\x81", "\xe2\x82\x82", "\xe2\x82\x83", "\xe2\x82\x84",
                  "\xe2\x82\x85", "\xe2\x82\x86", "\xe2\x82\x87", "\xe2\x82\x88", "\xe2\x82\x89"]
        out = ""
        i = 0
        { i < t length } whileTrue {
            c = t at(i)
            k = "0123456789" indexOf(c)
            out = out + (((k != nil) && (k >= 0)) ifTrue { digits at(k) } ifFalse { c })
            i = i + 1
        }
        out
    }

    // \name -> its character
    _symbols() {
        (_table == nil) ifTrue {
            self _table = #{
                alpha: "α", beta: "β", gamma: "γ", delta: "δ", epsilon: "ε", varepsilon: "ε",
                zeta: "ζ", eta: "η", theta: "θ", vartheta: "θ", iota: "ι", kappa: "κ", lambda: "λ",
                mu: "μ", nu: "ν", xi: "ξ", pi: "π", rho: "ρ", sigma: "σ", varsigma: "ς", tau: "τ",
                upsilon: "υ", phi: "φ", varphi: "φ", chi: "χ", psi: "ψ", omega: "ω",
                Gamma: "Γ", Delta: "Δ", Theta: "Θ", Lambda: "Λ", Xi: "Ξ", Pi: "Π", Sigma: "Σ",
                Upsilon: "Υ", Phi: "Φ", Psi: "Ψ", Omega: "Ω",
                pm: "±", mp: "∓", times: "×", div: "÷", cdot: "·", circ: "∘", degree: "°",
                leq: "≤", le: "≤", geq: "≥", ge: "≥", neq: "≠", ne: "≠", approx: "≈", sim: "∼",
                equiv: "≡", infty: "∞", partial: "∂", nabla: "∇", sum: "∑", prod: "∏", int: "∫",
                rightarrow: "→", to: "→", leftarrow: "←", uparrow: "↑", downarrow: "↓",
                Rightarrow: "⇒", leftrightarrow: "↔", in: "∈", forall: "∀", exists: "∃",
                propto: "∝", ldots: "…", cdots: "⋯", prime: "′", hbar: "ħ", ell: "ℓ",
                langle: "⟨", rangle: "⟩", lvert: "|", rvert: "|", vert: "|", star: "⋆", ast: "∗",
                notin: "∉", subset: "⊂", supset: "⊃", subseteq: "⊆", supseteq: "⊇", cup: "∪", cap: "∩",
                emptyset: "∅", varnothing: "∅", setminus: "∖", Leftarrow: "⇐", Leftrightarrow: "⇔",
                iff: "⇔", implies: "⇒", gets: "←", mapsto: "↦", ll: "≪", gg: "≫", parallel: "∥",
                perp: "⊥", mid: "|", neg: "¬", lnot: "¬", land: "∧", wedge: "∧", lor: "∨", vee: "∨",
                oplus: "⊕", otimes: "⊗", angle: "∠", triangle: "△", triangleq: "≜", dagger: "†",
                ddagger: "‡", bullet: "•", surd: "√", nexists: "∄"
            }
        }
        _table
    }
    _table = nil

}
