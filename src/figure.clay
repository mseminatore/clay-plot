// PlotFigure -- a figure: its size, a grid of axes, and saving
//
//   fig = PlotFigure new(#{figsize: [8, 4], dpi: 100})
//   axs = fig subplots(1, 2)       // as matplotlib: one Axes, a row, or rows
//   axs at(0) plot([1, 4, 9])
//   fig savefig("out.svg")
//
// Layout is automatic: each axes gets the room its tick labels, axis labels
// and title need (like matplotlib's tight layout), and axes in one grid
// column (or row) are lined up with each other.

PlotFigure = Object clone {
    widthIn = 6.4
    heightIn = 4.8
    dpi = 100
    facecolor = "#ffffff"
    axesList = nil
    suptitleText = nil
    legendOpts = nil        // fig legend: a legend of all the axes' labelled artists
    suptitleSize = nil

    init(opts = nil) {
        o = opts ?? #{}
        size = o get("figsize") ?? Plot rc get("figure.figsize")
        self widthIn = size at(0)
        self heightIn = size at(1)
        self dpi = o get("dpi") ?? Plot rc get("figure.dpi")
        self facecolor = PlotColor hex(o get("facecolor") ?? Plot rc get("figure.facecolor"))
        self axesList = []
    }

    // Width and height in pixels
    width() { Math round(widthIn * dpi) }
    height() { Math round(heightIn * dpi) }

    // Replace the axes with a rows x cols grid. Returns them as matplotlib
    // does: one Axes for 1 x 1, an Array for a single row or column, else an
    // Array of rows. fig axes is always the flat list. opts: sharex, sharey
    // (true or "all": every axes; "col": each column; "row": each row): the
    // shared axes show one range and scale, and inner tick labels are left
    // out (x but the bottom row's, sharing columns; y but the first
    // column's, sharing rows)
    subplots(rows = 1, cols = 1, opts = nil) {
        (rows type == "Dict") ifTrue { opts = rows; rows = 1 }
        (cols type == "Dict") ifTrue { opts = cols; cols = 1 }
        self axesList = []
        grid = []
        rows times { |r|
            row = []
            cols times { |c|
                ax = PlotAxes new(self, [rows, cols, r, c])
                axesList append(ax)
                row append(ax)
            }
            grid append(row)
        }
        (opts != nil) ifTrue {
            _share(grid, opts get("sharex"), true)
            _share(grid, opts get("sharey"), false)
        }
        ((rows == 1) && (cols == 1)) ifTrue { return grid first first }
        (rows == 1) ifTrue { return grid first }
        (cols == 1) ifTrue { return grid map { |row| row first } }
        grid
    }

    // The axes at position index (1-based, left to right then down) of a
    // rows x cols grid, made if it isn't there yet (matplotlib's add_subplot)
    addSubplot(rows = 1, cols = 1, index = 1) {
        (index < 1 || index > rows * cols) ifTrue { raise("Plot: subplot index " + index toString + " is outside a " + rows toString + " x " + cols toString + " grid") }
        r = (index - 1) / cols
        c = (index - 1) % cols
        where = [rows, cols, r, c, 1, 1]
        found = axesList find { |ax| ax cell == where }
        (found != nil) ifTrue { return found }
        ax = PlotAxes new(self, where)
        axesList append(ax)
        ax
    }

    // Group the grid's axes to share x (or y): how is true or "all", "col",
    // "row", or false / nil / "none"
    _share(grid, how, isX) {
        ((how == nil) || (how == false) || (how == "none")) ifTrue { return nil }
        all = (how == true) || (how == "all")
        ((all || (how == "col") || (how == "row")) not) ifTrue {
            raise("Plot: share" + (isX ifTrue { "x" } ifFalse { "y" }) + " is true, \"all\", \"col\", \"row\" or false")
        }
        rows = grid size
        cols = grid first size
        groups = all ifTrue { [grid flatten] } ifFalse {
            (how == "col") ifTrue { (0..(cols - 1)) map { |c| grid map { |row| row at(c) } } } ifFalse { grid }
        }
        groups each { |g| g each { |a| isX ifTrue { a xGroup = g } ifFalse { a yGroup = g } } }
        // inner tick labels: x but the bottom row's when columns share; y but the first column's when rows share
        (isX && (all || (how == "col"))) ifTrue {
            (rows - 1) times { |r| grid at(r) each { |a| a hideXTicks = true } }
        }
        ((isX not) && (all || (how == "row"))) ifTrue {
            grid each { |row| (cols - 1) times { |c| row at(c + 1) hideYTicks = true } }
        }
    }

    // The axes for a layout of names, as matplotlib's subplot_mosaic: one
    // String per row (a character a cell) or Arrays of names; a name over
    // several cells (a rectangle) is one axes spanning them; "." is empty.
    // Returns a Dict of the axes by name.
    subplotMosaic(layout) {
        rows = layout map { |r| (r type == "String") ifTrue { (0..(r length - 1)) map { |i| r at(i) } } ifFalse { r } }
        nr = rows size
        nc = rows first size
        ((rows find { |r| r size != nc }) != nil) ifTrue { raise("Plot: subplotMosaic: every row needs the same number of cells") }
        names = []
        nr times { |r| nc times { |c|
            n = rows at(r) at(c) toString
            ((n != ".") && (names indexOf(n) == nil || names indexOf(n) < 0)) ifTrue { names append(n) }
        } }
        self axesList = []
        out = Dict clone
        names each { |n|
            r0 = nr
            c0 = nc
            r1 = -1
            c1 = -1
            nr times { |r| nc times { |c|
                (rows at(r) at(c) toString == n) ifTrue {
                    r0 = Math min(r0, r); c0 = Math min(c0, c)
                    r1 = Math max(r1, r); c1 = Math max(c1, c)
                }
            } }
            ((r0..r1) toArray) each { |r| ((c0..c1) toArray) each { |c|
                (rows at(r) at(c) toString != n) ifTrue { raise("Plot: subplotMosaic: \"" + n + "\" must fill a rectangle") }
            } }
            ax = PlotAxes new(self, [nr, nc, r0, c0, (r1 - r0) + 1, (c1 - c0) + 1])
            axesList append(ax)
            out set(n, ax)
        }
        out
    }

    // An axes over rowspan x colspan cells of a rows x cols grid, from the
    // cell at [row, col] (0-based), as matplotlib's subplot2grid
    addSubplotGrid(shape, loc, rowspan = 1, colspan = 1) {
        (rowspan type == "Dict") ifTrue { colspan = rowspan get("colspan") ?? 1; rowspan = rowspan get("rowspan") ?? 1 }
        rows = shape at(0)
        cols = shape at(1)
        r = loc at(0)
        c = loc at(1)
        ((r < 0) || (c < 0) || (r + rowspan > rows) || (c + colspan > cols)) ifTrue {
            raise("Plot: subplot2grid: cells " + loc toString + " spanning " + rowspan toString + " x " + colspan toString + " go outside a " + rows toString + " x " + cols toString + " grid")
        }
        where = [rows, cols, r, c, rowspan, colspan]
        found = axesList find { |ax| ax cell == where }
        (found != nil) ifTrue { return found }
        ax = PlotAxes new(self, where)
        axesList append(ax)
        ax
    }

    // A legend of every axes' labelled artists (a label once), for the
    // whole figure: legend(#{loc:, ncol:, title:, fontsize:, framealpha:}).
    // loc: "upper right" (the default) and the other corners, sides and
    // "center", inside the figure; or "outside right", "outside left",
    // "outside upper center" or "outside lower center" (also "outside
    // right upper" / "outside right lower"), beside the axes, which make
    // room for it
    legend(opts = nil) {
        self legendOpts = opts ?? #{}
        self
    }

    // All the axes' legend entries, each label once
    _legendEntries() {
        out = []
        seen = Dict clone
        axesList each { |ax|
            (ax host == nil) ifTrue {
                ax _legendEntries each { |a|
                    k = a get("label") toString
                    (seen get(k) == nil) ifTrue { seen set(k, true); out append(a) }
                }
            }
        }
        out
    }

    // All the axes, in the order they were made
    axes() { axesList }

    // The axes at row r, column c (0-based) of a subplots grid
    ax(r = 0, c = 0) {
        axesList find { |a| (a cell at(2) == r) && (a cell at(3) == c) }
    }

    suptitle(s, opts = nil) {
        self suptitleText = s
        self suptitleSize = (opts == nil) ifTrue { nil } ifFalse { opts get("fontsize") }
        self
    }

    // Remove all axes
    clear() { self axesList = []; self suptitleText = nil; self legendOpts = nil; self }

    // Save to a file; the extension picks the format: .png, .svg or .pdf.
    // opts: dpi (pixels per inch for this file; the figure's own by default;
    // a PDF is vector graphics, so it has none)
    savefig(path, opts = nil) {
        dot = path lastIndexOf(".")
        ext = ((dot == nil) || (dot < 0)) ifTrue { "" } ifFalse { path slice(dot + 1, path length) lower }
        dpiFor = (opts == nil) ifTrue { nil } ifFalse { opts get("dpi") }
        (ext == "svg") ifTrue {
            File write(path, toSvg(dpiFor))
            return path
        }
        (ext == "png") ifTrue {
            File write(path, toPng(dpiFor))
            return path
        }
        (ext == "pdf") ifTrue {
            File write(path, toPdf)
            return path
        }
        raise("Plot: savefig can't write \"" + path + "\": use a .png, .svg or .pdf file name")
    }

    // The figure as an SVG document (a String), e.g. to serve from a web app
    toSvg(dpiFor = nil) {
        _withDpi(dpiFor) {
            cv = PlotSvg new(width, height, facecolor)
            render(cv)
            cv finish
        }
    }

    // The figure as a PNG file's bytes (a String)
    toPng(dpiFor = nil) { (toCanvas(dpiFor)) pngBytes }

    // The figure drawn on a Canvas (image brick); toCanvas toImage is an Image
    toCanvas(dpiFor = nil) {
        _withDpi(dpiFor) {
            cv = PlotPng new(width, height, facecolor)
            render(cv)
            cv finish
        }
    }

    // The figure as a PDF file's bytes (a String): one page the figure's size
    toPdf() {
        doc = Pdf new([widthIn * 72, heightIn * 72])
        drawPdf(doc addPage, 0, 0)
        doc render
    }

    // Draw the figure on a page of a Pdf (pdf brick) with its top-left corner
    // at (x, y), in points; width scales it (default: its size in inches at
    // 72 points per inch). Returns the height it takes, to go on below it:
    //   y = y + fig drawPdf(page, 72, y, 468)
    drawPdf(page, x, y, width = nil) {
        _withDpi(72) {
            w = self width
            h = self height
            scale = (width == nil) ifTrue { 1 } ifFalse { width / (w * 1.0) }
            cv = PlotPdf new(page, w, h, facecolor, x, y, scale)
            render(cv)
            cv finish
            h * scale
        }
    }

    // Run a block with dpi set to dpiFor (if given), then put it back
    // The figure as text for a terminal (see PlotTerm): Braille dots, text
    // in cells and ANSI colours. opts: cols (default: the COLUMNS variable,
    // or 80), rows (default: the figure's shape, at most LINES - 1),
    // color (default: true when the output is a terminal)
    toText(opts = nil) {
        o = opts ?? #{}
        nc = o get("cols") ?? _envInt("COLUMNS") ?? 80
        nr = o get("rows")
        (nr == nil) ifTrue {
            // a cell is about twice as tall as it is wide, as 4 dots are to 2
            nr = Math round((nc * heightIn) / (widthIn * 2))
            lines = _envInt("LINES")
            (lines != nil) ifTrue { nr = Math min(nr, lines - 1) }
        }
        useColor = o get("color") ?? Console isTerminal
        saved = [widthIn, heightIn, dpi]
        // 10-point text is 4 dots high: one row of cells
        tdpi = 28.8
        self widthIn = (nc * 2) / tdpi
        self heightIn = (nr * 4) / tdpi
        self dpi = tdpi
        try {
            cv = PlotTerm new(nc, nr, useColor)
            render(cv)
            cv finish
        } finally {
            self widthIn = saved at(0)
            self heightIn = saved at(1)
            self dpi = saved at(2)
        }
    }

    _envInt(name) {
        v = System env(name)
        ((v == nil) || (v == "")) ifTrue { return nil }
        n = v toInt
        ((n == nil) || (n <= 0)) ifTrue { nil } ifFalse { n }
    }

    _withDpi(dpiFor, block) {
        (dpiFor == nil) ifTrue { return block value }
        saved = dpi
        self dpi = dpiFor
        try { block value } finally { self dpi = saved }
    }

    // Save to a temporary PNG and open it in the system's image viewer;
    // returns the file's path. With #{terminal: true} (and toText's
    // options), or on Linux without a display, print it as text instead.
    show(opts = nil) {
        o = opts ?? #{}
        noDisplay = (System platform == "linux") && ((System env("DISPLAY") ?? "") == "") && ((System env("WAYLAND_DISPLAY") ?? "") == "")
        ((o get("terminal") == true) || (noDisplay && (o get("terminal") != false))) ifTrue {
            toText(o) print
            return nil
        }
        path = File tempDir + "/figure.png"
        savefig(path)
        platform = System platform
        cmd = (platform == "windows") ifTrue { ["cmd", "/c", "start", "", path] } ifFalse {
            (platform == "macos") ifTrue { ["open", path] } ifFalse { ["xdg-open", path] }
        }
        try { Process run(cmd) } catch { |e| ("Plot: couldn't open a viewer; the figure is at " + path) println }
        path
    }

    // Lay out the axes and draw everything on a canvas (any backend)
    render(cv) {
        w = width
        h = height
        pt = dpi / 72.0
        pad = 6 * pt
        top = pad
        (suptitleText != nil) ifTrue {
            size = (suptitleSize ?? Plot rc get("figure.titlesize")) * pt
            cv text(w / 2, pad, suptitleText, #{size: size, anchor: "middle", valign: "top"})
            top = top + (size * 1.4)
        }
        // twins (twinx, twiny) are laid out and drawn by the axes they share a box with
        primary = axesList filter { |ax| ax host == nil }
        (primary size == 0) ifTrue { return cv }
        areaX = pad
        areaY = top
        areaW = w - (pad * 2)
        areaH = h - top - pad
        // a figure legend outside the axes takes its room first
        flay = nil
        floc = nil
        fpos = nil
        (legendOpts != nil) ifTrue {
            entries = _legendEntries
            (entries size > 0) ifTrue {
                flay = primary first _legendLayout(cv, entries, legendOpts)
                floc = legendOpts get("loc") ?? "upper right"
                lw = flay get("w")
                lh = flay get("h")
                gap = 6 * pt
                (floc startsWith("outside ")) ifTrue {
                    side = floc slice(8, floc length)
                    ((side startsWith("right")) || (side == "center right")) ifTrue {
                        areaW = areaW - lw - gap
                        y0 = (side contains("upper")) ifTrue { areaY } ifFalse {
                            (side contains("lower")) ifTrue { (areaY + areaH) - lh } ifFalse { areaY + ((areaH - lh) / 2) }
                        }
                        fpos = [areaX + areaW + gap, y0]
                    }
                    ((side startsWith("left")) || (side == "center left")) ifTrue {
                        fpos = [areaX, areaY + ((areaH - lh) / 2)]
                        areaX = areaX + lw + gap
                        areaW = areaW - lw - gap
                    }
                    ((side == "upper center") || (side == "upper") || (side == "top")) ifTrue {
                        fpos = [(w - lw) / 2, areaY]
                        areaY = areaY + lh + gap
                        areaH = areaH - lh - gap
                    }
                    ((side == "lower center") || (side == "lower") || (side == "bottom")) ifTrue {
                        areaH = areaH - lh - gap
                        fpos = [(w - lw) / 2, areaY + areaH + gap]
                    }
                    (fpos == nil) ifTrue { raise("Plot: figure legend loc \"" + floc + "\": use \"outside right\", \"outside left\", \"outside upper center\" or \"outside lower center\"") }
                }
            }
        }
        // each axes' cells (a span of grid cells) and the margins it asks for
        cells = primary map { |ax|
            g = ax cell
            cw = areaW / g at(1)
            ch = areaH / g at(0)
            [areaX + (g at(3) * cw), areaY + (g at(2) * ch), cw * g at(5), ch * g at(4)]
        }
        gapX = 10 * pt
        gapY = 10 * pt
        margins = []
        primary size times { |i|
            c = cells at(i)
            margins append(primary at(i) _margins(cv, c at(2) * 0.8, c at(3) * 0.8))
        }
        // line up axes that share a grid column (left, right) or row (top, bottom)
        primary size times { |i|
            gi = primary at(i) cell
            m = margins at(i)
            l = m at(0)
            t = m at(1)
            r = m at(2)
            b = m at(3)
            primary size times { |j|
                gj = primary at(j) cell
                ((gj at(0) == gi at(0)) && (gj at(1) == gi at(1))) ifTrue {
                    // axes starting (or ending) in the same column line up their left (right)
                    (gj at(3) == gi at(3)) ifTrue { l = Math max(l, margins at(j) at(0)) }
                    ((gj at(3) + gj at(5)) == (gi at(3) + gi at(5))) ifTrue { r = Math max(r, margins at(j) at(2)) }
                    (gj at(2) == gi at(2)) ifTrue { t = Math max(t, margins at(j) at(1)) }
                    ((gj at(2) + gj at(4)) == (gi at(2) + gi at(4))) ifTrue { b = Math max(b, margins at(j) at(3)) }
                }
            }
            c = cells at(i)
            sepX = (gi at(1) > 1) ifTrue { gapX / 2 } ifFalse { 0 }
            sepY = (gi at(0) > 1) ifTrue { gapY / 2 } ifFalse { 0 }
            box = [c at(0) + l + sepX, c at(1) + t + sepY,
                   c at(2) - l - r - (sepX * 2), c at(3) - t - b - (sepY * 2)]
            primary at(i) _place(cv, box)
        }
        primary each { |ax| ax draw(cv) }
        (flay != nil) ifTrue {
            (fpos == nil) ifTrue {
                // inside the figure: a corner, side or the centre of the area the axes fill
                inset = 4 * pt
                lw = flay get("w")
                lh = flay get("h")
                ax0 = areaX + inset
                ax1 = (areaX + areaW) - inset
                ay0 = areaY + inset
                ay1 = (areaY + areaH) - inset
                px = (floc contains("left")) ifTrue { ax0 } ifFalse { (floc contains("right")) ifTrue { ax1 } ifFalse { (ax0 + ax1) / 2 } }
                py = (floc contains("upper")) ifTrue { ay0 } ifFalse { (floc contains("lower")) ifTrue { ay1 } ifFalse { (ay0 + ay1) / 2 } }
                corner = floc
                (floc == "right") ifTrue { corner = "center right" }
                fpos = primary first _cornerAt(corner, px, py, lw, lh)
            }
            primary first _legendBox(cv, flay, fpos at(0), fpos at(1), legendOpts)
        }
        cv
    }

    toString() {
        (self == PlotFigure) ifTrue { return "PlotFigure" }
        "Figure(" + width toString + " x " + height toString + ", " + axesList size toString + " axes)"
    }
}
