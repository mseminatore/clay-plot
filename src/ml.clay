// PlotML -- plots for machine learning: learning curves, confusion
// matrices, ROC and precision-recall curves, grids of images, decision
// boundaries
//
//   Plot learningCurve(net history)
//   Plot confusionMatrix(net confusionMatrix(x, y), #{labels: names})
//   Plot roc(scores, targets)              // returns #{fpr:, tpr:, thresholds:, auc:}
//   Plot imageGrid(xTest slice(0, 20), #{predicted: p, actual: y})
//   Plot decisionBoundary(net, points, labels)   // a 2-input classifier's regions
//
// They take plain Arrays of numbers, so they work with clay-ann's results
// without depending on it. The drawing methods are also axes methods
// (ax roc(...)); the curves alone come from PlotML rocCurve, prCurve and
// confusion.

PlotML = Object clone {

    // ---- computations ---------------------------------------------------

    // The ROC curve of scores (higher means more likely positive) against
    // targets (1/true positive, 0/false negative): #{fpr:, tpr:,
    // thresholds:, auc:}. One point per distinct score, from (0, 0) to (1, 1).
    rocCurve(scores, targets) {
        sweep = _sweep(scores, targets)
        fpr = [0.0]
        tpr = [0.0]
        th = [nil]
        p = sweep get("positives") toFloat
        n = sweep get("negatives") toFloat
        sweep get("steps") each { |s|
            fpr append(s at(2) / n)
            tpr append(s at(1) / p)
            th append(s at(0))
        }
        auc = 0.0
        (fpr size - 1) times { |i|
            auc = auc + (((fpr at(i + 1) - fpr at(i)) * (tpr at(i + 1) + tpr at(i))) / 2)
        }
        #{fpr: fpr, tpr: tpr, thresholds: th, auc: auc}
    }

    // The precision-recall curve: #{precision:, recall:, thresholds:, ap:},
    // ap being the average precision (sum over thresholds of the recall
    // gained times the precision there)
    prCurve(scores, targets) {
        sweep = _sweep(scores, targets)
        p = sweep get("positives") toFloat
        precision = [1.0]
        recall = [0.0]
        th = [nil]
        ap = 0.0
        sweep get("steps") each { |s|
            tp = s at(1)
            fp = s at(2)
            r = tp / p
            pr = tp / (tp + fp) toFloat
            ap = ap + ((r - recall last) * pr)
            precision append(pr)
            recall append(r)
            th append(s at(0))
        }
        #{precision: precision, recall: recall, thresholds: th, ap: ap}
    }

    // A confusion matrix from class numbers: rows are the actual class,
    // columns the predicted one. n classes (default: the largest + 1).
    confusion(actual, predicted, n = nil) {
        (actual size != predicted size) ifTrue { raise("Plot: confusion: actual and predicted must be the same length") }
        k = n
        (k == nil) ifTrue { k = Math max(actual max, predicted max) + 1 }
        m = (1..k) map { |i| (1..k) map { |j| 0 } }
        actual size times { |i|
            row = m at(actual at(i))
            c = predicted at(i)
            row setAt(c, row at(c) + 1)
        }
        m
    }

    // ---- learning curves ------------------------------------------------

    learningCurve(ax, history, opts) {
        series = _historySeries(history)
        (series size == 0) ifTrue { raise("Plot: learningCurve needs a history") }
        lines = []
        series each { |s|
            ys = s at(1)
            xs = (1..(ys size)) toArray
            o = #{label: s at(0)}
            ((s at(0) == "validation") || (s at(0) == "val_loss")) ifTrue { o set("linestyle", "--") }
            lines append(ax plot(xs, ys, o))
        }
        // mark the best epoch: given, or where validation (else training) loss is lowest
        best = opts get("best")
        (best == nil) ifTrue { best = true }
        (best == true) ifTrue {
            target = series find { |s| (s at(0) == "validation") || (s at(0) == "val_loss") }
            (target == nil) ifTrue { target = series first }
            best = _argmin(target at(1))
            (best != nil) ifTrue { best = best + 1 }
        }
        (best == false) ifTrue { best = nil }
        (best != nil) ifTrue {
            ax axvline(best, #{color: "gray", linestyle: ":", lw: 1, label: "best epoch (" + best toString + ")"})
        }
        ax xlabel(opts get("xlabel") ?? "epoch")
        ax ylabel(opts get("ylabel") ?? "loss")
        (opts get("title") != nil) ifTrue { ax title(opts get("title")) }
        ax grid(true, #{alpha: 0.5})
        ax legend
        lines
    }

    // [[name, values], ...] from net history rows, an Array of numbers or a Dict
    _historySeries(history) {
        (history type == "Dict") ifTrue {
            return history keys map { |k| [k, _gaps(history get(k))] }
        }
        h = (history type == "Array") ifTrue { history } ifFalse { history toArray }
        (h size == 0) ifTrue { return [] }
        // what net fit returns: a Dict per epoch, #{epoch:, loss:, valLoss:, lr:}
        (h first type == "Dict") ifTrue {
            out = []
            h first keys each { |k|
                ((k != "epoch") && (k != "lr")) ifTrue {
                    name = k
                    (k == "loss") ifTrue { name = "train" }
                    (k == "valLoss") ifTrue { name = "validation" }
                    values = _gaps(h map { |e| e get(k) })
                    // (valLoss is -1 throughout without validation data)
                    ((values filter { |v| v != nil }) size > 0) ifTrue { out append([name, values]) }
                }
            }
            return out
        }
        (h first type == "Array") ifFalse { return [["loss", _gaps(h)]] }
        out = [["train", _gaps(h map { |r| r at(0) })]]
        ((h first size > 2) && ((h filter { |r| (r at(2) != nil) && (r at(2) >= 0) }) size > 0)) ifTrue {
            out append(["validation", _gaps(h map { |r| r at(2) })])
        }
        out
    }

    // nil for values that mean "none" (nil, nan, negative placeholders)
    _gaps(values) {
        values map { |v|
            ((v == nil) || (v != v) || (v < 0)) ifTrue { nil } ifFalse { v }
        }
    }

    _argmin(values) {
        best = nil
        at = nil
        values size times { |i|
            v = values at(i)
            ((v != nil) && ((best == nil) || (v < best))) ifTrue { best = v; at = i }
        }
        at
    }

    // ---- confusion matrices ---------------------------------------------

    // opts: labels (class names), normalize (nil, "true": rows sum to 1,
    // "pred": columns, "all"), cmap ("Blues"), colorbar (true), annotate
    // (true up to 30 classes), rotation (of the x labels)
    confusionMatrix(ax, matrix, opts) {
        k = matrix size
        values = _normalize(matrix, opts get("normalize"))
        cmap = opts get("cmap") ?? "Blues"
        lo = 0
        hi = (values map { |row| row max }) max
        (opts get("normalize") != nil) ifTrue { hi = 1 }
        img = ax imshow(values, #{cmap: cmap, vmin: lo, vmax: hi})
        (opts get("colorbar") != false) ifTrue { ax colorbar(img) }
        annotate = opts get("annotate")
        (annotate == nil) ifTrue { annotate = k <= 30 }
        annotate ifTrue {
            fs = (k <= 10) ifTrue { 10 } ifFalse { (k <= 20) ifTrue { 7 } ifFalse { 5 } }
            span = (hi - lo) toFloat
            (span == 0) ifTrue { span = 1.0 }
            k times { |r|
                k times { |c|
                    v = values at(r) at(c)
                    text = (opts get("normalize") != nil) ifTrue { PlotTicks format(v, 2) } ifFalse { PlotTicks short(v) }
                    ax text(c, r, text, #{ha: "center", va: "center", fontsize: fs,
                                          color: _contrast(cmap, (v - lo) / span)})
                }
            }
        }
        ticks = (0..(k - 1)) toArray
        names = opts get("labels")
        (names == nil) ifTrue { names = ticks map { |i| i toString } }
        ax xticks(ticks, names, #{rotation: opts get("rotation") ?? 0})
        ax yticks(ticks, names)
        ax xlabel(opts get("xlabel") ?? "predicted")
        ax ylabel(opts get("ylabel") ?? "actual")
        (opts get("title") != nil) ifTrue { ax title(opts get("title")) }
        img
    }

    _normalize(matrix, how) {
        (how == nil) ifTrue { return matrix }
        (how == "true") ifTrue {
            return matrix map { |row|
                s = row sum
                row map { |v| (s == 0) ifTrue { 0.0 } ifFalse { v / s toFloat } }
            }
        }
        (how == "pred") ifTrue {
            sums = (0..(matrix first size - 1)) map { |c| (matrix map { |row| row at(c) }) sum }
            return matrix map { |row|
                (0..(row size - 1)) map { |c| (sums at(c) == 0) ifTrue { 0.0 } ifFalse { row at(c) / sums at(c) toFloat } }
            }
        }
        (how == "all") ifTrue {
            total = (matrix map { |row| row sum }) sum
            return matrix map { |row| row map { |v| (total == 0) ifTrue { 0.0 } ifFalse { v / total toFloat } } }
        }
        raise("Plot: confusionMatrix normalize is \"true\", \"pred\" or \"all\"")
    }

    // Black or white, whichever reads better on the colormap's colour at t
    _contrast(cmap, t) {
        c = PlotColor colormap(cmap, t)
        lum = (0.299 * c at(0)) + (0.587 * c at(1)) + (0.114 * c at(2))
        (lum > 140) ifTrue { "#000000" } ifFalse { "#ffffff" }
    }

    // ---- ROC and precision-recall -----------------------------------------

    // opts: labels (class names for rows of scores), label (one curve's
    // name), chance (true: the diagonal), title
    roc(ax, scores, targets, opts) {
        curves = _perClass(scores, targets)
        results = []
        curves each { |cl|
            r = rocCurve(cl at(1), cl at(2))
            name = _curveName(cl at(0), opts, curves size)
            ax plot(r get("fpr"), r get("tpr"), #{label: name + "AUC " + PlotTicks format(r get("auc"), 3)})
            results append(r)
        }
        (opts get("chance") != false) ifTrue { ax plot([0, 1], [0, 1], "k--", #{lw: 1, alpha: 0.6, label: "chance"}) }
        _unitAxes(ax, opts get("xlabel") ?? "false positive rate", opts get("ylabel") ?? "true positive rate", opts)
        ax legend(#{loc: "lower right"})
        (results size == 1) ifTrue { results first } ifFalse { results }
    }

    // What a classifier decides across the plane of its two inputs, with the
    // data on top. model is a network (anything with predictBatch(rows), as
    // clay-ann's), or a block from a row [x, y] to its outputs or its class.
    // One output is the probability of class 1: shaded red (0) to blue (1)
    // with a line where it is 0.5. Several outputs are classes, the largest
    // winning, each in its own colour. labels (optional): a class per row,
    // or one-hot rows. Options: resolution (points a side, 100), margin (a
    // fraction of the data's span, 0.1), cmap (one output, "RdBu"),
    // classNames (for a legend), s (marker area, 25). Returns the contourf
    // artist (with several classes, an Array of one per class).
    decisionBoundary(ax, model, inputs, labels, opts) {
        rows = ax _seq(inputs)
        (rows size == 0) ifTrue { raise("Plot: decisionBoundary needs input rows") }
        ((rows find { |r| (r type != "Array") || (r size != 2) }) != nil) ifTrue {
            raise("Plot: decisionBoundary needs rows of two inputs, [x, y], to draw on a plane")
        }
        xs = rows map { |r| r at(0) }
        ys = rows map { |r| r at(1) }
        n = Math max(opts get("resolution") ?? 100, 2)
        m = opts get("margin") ?? 0.1
        gx = _span(xs min, xs max, m, n)
        gy = _span(ys min, ys max, m, n)
        pts = []
        n times { |i| n times { |j| pts append([gx at(j), gy at(i)]) } }
        out = _predict(model, pts)
        // one output, or several (classes); a block may give class numbers
        first = out first
        multi = (first type == "Array") && (first size > 1)
        nums = multi ifTrue { nil } ifFalse { out map { |o| (o type == "Array") ifTrue { o first } ifFalse { o } } }
        ((nums != nil) && (nums max > 1) && ((nums find { |v| v != Math round(v) }) == nil)) ifTrue { multi = true }
        grid = { |vals| (0..(n - 1)) map { |i| vals slice(i * n, (i + 1) * n) } }
        cs = nil
        pointColor = nil
        multi ifTrue {
            // a score per class: the outputs, or one-hot rows for class numbers
            scores = (nums != nil) ifTrue {
                k0 = Math round(nums max) + 1
                nums map { |v| (0..(k0 - 1)) map { |c| (c == Math round(v)) ifTrue { 1 } ifFalse { 0 } } }
            } ifFalse { out }
            k = scores first size
            // Each class's region is where its margin over the best other
            // class is positive. Filling those (rather than bands of class
            // numbers) gives smooth borders, with no sliver of a class
            // whose number lies between two neighbours'.
            cs = (0..(k - 1)) map { |c|
                margin = scores map { |s|
                    best = nil
                    k times { |j| ((j != c) && ((best == nil) || (s at(j) > best))) ifTrue { best = s at(j) } }
                    s at(c) - best
                }
                top = Math max(margin max, 0) + 1
                ax contourf(gx, gy, grid value(margin), [0, top], #{colors: [_light(PlotColor cycleColor(c), 0.6)]})
            }
            pointColor = { |c| PlotColor cycleColor(c) }
        } ifFalse {
            cmap = opts get("cmap") ?? "RdBu"
            lv = (0..10) map { |i| i / 10.0 }
            cs = ax contourf(gx, gy, grid value(nums), lv,
                             #{colors: (0..9) map { |i| _light(PlotColor toHex(PlotColor colormap(cmap, (i + 0.5) / 10.0)), 0.45) }})
            ax contour(gx, gy, grid value(nums), [0.5], #{colors: "k", linewidths: 1})
            pointColor = { |c| PlotColor toHex(PlotColor colormap(cmap, (c == 0) ifTrue { 0.1 } ifFalse { 0.9 })) }
        }
        names = opts get("classNames")
        (labels != nil) ifTrue {
            lab = ax _seq(labels) map { |l|
                (l type == "Array") ifTrue { (l size == 1) ifTrue { Math round(l first) } ifFalse { argmax(l) } } ifFalse { Math round(l) }
            }
            (lab size != rows size) ifTrue { raise("Plot: decisionBoundary: " + rows size toString + " rows but " + lab size toString + " labels") }
            (lab max + 1) times { |c|
                idx = (0..(lab size - 1)) filter { |i| lab at(i) == c }
                (idx size > 0) ifTrue {
                    name = (names != nil) ifTrue { (names at(c) ?? c) toString } ifFalse { "class " + c toString }
                    ax scatter(idx map { |i| xs at(i) }, idx map { |i| ys at(i) },
                               #{color: pointColor value(c), edgecolors: "k", s: opts get("s") ?? 25, label: name})
                }
            }
            (names != nil) ifTrue { ax legend }
        } ifFalse {
            ax scatter(xs, ys, #{color: "k", s: opts get("s") ?? 25})
        }
        cs
    }

    // n points from lo to hi, widened by margin times the span at each end
    _span(lo, hi, margin, n) {
        d = (hi - lo) toFloat
        (d == 0) ifTrue { d = 1.0 }
        a = lo - (d * margin)
        b = hi + (d * margin)
        (0..(n - 1)) map { |i| a + (((b - a) * i) / (n - 1)) }
    }

    // A model's outputs for rows: predictBatch, predict, or a block
    _predict(model, rows) {
        (model type == "Block") ifTrue { return rows map { |r| model value(r) } }
        (model hasMethod("predictBatch")) ifTrue {
            out = model predictBatch(rows)
            return (out type == "Array") ifTrue { out } ifFalse { out toArray }
        }
        (model hasMethod("predict")) ifTrue { return rows map { |r| model predict(r) } }
        raise("Plot: decisionBoundary needs a model with predictBatch or predict, or a block")
    }

    // A colour mixed with white: f of the way to white
    _light(c, f) {
        rgb = PlotColor rgb(c)
        PlotColor toHex((0..2) map { |i| Math round(rgb at(i) + ((255 - rgb at(i)) * f)) })
    }

    precisionRecall(ax, scores, targets, opts) {
        curves = _perClass(scores, targets)
        results = []
        curves each { |cl|
            r = prCurve(cl at(1), cl at(2))
            name = _curveName(cl at(0), opts, curves size)
            ax plot(r get("recall"), r get("precision"), #{label: name + "AP " + PlotTicks format(r get("ap"), 3)})
            results append(r)
        }
        _unitAxes(ax, opts get("xlabel") ?? "recall", opts get("ylabel") ?? "precision", opts)
        ax legend(#{loc: "lower left"})
        (results size == 1) ifTrue { results first } ifFalse { results }
    }

    _curveName(index, opts, count) {
        (count == 1) ifTrue {
            l = opts get("label")
            return (l == nil) ifTrue { "" } ifFalse { l + ", " }
        }
        names = opts get("labels")
        (names == nil) ifTrue { return "class " + index toString + ", " }
        names at(index) toString + ", "
    }

    _unitAxes(ax, xl, yl, opts) {
        ax xlim(0, 1)
        ax ylim(0, 1.02)
        ax xlabel(xl)
        ax ylabel(yl)
        ax grid(true, #{alpha: 0.5})
        (opts get("title") != nil) ifTrue { ax title(opts get("title")) }
    }

    // [[classIndex, scores, targets], ...]: one entry for binary scores, one
    // per class (one against the rest) for rows of scores. Targets are 0/1,
    // true/false, class numbers, or one-hot rows.
    _perClass(scores, targets) {
        s = _seq(scores)
        t = _seq(targets)
        (s size != t size) ifTrue { raise("Plot: scores and targets must be the same length (" + s size toString + " and " + t size toString + ")") }
        (s size == 0) ifTrue { raise("Plot: no scores") }
        ((s first type == "Array") && (s first size == 1)) ifTrue { s = s map { |r| r first } }
        ((t first type == "Array") && (t first size == 1)) ifTrue { t = t map { |r| r first } }
        (s first type == "Array") ifFalse { return [[0, s, t]] }
        k = s first size
        (0..(k - 1)) map { |c|
            col = s map { |row| row at(c) }
            hit = t map { |y| (y type == "Array") ifTrue { y at(c) > 0.5 } ifFalse { y == c } }
            [c, col, hit]
        }
    }

    // Walk the thresholds from the highest score down: #{positives:,
    // negatives:, steps: [[threshold, truePositives, falsePositives], ...]}
    _sweep(scores, targets) {
        s = _seq(scores)
        t = _seq(targets)
        (s size != t size) ifTrue { raise("Plot: scores and targets must be the same length") }
        pos = []
        neg = []
        s size times { |i|
            y = t at(i)
            ((y == true) || ((y type == "Number") && (y > 0.5))) ifTrue { pos append(s at(i)) } ifFalse { neg append(s at(i)) }
        }
        ((pos size == 0) || (neg size == 0)) ifTrue { raise("Plot: ROC and precision-recall need both positive and negative targets") }
        ps = pos sort reverse
        ns = neg sort reverse
        i = 0
        j = 0
        steps = []
        { (i < ps size) || (j < ns size) } whileTrue {
            a = (i < ps size) ifTrue { ps at(i) } ifFalse { nil }
            b = (j < ns size) ifTrue { ns at(j) } ifFalse { nil }
            th = a
            ((th == nil) || ((b != nil) && (b > th))) ifTrue { th = b }
            { (i < ps size) && (ps at(i) == th) } whileTrue { i = i + 1 }
            { (j < ns size) && (ns at(j) == th) } whileTrue { j = j + 1 }
            steps append([th, i, j])
        }
        #{positives: ps size, negatives: ns size, steps: steps}
    }

    // ---- embeddings, weights, saliency ---------------------------------------

    // Principal components of rows of numbers (embeddings, a layer's
    // activations): #{projected: rows of k numbers, components: k unit
    // vectors, explained: the fraction of the variance each holds, mean:}.
    // Rows with something else than numbers are an error. Data with its own
    // pca (k) method (a native one) is asked for it. Pure Clay otherwise,
    // by power iteration: fitted on maxRows rows at most (2000; evenly
    // spaced), which is quick for tens to a few hundred dimensions; every row
    // is projected. opts: maxRows, iterations (60)
    pca(data, k = 2, opts = nil) {
        (k type == "Dict") ifTrue { opts = k; k = 2 }
        o = opts ?? #{}
        (data hasMethod("pca")) ifTrue { return data pca(k, o get("maxRows")) }
        rows = (data type == "Array") ifTrue { data } ifFalse { data toArray }
        n = rows size
        (n < 2) ifTrue { raise("Plot: pca needs at least 2 rows") }
        d = rows first size
        ((rows find { |r| (r type != "Array") || (r size != d) }) != nil) ifTrue { raise("Plot: pca needs rows of numbers, all the same length") }
        (k > d) ifTrue { raise("Plot: pca: " + k toString + " components from " + d toString + " dimensions") }
        // the rows it is fitted on: all, or evenly spaced ones
        most = o get("maxRows") ?? 2000
        fit = (n <= most) ifTrue { rows } ifFalse { (0..(most - 1)) map { |i| rows at((i * n) / most) } }
        m = fit size
        mean = (0..(d - 1)) map { |j| 0.0 }
        fit each { |r| j = 0; { j < d } whileTrue { mean setAt(j, mean at(j) + r at(j)); j = j + 1 } }
        mean = mean map { |v| v / m }
        xs = fit map { |r| out = []; j = 0; { j < d } whileTrue { out append(r at(j) - mean at(j)); j = j + 1 }; out }
        total = 0.0
        xs each { |r| j = 0; { j < d } whileTrue { total = total + (r at(j) * r at(j)); j = j + 1 } }
        total = total / (m - 1)
        // w = X^T X v: from the covariance matrix when there are few
        // dimensions (made once, then each step costs d * d), else from the
        // rows each step (n * d)
        small = d <= 64
        cov = nil
        small ifTrue {
            cov = (0..(d - 1)) map { |j| (0..(d - 1)) map { |l| 0.0 } }
            xs each { |r|
                j = 0
                { j < d } whileTrue {
                    rj = r at(j)
                    row = cov at(j)
                    l = j
                    { l < d } whileTrue { row setAt(l, row at(l) + (rj * r at(l))); l = l + 1 }
                    j = j + 1
                }
            }
            d times { |j| (0..(j - 1)) each { |l| (j > 0) ifTrue { cov at(j) setAt(l, cov at(l) at(j)) } } }
        }
        times = { |v|
            w = (0..(d - 1)) map { |j| 0.0 }
            small ifTrue {
                j = 0
                { j < d } whileTrue {
                    row = cov at(j)
                    s = 0.0
                    l = 0
                    { l < d } whileTrue { s = s + (row at(l) * v at(l)); l = l + 1 }
                    w setAt(j, s)
                    j = j + 1
                }
            } ifFalse {
                xs each { |r|
                    s = 0.0
                    j = 0
                    { j < d } whileTrue { s = s + (r at(j) * v at(j)); j = j + 1 }
                    j = 0
                    { j < d } whileTrue { w setAt(j, w at(j) + (s * r at(j))); j = j + 1 }
                }
            }
            w
        }
        // steps on the small matrix are cheap: take as many as close eigenvalues need
        iters = o get("iterations") ?? (small ifTrue { 1000 } ifFalse { 60 })
        comps = []
        vars = []
        seed = 12345
        k times { |c|
            v = (0..(d - 1)) map { |j| seed = (seed * 48271) % 2147483647; (seed / 2147483647.0) - 0.5 }
            lam = 0.0
            done = false
            it = 0
            { (it < iters) && (done not) } whileTrue {
                // less what the components found already explain
                w = times value(v)
                comps each { |p|
                    dp = 0.0
                    j = 0
                    { j < d } whileTrue { dp = dp + (w at(j) * p at(j)); j = j + 1 }
                    j = 0
                    { j < d } whileTrue { w setAt(j, w at(j) - (dp * p at(j))); j = j + 1 }
                }
                norm = Math sqrt(w reduce(0.0) { |a, x| a + (x * x) })
                (norm == 0) ifTrue { done = true } ifFalse {
                    nv = w map { |x| x / norm }
                    change = 0.0
                    j = 0
                    { j < d } whileTrue { change = change + (nv at(j) - v at(j)) abs; j = j + 1 }
                    v = nv
                    lam = norm / (m - 1)
                    (change < 0.00001) ifTrue { done = true }
                    it = it + 1
                }
            }
            // a fixed sign: the largest entry positive
            big = 0
            d times { |j| ((v at(j) abs) > (v at(big) abs)) ifTrue { big = j } }
            (v at(big) < 0) ifTrue { v = v map { |x| 0 - x } }
            comps append(v)
            vars append(lam)
        }
        projected = rows map { |r|
            comps map { |p|
                s = 0.0
                j = 0
                { j < d } whileTrue { s = s + ((r at(j) - mean at(j)) * p at(j)); j = j + 1 }
                s
            }
        }
        #{projected: projected, components: comps, mean: mean,
          explained: vars map { |v| (total > 0) ifTrue { v / total } ifFalse { 0 } }}
    }

    // Rows of numbers in two dimensions by PCA, as a scatter coloured by
    // class: embedding(ax, rows, labels, opts). labels: a class per row (or
    // one-hot rows), or nil. opts: classNames (a legend), s, alpha, and
    // pca's maxRows, iterations. Returns pca's result.
    embedding(ax, rows, labels, opts) {
        p = pca(rows, 2, opts)
        pts = p get("projected")
        xs = pts map { |r| r at(0) }
        ys = pts map { |r| r at(1) }
        names = opts get("classNames")
        (labels == nil) ifTrue {
            ax scatter(xs, ys, #{s: opts get("s") ?? 12, alpha: opts get("alpha") ?? 0.7})
        } ifFalse {
            lab = ax _seq(labels) map { |l| (l type == "Array") ifTrue { argmax(l) } ifFalse { Math round(l) } }
            (lab size != pts size) ifTrue { raise("Plot: embedding: " + pts size toString + " rows but " + lab size toString + " labels") }
            (lab max + 1) times { |c|
                idx = (0..(lab size - 1)) filter { |i| lab at(i) == c }
                (idx size > 0) ifTrue {
                    ax scatter(idx map { |i| xs at(i) }, idx map { |i| ys at(i) },
                               #{s: opts get("s") ?? 12, alpha: opts get("alpha") ?? 0.7, color: PlotColor cycleColor(c),
                                 label: (names != nil) ifTrue { (names at(c) ?? c) toString } ifFalse { c toString }})
                }
            }
            ax legend(#{loc: "best", title: opts get("legendTitle")})
        }
        ev = p get("explained")
        ax xlabel("PC1 (" + PlotTicks format(ev at(0) * 100, 0) + "%)")
        ax ylabel("PC2 (" + PlotTicks format(ev at(1) * 100, 0) + "%)")
        p
    }

    // A figure of one histogram per layer of weights: layers is a Dict (name
    // -> numbers, or rows of them), an Array of those, or a network with
    // weights(i) and layerCount (as clay-ann's; layers without weights are
    // left out, and titles name a layer by its index and kind). Each title gives
    // the mean and standard deviation. opts: bins (40), cols (up to 4),
    // range ([lo, hi] for every layer, to compare frames of an animation),
    // color, figsize, title. Returns the figure.
    weightHistograms(layers, opts) {
        named = _layers(layers)
        n = named size
        (n == 0) ifTrue { raise("Plot: weightHistograms needs at least one layer of weights") }
        cols = Math min(opts get("cols") ?? 4, n)
        rows = (n + cols - 1) / cols
        fig = Plot figure(#{figsize: opts get("figsize") ?? [3.2 * cols, 2.6 * rows]})
        n times { |i|
            ax = fig addSubplot(rows, cols, i + 1)
            Plot sca(ax)
            vals = (named at(i) at(1)) filter { |v| (v != nil) && (v == v) }
            h = #{color: opts get("color") ?? "C0"}
            (opts get("range") != nil) ifTrue { h set("range", opts get("range")) }
            ax hist(vals, opts get("bins") ?? 40, h)
            mean = PlotStats mean(vals) ?? 0
            sd = PlotStats std(vals)
            ax title(named at(i) at(0) + ": $\\mu$ " + PlotTicks short(mean, 3) + ", $\\sigma$ " + PlotTicks short(sd, 3), #{fontsize: 9})
        }
        (opts get("title") != nil) ifTrue { fig suptitle(opts get("title")) }
        fig
    }

    // [[name, flat numbers], ...] from a Dict, an Array or a network
    _layers(layers) {
        flat = { |v| ((v type == "Array") && (v size > 0) && (v first type == "Array")) ifTrue { v flatten } ifFalse {
            (v type == "Array") ifTrue { v } ifFalse { v toArray flatten } } }
        (layers type == "Dict") ifTrue {
            out = []
            layers each { |k, v| out append([k toString, flat value(v)]) }
            return out
        }
        (layers type == "Array") ifTrue {
            return (0..(layers size - 1)) map { |i| ["layer " + (i + 1) toString, flat value(layers at(i))] }
        }
        ((layers hasMethod("weights")) && (layers hasMethod("layerCount"))) ifTrue {
            kinds = (layers hasMethod("layers")) ifTrue { (layers layers) map { |l| l get("kind") } } ifFalse { nil }
            out = []
            layers layerCount times { |i|
                w = layers weights(i)
                name = "layer " + i toString
                (kinds != nil) ifTrue { name = i toString + " " + (kinds at(i)) toString }
                (w != nil) ifTrue { out append([name, flat value(w)]) }
            }
            return out
        }
        raise("Plot: weightHistograms takes a Dict of name -> weights, an Array of weights, or a network with weights(i)")
    }

    // A heatmap over an image (a saliency map, a layer's activations):
    // overlay(ax, image, heat, opts). image is as imshow's (rows, an Image);
    // heat is rows of numbers of any size, scaled smoothly to the image's.
    // opts: cmap ("jet"-like "inferno" by default), alpha (0.5), vmin, vmax,
    // imageCmap ("gray"), colorbar (true). Returns the heatmap's artist.
    overlay(ax, image, heat, opts) {
        base = ax imshow(image, #{cmap: opts get("imageCmap") ?? "gray"})
        nr = base get("nrows")
        nc = base get("ncols")
        h = ax _grid(heat, opts get("shape"))
        up = _resample(h, nr, nc)
        o = #{cmap: opts get("cmap") ?? "inferno", alpha: opts get("alpha") ?? 0.5, extent: base get("extent")}
        (opts get("vmin") != nil) ifTrue { o set("vmin", opts get("vmin")) }
        (opts get("vmax") != nil) ifTrue { o set("vmax", opts get("vmax")) }
        art = ax imshow(up, o)
        ax integerX = true
        ax integerY = true
        (opts get("colorbar") != false) ifTrue { ax colorbar(art) }
        art
    }

    // Rows of numbers resized to nr x nc by bilinear interpolation
    _resample(rows, nr, nc) {
        hr = rows size
        hc = rows first size
        ((hr == nr) && (hc == nc)) ifTrue { return rows }
        (0..(nr - 1)) map { |i|
            fy = ((i + 0.5) * hr / nr toFloat) - 0.5
            y0 = Math floor(fy) clamp(0, hr - 1)
            y1 = (y0 + 1) clamp(0, hr - 1)
            ty = (fy - y0) clamp(0, 1)
            (0..(nc - 1)) map { |j|
                fx = ((j + 0.5) * hc / nc toFloat) - 0.5
                x0 = Math floor(fx) clamp(0, hc - 1)
                x1 = (x0 + 1) clamp(0, hc - 1)
                tx = (fx - x0) clamp(0, 1)
                a = (rows at(y0) at(x0) * (1 - tx)) + (rows at(y0) at(x1) * tx)
                b = (rows at(y1) at(x0) * (1 - tx)) + (rows at(y1) at(x1) * tx)
                (a * (1 - ty)) + (b * ty)
            }
        }
    }

    // ---- grids of images --------------------------------------------------

    // A figure of images, one per axes: images are rows, flat Arrays (with
    // shape, or square) or Images. opts: cols, shape, cmap ("gray"), vmin,
    // vmax, symmetric (true: a range centred on 0 shared by all, for
    // weights and filters, with "coolwarm"), titles, predicted and actual
    // (titles "3", or "3 (7)" in red when wrong), labels (class names for
    // those), title (above all), size (inches per image)
    imageGrid(images, opts) {
        items = _seq(images)
        n = items size
        (n == 0) ifTrue { raise("Plot: imageGrid needs images") }
        cols = opts get("cols")
        (cols == nil) ifTrue { cols = Math min(n, 10) }
        rows = (n + cols - 1) / cols
        size = opts get("size") ?? 1.2
        fig = Plot figure(#{figsize: [Math max(2, cols * size), Math max(1.5, (rows * size * 1.15) + 0.3)],
                            dpi: opts get("dpi") ?? Plot rc get("figure.dpi")})
        axs = fig subplots(rows, cols)
        flat = fig axes
        Plot sca(flat first)
        lo = opts get("vmin")
        hi = opts get("vmax")
        cmap = opts get("cmap") ?? "gray"
        (opts get("symmetric") == true) ifTrue {
            m = 0
            items each { |img| m = Math max(m, (_flat(img) map { |v| v abs }) max) }
            lo = 0 - m
            hi = m
            cmap = opts get("cmap") ?? "coolwarm"
        }
        titles = opts get("titles")
        pred = opts get("predicted")
        actual = opts get("actual")
        names = opts get("labels")
        flat size times { |i|
            ax = flat at(i)
            ax axis("off")
            (i < n) ifTrue {
                o = #{cmap: cmap}
                (opts get("shape") != nil) ifTrue { o set("shape", opts get("shape")) }
                (lo != nil) ifTrue { o set("vmin", lo) }
                (hi != nil) ifTrue { o set("vmax", hi) }
                ax imshow(items at(i), o)
                (titles != nil) ifTrue { ax title(titles at(i) toString, #{fontsize: 9}) }
                (pred != nil) ifTrue {
                    p = _className(pred at(i), names)
                    ok = (actual == nil) || (argmax(pred at(i)) == argmax(actual at(i)))
                    label = ok ifTrue { p } ifFalse { p + " (" + _className(actual at(i), names) + ")" }
                    ax title(label, #{fontsize: 9, color: ok ifTrue { "k" } ifFalse { "C3" }})
                }
            }
        }
        (opts get("title") != nil) ifTrue { fig suptitle(opts get("title")) }
        fig
    }

    // A class number from a number, or the index of the largest entry of a
    // row of scores or one-hot targets
    argmax(v) {
        (v type == "Array") ifFalse { return v }
        best = 0
        v size times { |i| (v at(i) > v at(best)) ifTrue { best = i } }
        best
    }

    _className(v, names) {
        c = argmax(v)
        (names == nil) ifTrue { return c toString }
        names at(c) toString
    }

    _flat(img) {
        (img hasMethod("floats")) ifTrue { return img floats }
        d = _seq(img)
        ((d size > 0) && (d first type == "Array")) ifTrue { return d flatten filter { |v| (v != nil) && (v type == "Number") } }
        d filter { |v| (v != nil) && (v type == "Number") }
    }

    _seq(v) {
        (v type == "Array") ifTrue { return v }
        (v hasMethod("toArray")) ifTrue { return v toArray }
        raise("Plot: expected an Array, got " + v type)
    }
}
