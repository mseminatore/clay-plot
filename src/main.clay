// plot -- charts and figures for Clay, in the style of matplotlib's pyplot
//
// Usage:
//   import("plot")
//
//   Plot plot([1, 4, 9, 16], #{label: "squares"})
//   Plot plot([1, 2, 3, 4], "r--", #{label: "linear"})
//   Plot title("Growth"); Plot xlabel("n"); Plot legend
//   Plot savefig("growth.png")              // or .svg
//
//   [fig, axs] = Plot subplots(1, 2, #{figsize: [10, 4]})
//   axs at(0) hist(values, 20)
//   axs at(1) imshow(pixels, #{cmap: "gray"})
//   fig savefig("panels.svg")
//
// Plot keeps a current figure and axes, as pyplot does; the drawing methods
// (plot, scatter, bar, hist, imshow ...) go to the current axes. Figures and
// axes can also be used directly: PlotFigure, PlotAxes. Colours and
// colormaps are in PlotColor, tick placement in PlotTicks, the statistics
// behind box and violin plots in PlotStats, and the backends
// are PlotSvg, PlotPng (which draws on the image brick's Canvas) and
// PlotTerm (text for terminals). PlotML has the machine-learning plots and
// PlotLive the learning curve drawn as training runs.
//
// Every brick shares one set of top-level names with the program that imports
// it, so this one's all start with Plot.

import("image")
import("color.clay")
import("ticks.clay")
import("stats.clay")
import("svg.clay")
import("png.clay")
import("term.clay")
import("axes.clay")
import("figure.clay")
import("ml.clay")
import("live.clay")

Plot = Object clone {
    current = nil
    currentAxes = nil
    _rc = nil

    // Default settings, named as matplotlib's rcParams; change them before
    // making a figure: Plot rc set("font.size", 12)
    rc() {
        (_rc == nil) ifTrue {
            _rc = #{
                "figure.figsize": [6.4, 4.8], "figure.dpi": 100, "figure.facecolor": "white",
                "figure.titlesize": 12,
                "font.size": 10, "axes.titlesize": 12, "axes.labelsize": 10,
                "xtick.labelsize": 10, "ytick.labelsize": 10, "legend.fontsize": 10,
                "axes.linewidth": 0.8, "axes.grid": false, "axes.facecolor": "white",
                "axes.xmargin": 0.05, "axes.ymargin": 0.05,
                "lines.linewidth": 1.5, "lines.markersize": 6,
                "grid.color": "#b0b0b0", "grid.linewidth": 0.8, "grid.alpha": 1,
                "image.cmap": "viridis"
            }
        }
        _rc
    }

    // ---- figures ----------------------------------------------------------

    // A new figure, now the current one: figure(#{figsize: [w, h] in inches,
    // dpi:, facecolor:})
    figure(opts = nil) {
        self current = PlotFigure new(opts)
        self currentAxes = nil
        current
    }

    // A new figure with a grid of axes: [fig, axs] = Plot subplots(2, 2).
    // axs is one Axes, an Array (one row or column) or an Array of rows.
    subplots(rows = 1, cols = 1, opts = nil) {
        (rows type == "Dict") ifTrue { opts = rows; rows = 1 }
        (cols type == "Dict") ifTrue { opts = cols; cols = 1 }
        fig = figure(opts)
        axs = fig subplots(rows, cols)
        self currentAxes = fig axesList first
        [fig, axs]
    }

    // Make the subplot at index (1-based) of a rows x cols grid current,
    // creating it if needed: Plot subplot(1, 2, 1)
    subplot(rows, cols, index) {
        self currentAxes = gcf addSubplot(rows, cols, index)
        currentAxes
    }

    // The current figure, made if there is none
    gcf() {
        (current == nil) ifTrue { figure }
        current
    }

    // The current axes, made if there are none
    gca() {
        fig = gcf
        (currentAxes == nil) ifTrue {
            self currentAxes = (fig axesList size > 0) ifTrue { fig axesList first } ifFalse { fig addSubplot(1, 1, 1) }
        }
        currentAxes
    }

    // Make an axes current
    sca(ax) { self currentAxes = ax; self current = ax figure; ax }

    // A twin of the current axes, made current: twinx shares the x axis
    // (its own y axis on the right), twiny the y axis (x along the top)
    twinx() { self currentAxes = gca twinx; currentAxes }
    twiny() { self currentAxes = gca twiny; currentAxes }

    // ---- drawing (on the current axes) -------------------------------------

    plot(a = nil, b = nil, c = nil, d = nil) { gca plot(a, b, c, d) }
    scatter(x, y, opts = nil) { gca scatter(x, y, opts) }
    bar(x, height, opts = nil) { gca bar(x, height, opts) }
    barh(y, width, opts = nil) { gca barh(y, width, opts) }
    hist(data, bins = nil, opts = nil) { gca hist(data, bins, opts) }
    fillBetween(x, y1, y2 = nil, opts = nil) { gca fillBetween(x, y1, y2, opts) }
    axhline(y = 0, opts = nil) { gca axhline(y, opts) }
    axvline(x = 0, opts = nil) { gca axvline(x, opts) }
    text(x, y, s, opts = nil) { gca text(x, y, s, opts) }
    annotate(s, xy, xytext = nil, opts = nil) { gca annotate(s, xy, xytext, opts) }
    imshow(data, opts = nil) { gca imshow(data, opts) }
    colorbar(art = nil, opts = nil) { gca colorbar(art, opts) }
    step(x, y, a = nil, b = nil) { gca step(x, y, a, b) }
    errorbar(x, y, a = nil, b = nil) { gca errorbar(x, y, a, b) }
    boxplot(data, opts = nil) { gca boxplot(data, opts) }
    violinplot(data, opts = nil) { gca violinplot(data, opts) }
    pie(values, opts = nil) { gca pie(values, opts) }
    stackplot(x, a = nil, b = nil, c = nil, d = nil, e = nil, f = nil, g = nil, h = nil) { gca stackplot(x, a, b, c, d, e, f, g, h) }
    barLabel(bars, opts = nil) { gca barLabel(bars, opts) }
    semilogy(a = nil, b = nil, c = nil, d = nil) { gca semilogy(a, b, c, d) }
    semilogx(a = nil, b = nil, c = nil, d = nil) { gca semilogx(a, b, c, d) }
    loglog(a = nil, b = nil, c = nil, d = nil) { gca loglog(a, b, c, d) }

    // ---- machine learning (ml.clay) ----------------------------------------

    learningCurve(history, opts = nil) { gca learningCurve(history, opts) }
    confusionMatrix(matrix, opts = nil) { gca confusionMatrix(matrix, opts) }
    roc(scores, targets, opts = nil) { gca roc(scores, targets, opts) }
    precisionRecall(scores, targets, opts = nil) { gca precisionRecall(scores, targets, opts) }

    // A learning curve drawn in the terminal as training runs: pass it as
    // clay-ann fit's onEpoch. See PlotLive for the options.
    liveCurve(opts = nil) { PlotLive new(opts) }

    // A new figure of images in a grid; see PlotML imageGrid for the options
    imageGrid(images, opts = nil) { PlotML imageGrid(images, opts ?? #{}) }

    // ---- labels and settings (on the current axes) ------------------------

    title(s, opts = nil) { gca title(s, opts) }
    xlabel(s) { gca xlabel(s) }
    ylabel(s) { gca ylabel(s) }
    xlim(lo = nil, hi = nil) { gca xlim(lo, hi) }
    ylim(lo = nil, hi = nil) { gca ylim(lo, hi) }
    xticks(values = nil, labels = nil, opts = nil) { gca xticks(values, labels, opts) }
    yticks(values = nil, labels = nil, opts = nil) { gca yticks(values, labels, opts) }
    grid(on = true, opts = nil) { gca grid(on, opts) }
    legend(a = nil, b = nil) { gca legend(a, b) }
    axis(mode) { gca axis(mode) }
    xscale(kind) { gca xscale(kind) }
    yscale(kind) { gca yscale(kind) }
    suptitle(s, opts = nil) { gcf suptitle(s, opts) }

    // ---- output -----------------------------------------------------------

    // Save the current figure; the extension picks the format (.png or
    // .svg). opts: dpi
    savefig(path, opts = nil) { gcf savefig(path, opts) }

    // The current figure as SVG text, or as a PNG file's bytes
    toSvg(dpiFor = nil) { gcf toSvg(dpiFor) }
    toPng(dpiFor = nil) { gcf toPng(dpiFor) }

    // Open the current figure in the system viewer, then start afresh (as
    // pyplot's show); returns the temporary file's path. Plot show(#{terminal:
    // true}) prints it in the terminal instead (see PlotFigure toText).
    show(opts = nil) {
        path = gcf show(opts)
        close
        path
    }

    // The current figure as text for a terminal: #{cols:, rows:, color:}
    toText(opts = nil) { gcf toText(opts) }

    // Forget the current figure
    close() { self current = nil; self currentAxes = nil; nil }

    // Clear the current figure's axes
    clf() { gcf clear; self currentAxes = nil; nil }
}
